// Synthetic Photos rendering into private memory; no display connection.
#import "kryon/drawing_props"
#import "kryon/geometry"
Pixels :: #import "kryon/pixmap";
pixels: [307200]u32;
calls: s32;
ComponentRasterBegin :: () -> bool { return Pixels.PixmapBeginInto(cast(u32)0xffffffff, 640, 480, pixels[:]) }
ComponentRasterClose :: () { Pixels.PixmapEndInto(); Pixels.PixmapCloseWorkers() }
ComponentRasterCalls :: () -> s32 { return calls }
#program_export
ComponentMeasureGlyphWidth :: (value: string, font: s32, typeface: string) -> s32 { unused typeface; return cast(s32)value.count * font / 2 }
#program_export
ComponentMeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 { unused typeface; return font }
#program_export
ComponentImageWidth :: (path: string) -> s32 { unused path; return 0 }
#program_export
ComponentImageHeight :: (path: string) -> s32 { unused path; return 0 }
#program_export
ComponentRasterRoundedRectangle :: (bounds: Rectangle, radius: float32, segments: s32, color: Color) { Pixels.RasterRoundedRectangle(bounds, radius, segments, color); calls += 1 }
#program_export
ComponentRasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32, segments: s32, width: float32, color: Color) { Pixels.RasterRoundedRectangleOutline(bounds, radius, segments, width, color); calls += 1 }
#program_export
ComponentRasterLine :: (line: Rectangle, color: Color) { Pixels.RasterLine(line, color); calls += 1 }
#program_export
ComponentRasterTriangles :: (points: []Vector2, color: Color) { Pixels.RasterTriangles(points, color); calls += 1 }
#program_export
ComponentRasterText :: (value: string, x: s32, y: s32, font: s32, color: Color) { Pixels.RasterText(value, x, y, font, color); calls += 1 }
#program_export
ComponentRasterTextClipped :: (value: string, x: s32, y: s32, font: s32, color: Color, clip: Rectangle) { unused clip; ComponentRasterText(value, x, y, font, color) }
#program_export
ComponentRasterTextRotated :: (value: string, x: s32, y: s32, font: s32, color: Color, clip: Rectangle, origin: Vector2, rotation: float32, outer_clip: Rectangle, outer_clipped: bool, emphasis: bool, italic: bool) {
    unused clip; unused origin; unused rotation; unused outer_clip
    unused outer_clipped; unused emphasis; unused italic
    ComponentRasterText(value, x, y, font, color)
}
#program_export
ComponentRasterImage :: (path: string, texture: u32, source: Rectangle, destination: Rectangle, clip: Rectangle, origin: Vector2, rotation: float32, radius: float32, tint: Color) {
    unused path; unused texture; unused source; unused destination; unused clip
    unused origin; unused rotation; unused radius; unused tint; calls += 1
}
#program_export
ComponentRasterImageMesh :: (path: string, texture: u32, source: Rectangle, points: []Vector2, columns: s32, rows: s32, clip: Rectangle, tint: Color) {
    unused path; unused texture; unused source; unused points; unused columns
    unused rows; unused clip; unused tint; calls += 1
}
#program_export
ComponentSystemClipboardOpenHost :: () -> s32 { return -1 }
#program_export
ComponentSystemClipboardByteHost :: (index: s32) -> s32 { unused index; return -1 }
#program_export
ComponentSystemClipboardWriteHost :: (text: string) -> bool { unused text; return false }
