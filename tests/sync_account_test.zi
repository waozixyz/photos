Requests :: #import "sync_account";
Wire :: #import "sync_crypto";
Native :: #import "daochi_client/crypto_native";
Account :: #import "account_sign";
Test :: #import "sync_crypto_test";
Tx :: #import "sync_transaction_test";
JSON :: #import "std/json_document";
#import "std/byte_text_linux"
#import "std/text_buffer"
using Vectors :: #import "std/vec";

main :: () -> s32 {
    public: Vec(u8); private: Vec(u8); seed: Vec(u8); body: Vec(u8); signature: Vec(u8); retry: Vec(u8)
    defer { Wire.ClearOutput(*private); Wire.ClearOutput(*seed); Wire.ClearOutput(*body); Wire.ClearOutput(*signature); Wire.ClearOutput(*retry) }
    if !Test.Expect(Test.Fixture("account-public.bin",*public) && Test.Fixture("account-secret.bin",*private) && Test.Fixture("key.bin",*seed),"synthetic account request keys") { return 1 }
    pk:=VecSlice(public,0,public.count); sk:=VecSlice(private,0,private.count); device:=VecSlice(seed,0,seed.count)
    nonce:="abababababababababababababababababababababababababababababababab"
    challenge: Vec(u8); BuilderPrint(*challenge,"{\"nonce\":\"%\"}",nonce); value:=BuilderFinish(challenge)
    if !Test.Expect(Requests.LoginRequest(pk,sk,"photos-existing-device",value,*body,*signature),"in-process login") { return 1 }
    json: JSON.JsonDocument; account: [32]u8; hash: [32]u8
    if !Native.Digest(pk,account[: ]) || !Native.Digest(VecSlice(body,0,body.count),hash[: ]) { return 1 }
    if !Test.Expect(JSON.JsonRead(*json,TextFromBytes(VecSlice(body,0,body.count))) &&
        Tx.Field(*json,"user_id_hash")==Tx.Hex(account[: ]) && Tx.Field(*json,"client_id")=="photos-existing-device" &&
        Tx.Field(*json,"public_key")==Tx.Hex(pk),"released login body") { return 1 }
    message: Vec(u8); BuilderPrint(*message,"daochi-sync-v1\nPOST\n/api/v1/sync/login\n%\n%\n",Tx.Hex(hash[: ]),nonce)
    proof: [2420]u8
    if !Test.Expect(Tx.Unhex(TextFromBytes(VecSlice(signature,0,signature.count)),proof[: ]) &&
        Account.AccountVerify(pk,Tx.Bytes(BuilderFinish(message)),proof[: ]),"released login signature") { return 1 }
    for mode: 0..3 {
        challengeText:=ifx mode==0 then "{}" else ifx mode==1 then "{\"nonce\":\"wrong\"}" else value
        client:=ifx mode==2 then "bad\nclient" else "photos-existing-device"
        if mode==3 { private[0]^=1 }
        failed:=!Requests.LoginRequest(pk,sk,client,challengeText,*body,*signature)
        if mode==3 { private[0]^=1 }
        if !Test.Expect(failed && Test.Wiped(*body) && Test.Wiped(*signature),"invalid challenge/client/mismatched keys clear both results") { return 1 }
    }
    if !Test.Expect(!Requests.LoginRequest(pk,sk,"photos",value,*body,*body) && Test.Wiped(*body),"aliased destinations rejected") { return 1 }
    if !Test.Expect(Requests.RegistrationRequest(pk,sk,device,"photos-existing-device",2000000000,*body) &&
        Requests.RegistrationRequest(pk,sk,device,"photos-existing-device",2000000000,*retry) &&
        !Test.Equal(VecSlice(body,0,body.count),VecSlice(retry,0,retry.count)),"fresh registration nonce") { return 1 }
    devicePublic: [32]u8; deviceID: [32]u8
    if !Native.DevicePublic(device,devicePublic[: ]) || !Native.Digest(devicePublic[: ],deviceID[: ]) { return 1 }
    if !Test.Expect(JSON.JsonRead(*json,TextFromBytes(VecSlice(body,0,body.count))) &&
        Tx.Field(*json,"public_key")==Tx.Hex(devicePublic[: ]) && Tx.Field(*json,"device_key_id")==Tx.Hex(deviceID[: ]) &&
        Tx.Field(*json,"app_id")=="photos" && Tx.Field(*json,"client_id")=="photos-existing-device", "registration preserves device identity") { return 1 }
    registration: Vec(u8); BuilderPrint(*registration,"daochi-device-registration-v1\n%\nphotos\n%\nphotos-existing-device\n%\n%\n2000000300\n",Tx.Hex(account[: ]),Tx.Hex(deviceID[: ]),Tx.Hex(devicePublic[: ]),Tx.Field(*json,"nonce"))
    if !Test.Expect(Tx.Unhex(Tx.Field(*json,"signature"),proof[: ]) && Account.AccountVerify(pk,Tx.Bytes(BuilderFinish(registration)),proof[: ]),"canonical registration signature and expiration") { return 1 }
    if !Test.Expect(!Requests.RegistrationRequest(pk,sk,device[: 31],"photos",1,*body) && Test.Wiped(*body) &&
        !Requests.RegistrationRequest(pk,sk,device,"photos",0,*body) && Test.Wiped(*body) &&
        !Requests.RegistrationRequest(pk,sk,device,"photos",9007199254740692,*body) && Test.Wiped(*body),"registration seed/time bounds") { return 1 }
    print("sync_account: local tests passed\n"); return 0
}
