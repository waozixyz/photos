Gesture :: #import "selection_drag";

#program_export
Answer :: () -> s32 {
    state: Gesture.State
    // A selected gallery and a photo hit are required to arm a gesture.
    value := Gesture.Update(*state,true,0,3,false,100.0,200.0,true,true,false,0,100.0,500.0,true)
    if value.began || state.pending { return 1 }
    value = Gesture.Update(*state,true,1,-1,false,100.0,200.0,true,true,false,0,100.0,500.0,true)
    if value.began || state.pending { return 2 }
    value = Gesture.Update(*state,true,1,3,false,100.0,200.0,true,true,false,0,100.0,500.0,true)
    if !value.began || !state.pending || state.active || state.anchor != 3 || state.remove { return 3 }
    value = Gesture.Update(*state,true,1,3,false,111.0,200.0,false,true,false,10,100.0,500.0,true)
    if value.claimed || state.active { return 4 }
    value = Gesture.Update(*state,true,1,4,false,112.0,200.0,false,true,false,20,100.0,500.0,true)
    if !value.claimed || !state.active || value.scroll != 0 { return 5 }
    // Once horizontal selection activates, vertical motion remains selection.
    value = Gesture.Update(*state,true,1,8,false,100.0,450.0,false,true,false,30,100.0,500.0,true)
    if !value.claimed || value.canceled || state.anchor != 3 { return 6 }
    value = Gesture.Update(*state,true,1,4,false,112.0,200.0,false,false,true,40,100.0,500.0,true)
    if !value.claimed || !value.finished || state.pending || state.active { return 7 }
    // Starting on an already selected photo removes the dragged range, even
    // after that range has removed the last selected item.
    unused Gesture.Update(*state,true,1,2,true,100.0,200.0,true,true,false,100,100.0,500.0,true)
    value = Gesture.Update(*state,true,0,3,false,125.0,200.0,false,true,false,110,100.0,500.0,true)
    if !value.claimed || !state.remove || state.anchor != 2 { return 8 }
    // Ordinary vertical drags and clicks are left to the gallery widgets.
    Gesture.Reset(*state)
    unused Gesture.Update(*state,true,1,2,false,100.0,200.0,true,true,false,100,100.0,500.0,true)
    value = Gesture.Update(*state,true,1,2,false,105.0,213.0,false,true,false,110,100.0,500.0,true)
    if value.claimed || !value.canceled || state.pending { return 9 }
    unused Gesture.Update(*state,true,1,2,false,100.0,200.0,true,true,false,100,100.0,500.0,true)
    value = Gesture.Update(*state,true,1,2,false,100.0,200.0,false,false,true,110,100.0,500.0,true)
    if value.claimed || !value.finished { return 10 }
    // Edge scrolling uses elapsed time, caps stalls, and cannot run when the
    // pointer leaves the gallery's horizontal extent.
    unused Gesture.Update(*state,true,1,2,false,100.0,200.0,true,true,false,100,100.0,500.0,true)
    value = Gesture.Update(*state,true,1,3,false,125.0,200.0,false,true,false,110,100.0,500.0,true)
    value = Gesture.Update(*state,true,1,3,false,125.0,600.0,false,true,false,160,100.0,500.0,true)
    if value.scroll != 35 || !value.claimed { return 11 }
    value = Gesture.Update(*state,true,1,0,false,125.0,100.0,false,true,false,210,100.0,500.0,true)
    if value.scroll != -35 { return 12 }
    value = Gesture.Update(*state,true,1,0,false,125.0,600.0,false,true,false,10000,100.0,500.0,true)
    if value.scroll != 35 { return 13 }
    value = Gesture.Update(*state,true,1,0,false,125.0,600.0,false,true,false,10050,100.0,500.0,false)
    if value.scroll != 0 { return 14 }
    // Privacy, navigation, focus, pointer loss and invalid clocks cancel the
    // gesture, including its pending anchor and accumulated scroll.
    value = Gesture.Update(*state,false,1,0,false,125.0,600.0,false,true,false,10100,100.0,500.0,true)
    if !value.canceled || !value.claimed || state.pending || state.active { return 15 }
    unused Gesture.Update(*state,true,1,2,false,100.0,200.0,true,true,false,100,100.0,500.0,true)
    value = Gesture.Update(*state,true,1,3,false,125.0,200.0,false,true,false,99,100.0,500.0,true)
    if !value.canceled || state.pending { return 16 }
    unused Gesture.Update(*state,true,1,2,false,100.0,200.0,true,true,false,100,100.0,500.0,true)
    value = Gesture.Update(*state,true,1,3,false,125.0,200.0,false,true,false,-1,100.0,500.0,true)
    if !value.canceled || state.pending { return 17 }
    unused Gesture.Update(*state,true,1,2,false,100.0,200.0,true,true,false,100,100.0,500.0,true)
    value = Gesture.Update(*state,true,1,3,false,125.0,200.0,false,false,false,110,100.0,500.0,true)
    if !value.canceled || state.pending { return 18 }
    return 42
}
#program_export
main :: () -> s32 { return ifx Answer() == 42 then 0 else Answer() }
