Identity :: #import "backup_identity";
Recovery :: #import "recovery_crypto";
Native :: #import "daochi_client/crypto_native";
Oqs :: #import "oqs/Oqs";
Wire :: #import "sync_crypto";
Fixture :: #import "backup_fixture";
Kit :: #import "kit";
#import "std/byte_text_linux"
#import "std/text_buffer"
using Vectors :: #import "std/vec";

#scope_file
PASSWORD :: "Synthetic recovery password 🔒";
Magic: [16]u8=.{80,72,79,84,79,83,45,82,69,67,79,86,69,82,89,1};
JSONText :: (identity: *Identity.Identity,change: s32,out: *Vec(u8)) -> bool {
    public: Vec(u8); private: Vec(u8); content: Vec(u8); node: Vec(u8); account: Vec(u8)
    defer { Wire.ClearOutput(*public); Wire.ClearOutput(*private); Wire.ClearOutput(*content); Wire.ClearOutput(*node); Wire.ClearOutput(*account) }
    if !Fixture.Hex(identity.public[:],*public) || !Fixture.Hex(identity.private[:],*private) || !Fixture.Hex(identity.content[:],*content) || !Fixture.Hex(identity.node[:],*node) || !Fixture.Hex(identity.account[:],*account) { return false }
    Wire.ClearOutput(out)
    if !VecReserve(<<out,9000) { return false }
    BuilderPrint(out,"{\"account\":\"%\",\"identity\":{\"content_key\":\"%\",\"private\":\"%\",\"public\":\"%\"%},\"node_id\":\"%\",\"version\":% %}",
        Fixture.Text(*account),ifx change==4 then Fixture.Text(*content)[:62] else Fixture.Text(*content),Fixture.Text(*private),Fixture.Text(*public),ifx change==3 then ",\"unexpected\":true" else "",ifx change==5 then "ghghghghghghghghghghghghghghghghghghghghghghghghghghghghghghghgh" else Fixture.Text(*node),ifx change==1 then "1.0" else "1",ifx change==2 then ",\"unexpected\":true" else ifx change==6 then ",\"version\":1" else "")
    return true
}
Seal :: (text: string,password: string,out: *Vec(u8)) -> bool {
    sealed: Vec(u8); defer { Wire.ClearOutput(*sealed) }
    if !Recovery.RecoveryCrypt(Fixture.Bytes(password),Fixture.Bytes(text),true,*sealed) || !Wire.PrepareOutput(out,sealed.count+16) { return false }
    bytes:=Wire.OutputBytes(out); source:=Wire.OutputBytes(*sealed)
    for index: 0..15 { bytes[index]=Magic[index] }
    for index: 0..source.count-1 { bytes[index+16]=source[index] }
    return true
}
Refused :: (file: []u8,password: string) -> bool {
    identity: Identity.Identity
    bytes:=BytesFromPointer(cast(*u8)*identity,size_of(Identity.Identity))
    for index: 0..bytes.count-1 { bytes[index]=170 }
    if Identity.Recover(file,Fixture.Bytes(password),*identity) { Identity.Clear(*identity); return false }
    for byte: bytes { if byte!=0 { Identity.Clear(*identity); return false } }
    return true
}

#program_export
main :: () -> s32 {
    original: Identity.Identity; defer { Identity.Clear(*original) }
    if !Oqs.MlDsa44KeyPair(original.public[:],original.private[:]) || !Native.Digest(original.public[:],original.account[:]) { return 1 }
    for index: 0..31 { original.node[index]=171; original.content[index]=205 }
    text: Vec(u8); file: Vec(u8); corrupt: Vec(u8)
    defer { Wire.ClearOutput(*text); Wire.ClearOutput(*file); Wire.ClearOutput(*corrupt) }
    if !JSONText(*original,0,*text) || !Seal(Fixture.Text(*text),PASSWORD,*file) { return 2 }
    restored: Identity.Identity; defer { Identity.Clear(*restored) }
    if !Kit.Expect(Identity.Recover(Wire.OutputBytes(*file),Fixture.Bytes(PASSWORD),*restored) && Fixture.Equal(original.node[:],restored.node[:]) && Fixture.Equal(original.account[:],restored.account[:]) && Fixture.Equal(original.public[:],restored.public[:]) && Fixture.Equal(original.private[:],restored.private[:]) && Fixture.Equal(original.content[:],restored.content[:]),"desktop recovery preserves every account/key/pin byte") { return 3 }
    if !Kit.Expect(Refused(Wire.OutputBytes(*file),"Another synthetic password") && Refused(Wire.OutputBytes(*file)[:file.count-1],PASSWORD),"wrong password/truncated recovery clears entire output") { return 4 }
    if !Wire.PrepareOutput(*corrupt,file.count) { return 5 }
    for index: 0..file.count-1 { corrupt[index]=file[index] }
    corrupt[corrupt.count-1]^=1
    if !Kit.Expect(Refused(Wire.OutputBytes(*corrupt),PASSWORD),"altered ciphertext rejected") { return 6 }
    corrupt[corrupt.count-1]^=1; corrupt[0]=120
    if !Kit.Expect(Refused(Wire.OutputBytes(*corrupt),PASSWORD),"bad recovery magic rejected") { return 7 }
    for mode: 0..2 {
        changed:=original
        if mode==0 { changed.account[0]^=1 } else if mode==1 { changed.public[0]^=1 } else { changed.private[0]^=1 }
        if !JSONText(*changed,0,*text) || !Seal(Fixture.Text(*text),PASSWORD,*corrupt) { Identity.Clear(*changed); return 8 }
        Identity.Clear(*changed)
        if !Kit.Expect(Refused(Wire.OutputBytes(*corrupt),PASSWORD),"unmatched account/public/private keys rejected") { return 9 }
    }
    for mode: 1..6 {
        if !JSONText(*original,cast(s32)mode,*text) || !Seal(Fixture.Text(*text),PASSWORD,*corrupt) { return 10 }
        if !Kit.Expect(Refused(Wire.OutputBytes(*corrupt),PASSWORD),"exact fields/integer version/key lengths/pin/duplicates enforced") { return 11 }
    }
    if !Kit.Expect(Refused(Wire.OutputBytes(*file),"🔒🔒🔒🔒🔒🔒🔒🔒🔒🔒🔒"),"password minimum counts UTF-8 characters") { return 12 }
    if !JSONText(*original,0,*text) || !Seal(Fixture.Text(*text),"🔒🔒🔒🔒🔒🔒🔒🔒🔒🔒🔒🔒",*corrupt) || !Identity.Recover(Wire.OutputBytes(*corrupt),Fixture.Bytes("🔒🔒🔒🔒🔒🔒🔒🔒🔒🔒🔒🔒"),*restored) { return 13 }
    print("backup_identity: local tests passed\n"); return 0
}
