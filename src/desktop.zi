// Inspect and publish only the native window Kryon created for this app.
Desktop :: #import "kryon/Desktop";
Model :: #import "model";
Viewer :: #import "viewer";
Map :: #import "map";
TextDetection :: #import "text_detection";
QRDetection :: #import "qr_detection";
Collage :: #import "collage";
#import "std/text"
#import "std/byte_text_linux"
SDL :: #system_library "SDL2";
X11 :: #system_library "X11";
SetTitle :: (window: *void, value: *u8) #foreign SDL "SDL_SetWindowTitle";
Version :: (version: *u8) #foreign SDL "SDL_GetVersion";
WMInfo :: struct { version: [3]u8; padding: u8; subsystem: s32; display: *void; window: u64; rest: [48]u8 }
WindowInfo :: (window: *void, info: *WMInfo) -> s32 #foreign SDL "SDL_GetWindowWMInfo";
Atom :: (connection: *void, name: *u8, existing: s32) -> u64 #foreign X11 "XInternAtom";
Property :: (connection: *void, window: u64, atom: u64, kind: u64, format: s32, mode: s32, bytes: *u8, count: s32) -> s32 #foreign X11 "XChangeProperty";
Flush :: (connection: *void) -> s32 #foreign X11 "XFlush";
control_ids: [512]s32;
control_labels: [512][513]u8;
control_bounds: [512][4]float32;
control_enabled: [512]bool;
control_count: s32;
frames: s32;

Record :: (id: s32, label: string, x: float32, y: float32, width: float32, height: float32, enabled: bool) {
    if control_count>=512 { return }; i:=control_count; control_count+=1
    control_ids[i]=id; Model.Set(control_labels[i][:],label); control_bounds[i]=.{x,y,width,height}; control_enabled[i]=enabled
}
Publish :: () {
    frames+=1; if frames%10!=0 { return }
    window:=Desktop.DesktopWindow(); if window==null { return }
    title_bytes: [16]u8; Model.Set(title_bytes[:],"Photos"); SetTitle(window,*title_bytes[0])
    info: WMInfo; Version(*info.version[0])
    if WindowInfo(window,*info)==0 || info.subsystem!=2 || info.window==0 { return }
    name: [32]u8; Model.Set(name[:],"_HARMONY_APP_STATE"); atom:=Atom(info.display,*name[0],0)
    out: Vec(u8); BuilderPrint(*out,"{\"interface\":\"harmony.app-state.v1\",\"app\":\"photos\",\"loading\":%",Model.loading)
    Model.Property(*out,"view",Model.view); Model.Property(*out,"status",TextFromCString(*Model.message[0]))
    Model.Property(*out,"editor",Model.editor)
    BuilderPrint(*out,",\"collage_active\":%,\"collage_count\":%,\"collage_chosen\":%,\"collage_layout\":%,\"collage_shape\":%,\"collage_swapping\":%",Collage.active,Collage.count,Collage.chosen,Collage.layout,Collage.shape,Collage.swapping)
    Model.Property(*out,"sort",Model.sort)
    BuilderPrint(*out,",\"vault_unlocked\":%",Model.vault_unlocked)
    BuilderPrint(*out,",\"guest_active\":%",Model.guest_active)
    BuilderPrint(*out,",\"app_lock_enabled\":%,\"app_locked\":%",Model.app_lock_enabled,Model.app_locked)
    BuilderPrint(*out,",\"app_lock_method\":%",Model.app_lock_method)
    BuilderPrint(*out,",\"app_lock_delay\":%",Model.app_lock_delay)
    BuilderPrint(*out,",\"detected_words\":%",TextDetection.count)
    BuilderPrint(*out,",\"detected_codes\":%,\"chosen_code\":%",QRDetection.count,QRDetection.chosen)
    BuilderPrint(*out,",\"slideshow_active\":%,\"slideshow_paused\":%,\"slideshow_offset\":%,\"slideshow_count\":%,\"slideshow_interval\":%,\"slideshow_albums\":%",Model.slide_active,Model.slide_paused,Model.slide_offset,Model.slide_count,Model.slide_intervals[Model.slide_interval],Model.slide_album_count)
    BuilderPrint(*out,",\"playback_state\":%,\"playback_position\":%,\"playback_duration\":%,\"playback_speed\":%,\"playback_volume\":%",Model.PlaybackState(),Model.PlaybackPosition(),Model.PlaybackDuration(),Model.playback_speed,Model.playback_volume)
    BuilderPrint(*out,",\"crop\":[%,%,%,%]",Model.crop_candidate[0],Model.crop_candidate[1],Model.crop_candidate[2],Model.crop_candidate[3])
    BuilderPrint(*out,",\"photo_zoom\":%,\"photo_center\":[%,%],\"photo_expanded\":%",Viewer.zoom,Viewer.center_x,Viewer.center_y,Viewer.expanded)
    BuilderPrint(*out,",\"map_level\":%,\"map_gallery\":%,\"map_markers\":%,\"map_bounds\":[%,%,%,%]",Map.level,Map.gallery,Map.count,Map.bounds[0],Map.bounds[1],Map.bounds[2],Map.bounds[3])
    BuilderPrint(*out,",\"scroll\":%,\"nodes\":%,\"selection_count\":%,\"selected\":%,\"controls\":[",Model.scroll,Model.count,Model.picked_count,Model.selected)
    for i: 0..control_count-1 {
        BuilderPrint(*out,"%{\"control\":\"%\",\"role\":1,\"enabled\":%,\"x\":%,\"y\":%,\"width\":%,\"height\":%,\"label\":",ifx i==0 then "" else ",",control_ids[i],control_enabled[i],control_bounds[i][0],control_bounds[i][1],control_bounds[i][2],control_bounds[i][3])
        Model.Quoted(*out,TextFromCString(*control_labels[i][0])); BuilderPrint(*out,"}")
    }
    BuilderPrint(*out,"]}"); value:=BuilderFinish(out); descriptor:=cast(*TextDescriptor)(*value)
    if value.count<=65535 { unused Property(info.display,info.window,atom,31,8,0,descriptor.data,cast(s32)value.count); unused Flush(info.display) }
    Model.Release(value)
}
