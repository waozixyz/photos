// Native photo property mutations. SQLite owns one writer snapshot from
// selection expansion through authorization and commit; originals are untouched.
using SQLite :: #import "sqlite/SQLite";
Album :: #import "album_edit";
AlbumDetails :: #import "album_details";
Metadata :: #import "metadata_input";
#import "std/byte_text_linux"
#import "std/json_scan"
#import "std/text_buffer"
Clock :: #import "std/date_time_linux";
c :: #system_library "c";
Read :: (fd: s32, data: *u8, count: usize) -> s64 #foreign c "read";
Write :: (fd: s32, data: *u8, count: usize) -> s64 #foreign c "write";
Timespec :: struct { seconds: s64; nanoseconds: s64 }
GetTime :: (clock: s32, value: *Timespec) -> s32 #foreign c "clock_gettime";
Monotonic :: () -> float64 {
    value: Timespec; if GetTime(1,*value) != 0 { return 0.0 }
    return cast(float64)value.seconds+cast(float64)value.nanoseconds/1000000000.0
}
Send :: (text: string) -> bool {
    at: s32; bytes: [4096]u8
    while at < cast(s32)text.count {
        count := cast(s32)text.count-at; if count > 4096 { count = 4096 }
        for i: 0..count-1 { bytes[i] = text[at+i] }
        written: s32
        while written < count {
            amount := Write(1,*bytes[written],cast(usize)(count-written))
            if amount <= 0 { return false }; written += cast(s32)amount
        }
        at += count
    }
    newline: u8 = 10; return Write(1,*newline,1) == 1
}
Line :: (bytes: []u8) -> s32 {
    at: s32
    while at < cast(s32)bytes.count {
        if Read(0,*bytes[at],1) != 1 { return -1 }
        if bytes[at] == 10 { return at }; at += 1
    }
    return -1
}
Failure :: (message: string) -> s32 {
    out: Vec(u8); BuilderPrint(*out,"{\"error\":\"%\"}",message)
    unused Send(BuilderFinish(out)); return 1
}
Identity :: (id: string) -> bool {
    if id.count != 64 { return false }
    for byte: id { if !((byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102)) { return false } }
    return true
}
Copy :: (text: string, bytes: []u8) -> bool {
    if text.count >= bytes.count { return false }
    for i: 0..text.count-1 { bytes[i] = text[i] }; bytes[text.count] = 0; return true
}
Photo :: struct { id: [65]u8; kind: [8]u8; hidden: bool; video: [65]u8; still: [65]u8; keys: s32; extension: [20]u8 }
Load :: (database: *void, id: string, photo: *Photo) -> bool {
    statement: *void
    sql := "SELECT kind,hidden,json_type(metadata,'$.photosLive'),coalesce(json_extract(metadata,'$.photosLive.video'),''),coalesce(json_extract(metadata,'$.photosLive.photo'),''),(SELECT count(*) FROM json_each(photos.metadata,'$.photosLive')),extension FROM photos WHERE id=?"
    if SqlitePrepareText(database,sql,-1,*statement,null) != SQLITE_OK { return false }
    defer { unused SqliteFinalize(statement) }
    if SqliteBindTextString(statement,1,id,cast(s32)id.count) != SQLITE_OK || SqliteStep(statement) != SQLITE_ROW { return false }
    if !Copy(id,photo.id[:]) || !Copy(TextFromCString(SqliteColumnText(statement,0)),photo.kind[:]) ||
        !Copy(TextFromCString(SqliteColumnText(statement,3)),photo.video[:]) || !Copy(TextFromCString(SqliteColumnText(statement,4)),photo.still[:]) ||
        !Copy(TextFromCString(SqliteColumnText(statement,6)),photo.extension[:]) { return false }
    photo.hidden = SqliteColumnInt(statement,1) != 0; photo.keys = SqliteColumnInt(statement,5)
    type := TextFromCString(SqliteColumnText(statement,2)); return type == "" || type == "object"
}
Add :: (photos: []Photo, count: *s32, photo: Photo) -> bool {
    for i: 0..count.*-1 { if TextFromCString(*photos[i].id[0]) == TextFromCString(*photo.id[0]) { return true } }
    if count.* >= cast(s32)photos.count { return false }; photos[count.*] = photo; count.* += 1; return true
}
Expand :: (database: *void, id: string, photos: []Photo, count: *s32) -> bool {
    photo: Photo; if !Identity(id) || !Load(database,id,*photo) { return false }
    video := TextFromCString(*photo.video[0]); still := TextFromCString(*photo.still[0])
    if video == "" && still == "" { return Add(photos,count,photo) }
    other := ifx video != "" then video else still
    if !Identity(other) || other == id || photo.keys != 1 { return false }
    peer: Photo; if !Load(database,other,*peer) || peer.keys != 1 { return false }
    if video != "" {
        if TextFromCString(*photo.kind[0]) != "photo" || TextFromCString(*peer.kind[0]) != "video" || TextFromCString(*peer.still[0]) != id || peer.video[0] != 0 { return false }
    } else {
        if TextFromCString(*photo.kind[0]) != "video" || TextFromCString(*peer.kind[0]) != "photo" || TextFromCString(*peer.video[0]) != id || peer.still[0] != 0 { return false }
    }
    return Add(photos,count,photo) && Add(photos,count,peer)
}
EditAlbum :: (path: string, json: string) -> s32 {
    action: [32]u8; name: [513]u8; value: [8193]u8; search: [513]u8; source: [65]u8
    actionLength := ReadStringText(json,FieldAt(json,0,"operation"),action[:])
    nameLength := ReadStringText(json,FieldAt(json,0,"name"),name[:])
    valueLength := ReadStringText(json,FieldAt(json,0,"value"),value[:])
    searchLength := ReadStringText(json,FieldAt(json,0,"search"),search[:])
    sourceLength := ReadStringText(json,FieldAt(json,0,"source"),source[:])
    if actionLength < 1 || nameLength < 0 || valueLength < 0 || searchLength < 0 || sourceLength < 0 { return Failure("Choose valid album properties") }
    database: *void
    if SqliteOpenText(path,*database,SQLITE_OPEN_READWRITE) != SQLITE_OK { if database != null { unused SqliteClose(database) }; return Failure("Cannot open the private library database") }
    defer { unused SqliteClose(database) }
    unused SqliteBusyTimeout(database,5000)
    if SqliteExecText(database,"BEGIN IMMEDIATE") != SQLITE_OK { return Failure("The library is busy; try again") }
    defer { unused SqliteExecText(database,"ROLLBACK") }
    time: Timespec; if GetTime(0,*time) != 0 { return Failure("Cannot read the edit time") }
    now := cast(float64)time.seconds+cast(float64)time.nanoseconds/1000000000.0
    error := AlbumDetails.Mutate(database,TextFromBytes(action[:actionLength]),TextFromBytes(name[:nameLength]),TextFromBytes(value[:valueLength]),TextFromBytes(search[:searchLength]),TextFromBytes(source[:sourceLength]),now)
    if error != "" { return Failure(error) }
    if SqliteExecText(database,"COMMIT") != SQLITE_OK { return Failure("Cannot save the album edit") }
    unused Send("{\"saved\":1}"); return 0
}
main :: (argc: s32, argv: **u8) -> s32 {
    if argc != 2 { return Failure("Supply the private library database") }
    input: [262145]u8; length := Line(input[:])
    if length <= 0 || length > 262144 { return Failure("Photo edit exceeds its limit") }
    json := TextFromBytes(input[:length])
    if json[0] != 123 || Space(json,ValueEnd(json,0,0)) != length { return Failure("Choose a valid photo edit") }
    actionBytes: [32]u8; valueBytes: [8193]u8
    if ReadStringText(json,FieldAt(json,0,"action"),actionBytes[:]) < 0 { return Failure("Choose a photo action") }
    action := TextFromCString(*actionBytes[0]); valueLength := ReadStringText(json,FieldAt(json,0,"value"),valueBytes[:])
    if action == "album_definition" { return EditAlbum(TextFromCString(argv[1]),json) }
    property: string
    if action == "favorite" || action == "favorite_set" { property = "favorite" }
    if action == "hidden" || action == "hidden_set" { property = "hidden" }
    if action == "archived" || action == "archived_set" { property = "archived" }
    text := action == "caption" || action == "tags"
    trash := action == "trash" || action == "restore"
    album := action == "album_add" || action == "album_remove"
    date := action == "taken"; location := action == "location"; rename := action == "rename"
    if property == "" && !text && !trash && !album && !date && !location && !rename { return Failure("Unknown native photo action") }
    explicit := action == "favorite_set" || action == "hidden_set" || action == "archived_set"
    if explicit && (valueLength != 1 || valueBytes[0] != 48 && valueBytes[0] != 49) { return Failure("Choose whether to enable this property") }
    if text && (valueLength < 0 || valueLength > 8192) { return Failure("Enter at most 8192 bytes of text") }
    if album && (valueLength < 1 || valueLength > 512) { return Failure("Enter an album name of at most 512 bytes") }
    dateValue: float64
    if date {
        if valueLength < 0 { return Failure("Enter a valid date and time, for example 2024-06-15 14:30:00+00:00") }
        dateValue = Metadata.Date(TextFromBytes(valueBytes[:valueLength]))
        if dateValue < 0.0 { return Failure("Enter a valid date and time, for example 2024-06-15 14:30:00+00:00") }
    }
    geo: Vec(u8); clearLocation: bool
    if location {
        if valueLength < 0 { return Failure("Enter latitude, longitude, or leave empty to remove location") }
        coordinates := Metadata.Coordinates(TextFromBytes(valueBytes[:valueLength]))
        if !coordinates.valid { return Failure("Enter valid coordinates: latitude -90 to 90, longitude -180 to 180") }
        clearLocation = coordinates.clear
        if clearLocation { BuilderPrint(*geo,"null") }
        else {
            latitude: [64]u8; longitude: [64]u8
            if !Metadata.Format(coordinates.latitude,latitude[:]) || !Metadata.Format(coordinates.longitude,longitude[:]) { return Failure("Cannot save the photo location") }
            BuilderPrint(*geo,"{\"latitude\":%,\"longitude\":%}",TextFromCString(*latitude[0]),TextFromCString(*longitude[0]))
        }
    }
    geoText := BuilderFinish(geo)
    if rename {
        if valueLength < 1 || valueLength > 512 || TextFromBytes(valueBytes[:valueLength]) == "." || TextFromBytes(valueBytes[:valueLength]) == ".." { return Failure("Enter a file name without a folder path") }
        for i: 0..valueLength-1 { if valueBytes[i] < 32 || valueBytes[i] == 47 || valueBytes[i] == 92 { return Failure("Enter a file name without a folder path") } }
    }
    offsets: [1000]s32; requested := ArrayPositions(json,FieldAt(json,0,"ids"),offsets[:])
    if requested < 1 || requested > 1000 { return Failure("Select between 1 and 1000 photos") }
    database: *void
    if SqliteOpenText(TextFromCString(argv[1]),*database,SQLITE_OPEN_READWRITE) != SQLITE_OK {
        if database != null { unused SqliteClose(database) }; return Failure("Cannot open the private library database")
    }
    defer { unused SqliteClose(database) }
    unused SqliteBusyTimeout(database,5000)
    if SqliteExecText(database,"BEGIN IMMEDIATE") != SQLITE_OK { return Failure("The library is busy; try again") }
    defer { unused SqliteExecText(database,"ROLLBACK") }
    photos: [2000]Photo; count: s32; hidden: bool
    for i: 0..requested-1 {
        id: [65]u8
        if ReadStringText(json,offsets[i],id[:]) != 64 || !Expand(database,TextFromCString(*id[0]),photos[:],*count) { return Failure("Photo not found or Live Photo pairing is incomplete") }
    }
    challenge: Vec(u8); BuilderPrint(*challenge,"{\"authorize\":[")
    for i: 0..count-1 {
        BuilderPrint(*challenge,"%\"%\"",ifx i == 0 then "" else ",",TextFromCString(*photos[i].id[0]))
        if photos[i].hidden { hidden = true }
    }
    BuilderPrint(*challenge,"]}")
    if !Send(BuilderFinish(challenge)) { return 1 }
    permitBytes: [1025]u8; permitLength := Line(permitBytes[:])
    if permitLength < 1 { return Failure("Photo edit authorization ended") }
    permit := TextFromBytes(permitBytes[:permitLength])
    if permit[0] != 123 || Space(permit,ValueEnd(permit,0,0)) != permitLength { return Failure("Photo edit authorization ended") }
    allow := ReadNumber(permit,FieldAt(permit,0,"allow")); until := ReadNumber(permit,FieldAt(permit,0,"until"))
    now := Monotonic()
    if !allow.valid || allow.value != 1.0 || !until.valid || now <= 0.0 || until.value <= now || until.value > now+10.0 { return Failure("Hidden is locked; authenticate before changing hidden photos") }
    sql: Vec(u8)
    BuilderPrint(*sql,"UPDATE photos SET ")
    if property != "" {
        if explicit { BuilderPrint(*sql,"%=?",property) }
        else { BuilderPrint(*sql,"%=1-%",property,property) }
    }
    else if text { BuilderPrint(*sql,"%=?",action) }
    else if rename { BuilderPrint(*sql,"name=?") }
    else if date { BuilderPrint(*sql,"taken=?,edits=json_set(edits,'$.taken',json('true'))") }
    else if location {
        if clearLocation { BuilderPrint(*sql,"metadata=json_remove(metadata,'$.geoData','$.geoDataExif')") }
        else { BuilderPrint(*sql,"metadata=json_set(json_remove(metadata,'$.geoData','$.geoDataExif'),'$.geoData',json(?1))") }
        BuilderPrint(*sql,",edits=json_set(edits,'$.location',json(?1))")
    }
    else { BuilderPrint(*sql,"trashed=?") }
    if location { BuilderPrint(*sql,",updated=max(updated+0.000001,?2),dirty=1 WHERE id=?3") }
    else { BuilderPrint(*sql,",updated=max(updated+0.000001,?),dirty=1 WHERE id=?") }
    statement: *void
    time: Timespec; if GetTime(0,*time) != 0 { return Failure("Cannot read the edit time") }
    timestamp := cast(float64)time.seconds+cast(float64)time.nanoseconds/1000000000.0
    if album {
        prepared := Album.Prepare(database,action,TextFromBytes(valueBytes[:valueLength]),timestamp)
        if prepared.error != "" { return Failure(prepared.error) }; statement = prepared.statement
    } else if SqlitePrepareText(database,BuilderFinish(sql),-1,*statement,null) != SQLITE_OK { return Failure("Cannot prepare the photo edit") }
    defer { unused SqliteFinalize(statement) }
    for i: 0..count-1 {
        if hidden && Monotonic() >= until.value { return Failure("Hidden access expired before the edit finished") }
        unused SqliteReset(statement); if !album { unused SqliteClearBindings(statement) }
        index: s32 = ifx album then 3 else 1
        if explicit { if SqliteBindInt(statement,index,cast(s32)valueBytes[0]-48) != SQLITE_OK { return Failure("Cannot bind the photo edit") }; index += 1 }
        else if text { if SqliteBindTextString(statement,index,TextFromBytes(valueBytes[:valueLength]),valueLength) != SQLITE_OK { return Failure("Cannot bind the photo edit") }; index += 1 }
        else if date { if SqliteBindDouble(statement,index,dateValue) != SQLITE_OK { return Failure("Cannot bind the capture date") }; index += 1 }
        else if location { if SqliteBindTextString(statement,index,geoText,cast(s32)geoText.count) != SQLITE_OK { return Failure("Cannot bind the photo location") }; index += 1 }
        else if rename {
            name: Vec(u8); original := TextFromBytes(valueBytes[:valueLength])
            if photos[i].still[0] != 0 {
                dot: s32 = -1
                for j: 1..valueLength-2 { if valueBytes[j] == 46 { dot = j } }
                stem := ifx dot < 0 then original else original[:dot]
                BuilderPrint(*name,"%",stem); BuilderPrint(*name,"%",TextFromCString(*photos[i].extension[0]))
            } else { BuilderPrint(*name,"%",original) }
            nameText := BuilderFinish(name)
            if nameText.count > 512 || SqliteBindTextString(statement,index,nameText,cast(s32)nameText.count) != SQLITE_OK { return Failure("Enter a file name without a folder path") }; index += 1
        }
        else if trash { if SqliteBindInt64(statement,index,ifx action == "trash" then cast(s64)timestamp else 0) != SQLITE_OK { return Failure("Cannot bind the photo edit") }; index += 1 }
        if SqliteBindDouble(statement,index,timestamp) != SQLITE_OK || SqliteBindTextString(statement,index+1,TextFromCString(*photos[i].id[0]),64) != SQLITE_OK ||
            SqliteStep(statement) != SQLITE_DONE || SqliteChanges(database) != 1 { return Failure("Cannot finish the photo edit") }
    }
    if hidden && Monotonic() >= until.value { return Failure("Hidden access expired before the edit finished") }
    if SqliteExecText(database,"COMMIT") != SQLITE_OK { return Failure("Cannot save the photo edit") }
    out: Vec(u8); BuilderPrint(*out,"{\"updated\":%}",count); if !Send(BuilderFinish(out)) { return 1 }; return 0
}
