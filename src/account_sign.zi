// Private binary ML-DSA-44 account signing. Keys never enter arguments or logs.
// The existing Oqs package owns the cryptographic API and pinned implementation.
using Oqs :: #import "oqs/Oqs";
Wire :: #import "sync_crypto";
#import "std/byte_text_linux"
c :: #system_library "c";
Allocate :: (bytes: usize) -> *void #foreign c "malloc";
Read :: (fd: s32, bytes: *u8, count: usize) -> s64 #foreign c "read";
Errno :: () -> *s32 #foreign c "__errno_location";
main :: () -> s32 {
    header: [6]u8
    if !Wire.ReadAll(*header[0],6) || header[0] != 1 || header[1] < 1 || header[1] > 3 { return 2 }
    mode := header[1]; count := cast(s64)Wire.Number(header[2:])
    if count > 1048576 || (mode == 1 && count != 0) { return 2 }
    public: [MlDsa44PublicKeyBytes]u8
    private: [MlDsa44SecretKeyBytes]u8
    signature: [MlDsa44SignatureBytes]u8
    defer { Oqs.Cleanse(private[:]) }
    if mode == 2 && !Wire.ReadAll(*private[0],Oqs.MlDsa44SecretKeyBytes) { return 2 }
    if mode == 3 && (!Wire.ReadAll(*public[0],Oqs.MlDsa44PublicKeyBytes) || !Wire.ReadAll(*signature[0],Oqs.MlDsa44SignatureBytes)) { return 2 }
    bytes := cast(*u8)Allocate(cast(usize)(count+1))
    defer { Wire.Free(bytes,count+1) }
    if bytes == null || !Wire.ReadAll(bytes,count) { return 2 }
    // Read one complete frame only; partial or appended frames emit nothing.
    extra: u8; amount: s64
    while true { amount = Read(0,*extra,1); if amount < 0 && Errno().* == 4 { continue }; break }
    if amount != 0 { return 2 }
    message := BytesFromPointer(bytes,cast(u64)count)
    if mode == 1 {
        if !Oqs.MlDsa44KeyPair(public[:],private[:]) { return 2 }
        if !Wire.SendAll(*public[0],Oqs.MlDsa44PublicKeyBytes) || !Wire.SendAll(*private[0],Oqs.MlDsa44SecretKeyBytes) { return 2 }
        return 0
    }
    if mode == 3 { return ifx Oqs.MlDsa44Verify(message,signature[:],public[:]) then 0 else 1 }
    size := Oqs.MlDsa44Sign(signature[:],message,private[:])
    if size != Oqs.MlDsa44SignatureBytes { return 2 }
    return ifx Wire.SendAll(*signature[0],size) then 0 else 2
}
