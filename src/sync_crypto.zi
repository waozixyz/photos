// Binary stdin/stdout protocol; content keys and plaintext never enter arguments,
// text diagnostics or files. DaochiClient verifies before plaintext is emitted.
Native :: #import "daochi_client/crypto_native";
Backup :: #import "backup_crypto";
#import "std/byte_text_linux"
c :: #system_library "c";
Read :: (fd: s32, bytes: *u8, count: usize) -> s64 #foreign c "read";
Write :: (fd: s32, bytes: *u8, count: usize) -> s64 #foreign c "write";
Allocate :: (bytes: usize) -> *void #foreign c "malloc";
Release :: (bytes: *void) #foreign c "free";
Errno :: () -> *s32 #foreign c "__errno_location";
ReadAll :: (bytes: *u8, count: s64) -> bool {
    at: s64
    while at < count {
        amount := Read(0,*bytes[at],cast(usize)(count-at))
        if amount < 0 && Errno().* == 4 { continue }
        if amount <= 0 { return false }; at += amount
    }
    return true
}
SendAll :: (bytes: *u8, count: s64) -> bool {
    at: s64
    while at < count {
        amount := Write(1,*bytes[at],cast(usize)(count-at))
        if amount < 0 && Errno().* == 4 { continue }
        if amount <= 0 { return false }; at += amount
    }
    return true
}
Number :: (bytes: []u8) -> u32 {
    value: u32; for byte: bytes { value = (value << 8) | cast(u32)byte }; return value
}
Free :: (bytes: *u8, count: s64) {
    if bytes != null { Native.Clear(BytesFromPointer(bytes,cast(u64)count)); Release(cast(*void)bytes) }
}
main :: () -> s32 {
    if !Native.Initialize() { return 2 }
    // version, mode, input length, AAD length, 32-byte key, 24-byte nonce.
    // 1 encrypt; 2 decrypt; 3 resumable blob; 4 randomly sealed metadata;
    // 5 Ed25519 device signature; 6 device public key; 7 new device seed.
    header: [66]u8
    defer { Native.Clear(header[:]) }
    if !ReadAll(*header[0],66) || header[0] != 1 || header[1] < 1 || header[1] > 7 { return 2 }
    mode := header[1]; inputCount := cast(s64)Number(header[2:6]); aadCount := cast(s64)Number(header[6:10])
    if inputCount > 134217744 || aadCount > 1048576 || (mode != 2 && inputCount > 134217728) || (mode == 2 && inputCount < 16) { return 2 }
    if mode >= 5 {
        if aadCount != 0 || (mode >= 6 && inputCount != 0) { return 2 }
        check: s32 = 42
        while check < 66 { if header[check] != 0 { return 2 }; check += 1 }
        if mode == 7 { check = 10; while check < 42 { if header[check] != 0 { return 2 }; check += 1 } }
    }
    input := cast(*u8)Allocate(cast(usize)(inputCount+1)); aad := cast(*u8)Allocate(cast(usize)(aadCount+32))
    outputCount := ifx mode == 5 then 64 else ifx mode >= 6 then 32 else inputCount+40
    output := cast(*u8)Allocate(cast(usize)outputCount)
    defer { Free(input,inputCount+1); Free(aad,aadCount+32); Free(output,outputCount) }
    if input == null || aad == null || output == null || !ReadAll(aad,aadCount) || !ReadAll(input,inputCount) { return 2 }
    // A second frame or trailing bytes are forbidden in this one-shot helper.
    extra: u8; amount: s64
    while true { amount = Read(0,*extra,1); if amount < 0 && Errno().* == 4 { continue }; break }
    if amount != 0 { return 2 }
    if mode >= 5 {
        if mode == 7 {
            return ifx Native.RandomBytes(BytesFromPointer(output,32)) && SendAll(output,32) then 0 else 2
        }
        if mode == 6 {
            return ifx Native.DevicePublic(header[10:42],BytesFromPointer(output,32)) && SendAll(output,32) then 0 else 2
        }
        return ifx Native.SignDevice(header[10:42],BytesFromPointer(input,cast(u64)inputCount),BytesFromPointer(output,64)) && SendAll(output,64) then 0 else 2
    }
    if mode == 3 || mode == 4 {
        size := Backup.Seal(BytesFromPointer(input,cast(u64)inputCount),BytesFromPointer(aad,cast(u64)aadCount),
            header[10:42],BytesFromPointer(output,cast(u64)outputCount),mode==3)
        return ifx size==inputCount+40 && SendAll(output,size) then 0 else 2
    }
    bytes:=BytesFromPointer(input,cast(u64)inputCount)
    context:=BytesFromPointer(aad,cast(u64)aadCount)
    result:=BytesFromPointer(output,cast(u64)outputCount)
    if mode == 2 {
        size:=Native.Open(bytes,context,header[10:42],header[42:],result)
        if size < 0 { return 1 }
        return ifx SendAll(output,size) then 0 else 2
    }
    size:=Native.Seal(bytes,context,header[10:42],header[42:],result)
    return ifx size==inputCount+16 && SendAll(output,size) then 0 else 2
}
