// Native cosine ranking over local normalized CLIP vectors. Never opens a
// window or connects to a network; the gallery owns privacy filtering.
#import "std/c_string"
using SQLite :: #import "sqlite/SQLite";
LivePhoto :: #import "live_photo";
#import "std/text_buffer"
using Vectors :: #import "std/vec";

#scope_file
libc :: #system_library "c";
Open :: (path: *u8, mode: *u8) -> *void #foreign libc "fopen";
Read :: (bytes: *void, size: usize, count: usize, file: *void) -> usize #foreign libc "fread";
Get :: (file: *void) -> s32 #foreign libc "fgetc";
Close :: (file: *void) -> s32 #foreign libc "fclose";
Copy :: (out: *void, bytes: *void, count: usize) -> *void #foreign libc "memcpy";
Allocate :: (count: usize, size: usize) -> *void #foreign libc "calloc";
Release :: (bytes: *void) #foreign libc "free";
QueryVector :: struct { values: [512]float32 }
DropVector :: (data: *void) { Release(data) }
Score :: (context: *void, argc: s32, argv: **void) {
    SqliteResultDouble(context,-1.0)
    vector := cast(*QueryVector)SqliteUserData(context)
    if vector == null || argc != 1 || argv == null || SqliteValueType(argv[0]) != SQLITE_BLOB || SqliteValueBytes(argv[0]) != 2048 { return }
    blob := SqliteValueBlob(argv[0]); if blob == null { return }
    values: [512]float32; unused Copy(cast(*void)*values[0],blob,2048)
    sum: float64; norm: float64
    for i: 0..511 {
        value := cast(float64)values[i]
        if value != value || value < -1.001 || value > 1.001 { return }
        norm += value * value; sum += value * cast(float64)vector.values[i]
    }
    if norm < 0.99 || norm > 1.01 { return }
    SqliteResultDouble(context,sum)
}
#scope_export
Model :: "clip-vit-b32-int8-v1";
RankSQL :: "photos_semantic_score((SELECT embedding FROM semantic_embeddings WHERE photo_id=photos.id AND model='clip-vit-b32-int8-v1' AND error=''))";
// Copies the query into immutable SQLite-owned function data. Each connection
// owns a distinct context; replacement/close/failure releases exactly once.
RegisterVector :: (database: *void, bytes: []u8) -> bool {
    if database == null || bytes.count != 2048 { return false }
    values: [512]float32; unused Copy(cast(*void)*values[0],cast(*void)*bytes[0],2048)
    norm: float64
    for value: values {
        v := cast(float64)value
        if v != v || v < -1.001 || v > 1.001 { return false }
        norm += v*v
    }
    if norm < 0.99 || norm > 1.01 { return false }
    vector := cast(*QueryVector)Allocate(1,cast(usize)size_of(QueryVector))
    if vector == null { return false }
    unused Copy(cast(*void)*vector.values[0],cast(*void)*values[0],2048)
    name: [32]u8; unused CopyCString("photos_semantic_score",name[:])
    callback: SqliteScalar = Score; destructor: SqliteDestructor = DropVector
    // SQLite calls destructor even when registration fails. Never free the
    // transferred context here, and retain an existing registration on error.
    return SqliteCreateFunction(database,*name[0],1,0x200801,cast(*void)vector,callback,null,null,destructor) == SQLITE_OK
}
Register :: (database: *void, path: string) -> bool {
    bytes: [4097]u8; mode: [3]u8 = .{114,98,0}
    if !CopyCString(path,bytes[:]) { return false }
    file := Open(*bytes[0],*mode[0]); if file == null { return false }
    defer { unused Close(file) }
    values: [2048]u8
    if Read(cast(*void)*values[0],1,2048,file) != 2048 || Get(file) != -1 { return false }
    return RegisterVector(database,values[:])
}
RegisterPhoto :: (database: *void, identity: string) -> bool {
    sql: Vec(u8)
    if !BuilderAppend(sql,"SELECT embedding FROM photos JOIN semantic_embeddings e ON e.photo_id=photos.id WHERE photos.id=? AND photos.kind='photo' AND photos.hidden=0 AND photos.trashed=0 AND e.model=? AND e.error='' AND ") ||
        !BuilderAppend(sql,LivePhoto.GallerySQL) { return false }
    statement: *void
    if SqlitePrepareText(database,TextView(VecSlice(sql,0,sql.count)),-1,*statement,null) != SQLITE_OK { return false }
    defer { if statement != null { unused SqliteFinalize(statement) } }
    if SqliteBindTextString(statement,1,identity,-1) != SQLITE_OK || SqliteBindTextString(statement,2,Model,-1) != SQLITE_OK { return false }
    if SqliteStep(statement) != SQLITE_ROW || SqliteColumnType(statement,0) != SQLITE_BLOB || SqliteColumnBytes(statement,0) != 2048 { return false }
    bytes := SqliteColumnBlob(statement,0)
    if bytes == null { return false }
    values: [2048]u8; unused Copy(cast(*void)*values[0],cast(*void)bytes,2048)
    // Replacing the score function on a persistent connection requires the
    // seed reader to be finished, even though its vector was already copied.
    unused SqliteFinalize(statement); statement = null
    return RegisterVector(database,values[:])
}
