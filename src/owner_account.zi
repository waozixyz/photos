// The desktop Inbe account is shared with Photos. This module only reads it.
SQL :: #import "sqlite/SQLite";
Keys :: #import "daochi_client/keys";
Crypto :: #import "daochi_client/crypto";
#import "std/byte_text_linux"
#import "std/text_buffer"
using Vectors :: #import "std/vec";

#scope_export
Unavailable :: "Inbe's Daochi account is unavailable; sign in to Inbe on this computer first";
Incomplete :: "Inbe's Daochi account is incomplete; sign in to Inbe on this computer first";
Mismatch :: "Inbe's Daochi account keys do not match; Photos keys were preserved";
OwnerAccount :: struct {
    public_key: [1312]u8
    private_key: [2560]u8
    account_id: [65]u8
    valid: bool
}

#scope_file
c :: #system_library "c";
Environment :: (name: *u8) -> *u8 #foreign c "getenv";
Allocate :: (count: usize, size: usize) -> *void #foreign c "calloc";
Release :: (memory: *void) #foreign c "free";
Field :: struct {
    present: bool
    hex: bool
    count: s32
    bytes: [5121]u8
}
User :: struct {
    id: string
    kind: s32
    fields: [3]Field
}
UserEntry :: struct { value: *User }

CopyColumn :: (statement: *void, column: s32) -> string {
    out: Vec(u8)
    bytes := SQL.SqliteColumnText(statement, column)
    count := SQL.SqliteColumnBytes(statement, column)
    if bytes != null {
        for index: 0..count - 1 { VecPush(out, bytes[index]) }
    }
    return BuilderFinish(out)
}

ReadField :: (statement: *void, field: *Field) {
    Keys.SecureWipe(cast(*u8)field, size_of(Field))
    kind := SQL.SqliteColumnType(statement, 2)
    if kind == SQL.SQLITE_INTEGER {
        field.present = SQL.SqliteColumnInt64(statement, 2) != 0
        return
    }
    if kind == SQL.SQLITE_FLOAT {
        field.present = SQL.SqliteColumnDouble(statement, 2) != 0.0
        return
    }
    if kind == SQL.SQLITE_NULL { return }
    count := SQL.SqliteColumnBytes(statement, 2)
    field.count = count
    field.present = count > 0
    if kind != SQL.SQLITE_TEXT || count <= 0 { return }
    text := SQL.SqliteColumnText(statement, 2)
    if text == null { return }
    field.hex = true
    for index: 0..count - 1 {
        byte := text[index]
        if !((byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102)) {
            field.hex = false
        }
        if index < 5120 { field.bytes[index] = byte }
    }
}

DefaultDatabase :: () -> string {
    name: [5]u8 = .[72, 79, 77, 69, 0]
    home := TextFromCString(Environment(*name[0]))
    if home.count == 0 { return "" }
    out: Vec(u8)
    BuilderPrint(*out, "%/.local/share/inbe/inbe.db", home)
    return BuilderFinish(out)
}

OddHexError :: (count: s32) -> string {
    // Preserve bytes.fromhex's diagnostic for an odd, otherwise valid hex key.
    out: Vec(u8)
    BuilderPrint(*out, "non-hexadecimal number found in fromhex() arg at position %", count)
    return BuilderFinish(out)
}

#scope_export
Clear :: (account: *OwnerAccount) {
    if account != null { Keys.SecureWipe(cast(*u8)account, size_of(OwnerAccount)) }
}

// Also accepts legacy Photos account bytes; it never creates/replaces a key.
FromKeys :: (public_key: []u8, private_key: []u8) -> OwnerAccount, string {
    account: OwnerAccount
    if public_key.count != 1312 || private_key.count != 2560 {
        return account, Incomplete
    }
    id: [32]u8
    Crypto.Sha256(*public_key[0], public_key.count, *id[0])
    if !Keys.ValidateIdentity(id[:], public_key, private_key) {
        return account, Mismatch
    }
    for index: 0..1311 { account.public_key[index] = public_key[index] }
    for index: 0..2559 { account.private_key[index] = private_key[index] }
    if Crypto.BytesToHex(*id[0], 32, *account.account_id[0], 65) == 0 {
        Clear(*account)
        return account, Incomplete
    }
    account.valid = true
    return account, ""
}

Load :: (database: string = "") -> OwnerAccount, string {
    empty: OwnerAccount
    path := database
    if path.count == 0 { path = DefaultDatabase() }
    if path.count == 0 { return empty, Unavailable }
    for byte: path { if byte == 0 { return empty, Unavailable } }
    db: *void
    // SQLITE_OPEN_READONLY: opening a missing path must not create a database.
    if SQL.SqliteOpenText(path, *db, 1) != SQL.SQLITE_OK {
        if db != null { unused SQL.SqliteClose(db) }
        return empty, Unavailable
    }
    defer { unused SQL.SqliteClose(db) }
    statement: *void
    query := "SELECT user_id,key,value FROM settings WHERE key IN ('sync_public_id','sync_public_key','sync_private_key')"
    if SQL.SqlitePrepareText(db, query, -1, *statement, null) != SQL.SQLITE_OK {
        return empty, Unavailable
    }
    defer { unused SQL.SqliteFinalize(statement) }
    // Stable nodes avoid leaving key material in a relocated vector buffer.
    users: Vec(UserEntry)
    defer {
        wipeIndex: s64 = 0
        while wipeIndex < users.count {
            Keys.SecureWipe(cast(*u8)users[wipeIndex].value, size_of(User))
            Release(cast(*void)users[wipeIndex].value)
            wipeIndex += 1
        }
    }
    while true {
        code := SQL.SqliteStep(statement)
        if code == SQL.SQLITE_DONE { break }
        if code != SQL.SQLITE_ROW { return empty, Unavailable }
        id := CopyColumn(statement, 0)
        kind := SQL.SqliteColumnType(statement, 0)
        found: s64 = -1
        lookupIndex: s64 = 0
        while lookupIndex < users.count {
            if users[lookupIndex].value.id == id && users[lookupIndex].value.kind == kind { found = lookupIndex; break }
            lookupIndex += 1
        }
        if found < 0 {
            found = users.count
            user := cast(*User)Allocate(1, cast(usize)size_of(User))
            if user == null { return empty, Unavailable }
            user.id = id
            user.kind = kind
            entry: UserEntry
            entry.value = user
            VecPush(users, entry)
        }
        key := CopyColumn(statement, 1)
        slot: s32 = -1
        if key == "sync_public_id" { slot = 0 }
        else if key == "sync_public_key" { slot = 1 }
        else if key == "sync_private_key" { slot = 2 }
        if slot >= 0 { ReadField(statement, *users[found].value.fields[slot]) }
    }
    selected: s64 = -1
    selectionIndex: s64 = 0
    while selectionIndex < users.count {
        user := users[selectionIndex].value
        if user.fields[0].present && user.fields[1].present && user.fields[2].present {
            if selected >= 0 { return empty, Unavailable }
            selected = selectionIndex
        }
        selectionIndex += 1
    }
    if selected < 0 { return empty, Unavailable }
    user := users[selected].value
    if !user.fields[0].hex || !user.fields[1].hex || !user.fields[2].hex {
        return empty, Incomplete
    }
    if user.fields[1].count % 2 != 0 { return empty, OddHexError(user.fields[1].count) }
    if user.fields[2].count % 2 != 0 { return empty, OddHexError(user.fields[2].count) }
    if user.fields[1].count != 2624 || user.fields[2].count != 5120 {
        return empty, Incomplete
    }
    public_key: [1312]u8
    private_key: [2560]u8
    defer { Keys.SecureWipe(*private_key[0], 2560) }
    if Crypto.HexToBytes(TextFromBytes(user.fields[1].bytes[0:2624]), *public_key[0], 1312) == 0 ||
        Crypto.HexToBytes(TextFromBytes(user.fields[2].bytes[0:5120]), *private_key[0], 2560) == 0 {
        return empty, Incomplete
    }
    account, error := FromKeys(public_key[:], private_key[:])
    if error.count > 0 { return account, error }
    if user.fields[0].count != 64 || TextFromBytes(user.fields[0].bytes[0:64]) != TextUntilNul(account.account_id[:]) {
        Clear(*account)
        return account, Mismatch
    }
    return account, ""
}
