Collage :: #import "collage";
using UI :: #import "kryon/Widgets";
using Model :: #import "model";
#import "std/date_parse"
#import "std/text"
Playback :: #import "playback";
Crop :: #import "crop";
Viewer :: #import "viewer";
Map :: #import "map";
TextDetection :: #import "text_detection";
QRDetection :: #import "qr_detection";
SelectionDrag :: #import "selection_drag";
HostWindow :: #import "kryon/Window";
#if #defined(POSIX_THREADS) {
    Clock :: #import "kryon/ClockLinux";
    Window :: #import "desktop";
    HostTheme :: #import "kryon/SystemThemeHostLinux";
    Record :: (id: s32, label: string, bounds: Rectangle, enabled: bool) {
        Window.Record(id, label, bounds.x, bounds.y, bounds.width, bounds.height, enabled)
    }
    Prepare :: () {
        Window.control_count = 0;
        PrepareTheme()
    }
    Publish :: () { Window.Publish() }
} else {
    Clock :: #import "kryon/Clock";
    Record :: (id: s32, label: string, bounds: Rectangle, enabled: bool) {}
    HostTheme :: #import "kryon/SystemThemeHost";
    Prepare :: () { PrepareTheme() }
    Publish :: () {}
}
Input :: #import "kryon/tree_input";
ScrollDevice :: #import "kryon/ScrollDevice";
#import "std/text_buffer"
PaletteStyle :: #import "kryon/SystemThemeHost";
SystemTheme :: #import "kryon/SystemTheme";
theme_ready: bool;
current_theme: SystemTheme.SystemPalette;
PrepareTheme :: () {
    if theme_ready && Model.ticks % 30 != 0 { return }
    fresh := HostTheme.SystemPaletteRead()
    if !theme_ready || fresh.background != current_theme.background || fresh.text != current_theme.text || fresh.selected != current_theme.selected || fresh.base != current_theme.base {
        unused PaletteStyle.SystemPaletteInstall(fresh); current_theme = fresh; theme_ready = true
    }
}
BackgroundColor :: () -> Color { return StyleTokenColor("canvas") }
// Date groups occupy full rows; only visible thumbnails become widgets.
item_y: Vec(float32);
item_column: Vec(s32);
group_start: Vec(bool);
layout_count: s32 = -1;
layout_cols: s32;
layout_height: float32;
layout_revision: s64;
LayoutFeed :: (cols: s32, height: float32) -> float32 {
    if layout_count == Model.count && layout_cols == cols && layout_height == height && layout_revision == Model.revision { return feed_height }
    VecClear(item_y); VecClear(item_column); VecClear(group_start)
    y: float32; column: s32
    for i: 0..Model.count - 1 {
        group := i == 0
        if i > 0 { group = TextUntilNul(Model.photos[i].date[:]) != TextUntilNul(Model.photos[i-1].date[:]) }
        if Model.view == "large" || Model.view == "similar" { group = false }
        if group { if column > 0 { y += height }; column = 0; y += 42.0 }
        unused VecPush(item_y, y); unused VecPush(item_column, column); unused VecPush(group_start, group)
        column += 1; if column >= cols { column = 0; y += height }
    }
    if column > 0 { y += height }
    feed_height = y; layout_count = Model.count; layout_cols = cols; layout_height = height; layout_revision = Model.revision
    return y
}
feed_height: float32;
swipe: SelectionDrag.State;
swipe_epoch: s64;
swipe_end: s32 = -1;
CancelSwipe :: () {
    SelectionDrag.Reset(*swipe)
    Model.ClearSwipeSelection(); swipe_end = -1
}
GalleryHit :: (px: float32, py: float32, body: Rectangle, cell: float32, nearest: bool) -> s32 {
    if Model.count == 0 || body.width <= 0.0 || body.height <= 0.0 ||
        px < body.x || px >= body.x+body.width { return -1 }
    if !nearest && (py < body.y || py >= body.y+body.height) { return -1 }
    if nearest {
        if py < body.y { py = body.y }
        if py >= body.y+body.height { py = body.y+body.height-1.0 }
    }
    local_y := py-body.y+cast(float32)Model.scroll
    first: s32; end := Model.count
    while first < end {
        middle := (first+end)/2
        if item_y[middle]+cell <= local_y { first = middle+1 } else { end = middle }
    }
    if first >= Model.count { return ifx nearest then Model.count-1 else -1 }
    row := item_y[first]; closest := first
    for i: first..Model.count-1 {
        if item_y[i] != row { break }
        bx := body.x+cast(float32)item_column[i]*(cell+12.0)
        if px >= bx && px < bx+cell {
            if nearest || local_y >= row { return i }; return -1
        }
        if px >= bx { closest = i }
    }
    return ifx nearest then closest else -1
}
SwipeSelection :: (session: Session, pointer: Input.PointerFrame, body: Rectangle, cell: float32) -> bool {
    eligible := Model.swipe_selection_enabled && Model.selecting && !Model.busy && !Model.CatalogView() && !Model.guest_active &&
        !Model.app_locked && Model.editor == "" && Model.selected < 0 && HostWindow.WindowFocused() &&
        (Model.view != "hidden" || Model.vault_unlocked)
    hit := GalleryHit(pointer.x,pointer.y,body,cell,swipe.active)
    selected := hit >= 0 && Model.IsPicked(TextUntilNul(Model.photos[hit].id[:]))
    decision := SelectionDrag.Update(*swipe,eligible,Model.picked_count,hit,selected,
        pointer.x,pointer.y,pointer.pressed,pointer.down,pointer.released,
        Clock.Milliseconds(),body.y,body.height,pointer.x >= body.x && pointer.x < body.x+body.width)
    if decision.began {
        swipe_epoch = Model.gallery_epoch; swipe_end = -1
        if !Model.SaveSwipeSelection() { CancelSwipe(); return false }
    }
    if decision.claimed {
        Input.TreePointerCancel(session); ScrollDevice.ScrollDeviceRelease()
        Model.scroll += decision.scroll
        maximum := cast(s32)(feed_height-body.height); if maximum < 0 { maximum = 0 }
        if Model.scroll < 0 { Model.scroll = 0 }; if Model.scroll > maximum { Model.scroll = maximum }
        hit = GalleryHit(pointer.x,pointer.y,body,cell,true)
        if hit >= 0 && hit != swipe_end && !decision.canceled {
            // Rebuild from the initial selection so reversing the gesture
            // restores items outside its current range, including older picks.
            if !Model.SwipeRange(swipe.anchor,hit,swipe.remove) { CancelSwipe(); return true }
            swipe_end = hit
        }
    }
    if decision.finished || decision.canceled { CancelSwipe() }
    return decision.claimed
}

Label :: (session: Session, key: u64, value: string, bounds: Rectangle, font: s32 = 15) {
    props: TextProps; props.key = key; props.text = value; props.bounds = bounds; props.font = font
    props.wrap = TextWrap.TextWrapNone; Text(session, props)
}
Action :: (session: Session, id: s32, label: string, bounds: Rectangle, enabled: bool = true) -> bool {
    Record(id, label, bounds, enabled && !Model.busy)
    props: ButtonProps; props.key = cast(u64)id; props.id = id; props.bounds = bounds; props.label = label; props.disabled = !enabled || Model.busy
    return Button(session, props) == 1
}
PhotoAction :: (session: Session, id: s32, name: string, bounds: Rectangle) -> bool {
    Record(id, name, bounds, !Model.busy)
    props: ButtonProps; props.key = cast(u64)id; props.id = id; props.bounds = bounds; props.disabled = Model.busy
    return Button(session, props) == 1
}
ImageAt :: (session: Session, key: u64, path: string, alt: string, bounds: Rectangle, cover: bool = false) {
    if path == "" { return }
    props: ImageProps; props.key = key; props.asset_path = path; props.alt_text = alt; props.bounds = bounds
    props.fit = ifx cover then ImageFit.ImageFitCover else ImageFit.ImageFitContain
    Image(session, props)
}
Field :: (session: Session, bounds: Rectangle, is_search: bool, key: s32, modifiers: s32, typed: string) -> bool {
    props: TextFieldProps; props.key = ifx is_search then 40 else 41; props.focus_id = ifx is_search then 40 else 41; props.bounds = bounds
    editing := !is_search && Model.editor != ""
    props.label = ifx is_search then "Search" else (ifx editing then Model.editor_title else "Import folder")
    props.placeholder = ifx is_search then "Search photos or combine type:, album:, tag:, year: filters" else (ifx editing then Model.editor_hint else "Path to a local folder")
    value: [8193]u8
    Model.Set(value[:], ifx is_search then TextUntilNul(Model.search[:]) else (ifx editing then TextUntilNul(Model.edit_value[:]) else TextUntilNul(Model.input[:])))
    props.value = TextUntilNul(value[:])
    mask: [1025]u8
    if editing && Model.Secret() {
        props.secure = true; chars: s32
        for i: 0..cast(s32)props.value.count - 1 { if (value[i] & 192) != 128 { mask[chars] = 42; chars += 1 } }
        props.display_value = TextUntilNul(mask[:])
    }
    props.cursor = ifx is_search then Model.search_cursor else Model.cursor; props.anchor = ifx is_search then Model.search_anchor else Model.anchor
    props.focused = ifx is_search then Model.search_focused else Model.focused; props.max_bytes = ifx is_search then 512 else (ifx editing then 8192 else 4096)
    if editing && Model.Secret() { props.max_bytes = 1024 }
    if props.focused { props.input = TextFieldInputFor(key, modifiers, typed) }
    result := TextField(session, props)
    Record(ifx is_search then 40 else 41, props.label, bounds, true)
    if is_search {
        Model.search_cursor = result.cursor; Model.search_anchor = result.anchor; Model.search_focused = result.focused
        if result.edit.changed { Model.Edit(Model.search[:], result.edit.start, result.edit.end, result.edit.replacement) }
    } else {
        Model.cursor = result.cursor; Model.anchor = result.anchor; Model.focused = result.focused
        if result.edit.changed {
            if editing { Model.Edit(Model.edit_value[:], result.edit.start, result.edit.end, result.edit.replacement) }
            else { Model.Edit(Model.input[:], result.edit.start, result.edit.end, result.edit.replacement) }
        }
    }
    return result.committed
}
SelectedAction :: (action: string) {
    Model.Apply(action)
}

BulkBounds :: (bounds: Rectangle, index: s32) -> Rectangle {
    cols: s32 = ifx bounds.width < 720.0 then 3 else 6
    step := (bounds.width - cast(float32)(cols - 1) * 8.0) / cast(float32)cols
    return .{bounds.x + cast(float32)(index % cols) * (step + 8.0), bounds.y + cast(float32)(index / cols) * 44.0, step, 36.0}
}
BulkBar :: (session: Session, bounds: Rectangle) {
    ready := Model.picked_count > 0 && !Model.loading
    if Action(session, 61, "Favorite", BulkBounds(bounds, 0), ready) { Model.Apply("favorite_set", "1") }
    if Action(session, 62, "Unfavorite", BulkBounds(bounds, 1), ready) { Model.Apply("favorite_set", "0") }
    if Action(session, 63, ifx Model.view == "hidden" then "Unhide" else "Hide", BulkBounds(bounds, 2), ready) { Model.Apply("hidden_set", ifx Model.view == "hidden" then "0" else "1") }
    if Action(session, 64, ifx Model.view == "trash" then "Restore" else "Trash", BulkBounds(bounds, 3), ready) { Model.Apply(ifx Model.view == "trash" then "restore" else "trash") }
    if Action(session, 65, "Add to album", BulkBounds(bounds, 4), ready) { Model.BeginEdit("album_add", "Add selection to album", "", "Enter an album name") }
    if Action(session, 66, "Edit date", BulkBounds(bounds, 5), ready) { Model.BeginEdit("taken", "Set date for selection", "", "2024-06-15 14:30:00+00:00 (UTC if no offset)") }
    if Action(session, 67, "Export selection", BulkBounds(bounds, 6), ready) { Model.BeginEdit("export", "Export selected originals", "", "Destination folder; empty uses Pictures/Photos Export") }
    if Action(session, 68, "Remove from album", BulkBounds(bounds, 7), ready && Model.album[0] != 0 && Model.album_filter[0] == 0) { Model.Apply("album_remove", TextUntilNul(Model.album[:])) }
    if Action(session, 69, ifx Model.view == "archive" then "Unarchive" else "Archive", BulkBounds(bounds, 8), ready) { Model.Apply("archived_set", ifx Model.view == "archive" then "0" else "1") }
    if Action(session, 214, "Edit location", BulkBounds(bounds, 9), ready) { Model.BeginEdit("location", "Set location for selection", "", "Latitude, longitude; leave empty to remove location") }
    if Action(session,519,"Tag person",BulkBounds(bounds,10),ready && Model.people_enabled && Model.view!="hidden" && Model.view!="trash") { Model.BeginEdit("person_tag","Tag person in selection","","One person's name; existing names reuse that person") }
    if Action(session,520,"Remove person tag",BulkBounds(bounds,11),ready && Model.people_enabled && Model.view!="hidden" && Model.view!="trash") { Model.BeginEdit("person_untag","Remove manual person tag","","One person's name; detected faces stay assigned") }
    if bounds.width < 620.0 && Model.picked_count >= 2 && Model.picked_count <= 6 {
        if Action(session,521,"Create collage",BulkBounds(bounds,12),Model.CollageReady()) { Model.BeginCollage() }
    }
}

CollageEditor :: (session: Session, body: Rectangle) {
    x := body.x; y := body.y; width := body.width; step := (width-24.0)/4.0
    Label(session,531,"Create collage",.{x,y,width,32.0},24)
    ready := Collage.active && (!Model.loading || (Model.collage_request && Model.collage_checking))
    layouts: [4]string = .{"Grid layout","Rows layout","Columns layout","Leading photo"}
    shapes: [3]string = .{"Square","Landscape","Portrait"}
    if Action(session,522,layouts[Collage.layout],.{x,y+42.0,step,36.0},ready) { Collage.layout = (Collage.layout+1)%4 }
    if Action(session,523,shapes[Collage.shape],.{x+step+8.0,y+42.0,step,36.0},ready) { Collage.shape = (Collage.shape+1)%3 }
    if Action(session,524,ifx Collage.swapping then "Cancel swapping" else "Swap photos",.{x+2.0*(step+8.0),y+42.0,step,36.0},ready) { Collage.SwapMode() }
    if Action(session,525,"Save copy",.{x+3.0*(step+8.0),y+42.0,step,36.0},ready) { Model.CollageRequest("collage_save") }
    if Action(session,526,"Previous photo",.{x,y+86.0,step,36.0},ready) { Collage.Choose(-1) }
    if Action(session,527,"Next photo",.{x+step+8.0,y+86.0,step,36.0},ready) { Collage.Choose(1) }
    if Action(session,528,"Zoom +",.{x+2.0*(step+8.0),y+86.0,step,36.0},ready) { Collage.Zoom(25) }
    if Action(session,529,"Zoom -",.{x+3.0*(step+8.0),y+86.0,step,36.0},ready) { Collage.Zoom(-25) }
    if Action(session,530,"Cancel",.{x,y+130.0,94.0,36.0}) { Model.CancelEditor(); return }
    if Action(session,532,"Reset frame",.{x+104.0,y+130.0,132.0,36.0},ready) { Collage.Reset() }
    Label(session,533,ifx Collage.swapping then "Tap two photos to swap their positions; tap the first again to cancel" else "Drag a photo to frame it; use the wheel or Zoom to magnify",.{x+248.0,y+132.0,width-248.0,32.0},13)
    canvas := Rectangle.{x,y+176.0,width,body.height-176.0}
    Collage.Draw(session,canvas,ready); Record(534,"Collage area",canvas,ready)
}

ImageEditor :: (session: Session, body: Rectangle) {
    x := body.x; y := body.y; width := body.width
    Label(session, 250, "Edit photo", .{x, y, width, 32.0}, 24)
    step := (width - 24.0) / 4.0
    ready := !Model.loading
    if Action(session, 364, "Custom crop", .{x + width - 150.0, y, 150.0, 36.0}, ready) { Model.BeginCrop(false) }
    if Action(session, 251, "Rotate right", .{x, y + 42.0, step, 36.0}, ready) { Model.ImageChange(0, 90) }
    if Action(session, 252, ifx Model.image_adjustments[1] == 0 then "Flip horizontal" else "Undo horizontal", .{x + step + 8.0, y + 42.0, step, 36.0}, ready) { Model.ImageChange(1, 1) }
    if Action(session, 253, ifx Model.image_adjustments[2] == 0 then "Flip vertical" else "Undo vertical", .{x + 2.0 * (step + 8.0), y + 42.0, step, 36.0}, ready) { Model.ImageChange(2, 1) }
    crop_labels: [5]string = .{"Crop: original", "Crop: square", "Crop: 4:3", "Crop: 16:9", "Crop: custom"}
    if Action(session, 254, crop_labels[Model.image_adjustments[6]], .{x + 3.0 * (step + 8.0), y + 42.0, step, 36.0}, ready) { Model.ImageChange(6, 1) }
    ImageAt(session, 5000000, TextUntilNul(Model.edit_preview[:]), "Preview of edited photo", .{x, y + 90.0, width, body.height - 288.0})
    captions: [3]string = .{"Brightness", "Contrast", "Saturation"}
    unit := (width - 24.0) / 3.0
    for i: 0..2 {
        bx := x + cast(float32)i * (unit + 12.0); by := y + body.height - 184.0
        caption: Vec(u8); BuilderPrint(*caption, "% · % / 100", captions[i], Model.image_adjustments[i + 3]); value := BuilderFinish(caption)
        Label(session, cast(u64)(260 + i), value, .{bx, by, unit, 24.0}, 15); Model.Release(value)
        if Action(session, cast(s32)(270 + i * 2), "-", .{bx, by + 30.0, (unit - 8.0) / 2.0, 36.0}, ready && Model.image_adjustments[i + 3] > 0) { Model.ImageChange(cast(s32)i + 3, -10) }
        if Action(session, cast(s32)(271 + i * 2), "+", .{bx + (unit + 8.0) / 2.0, by + 30.0, (unit - 8.0) / 2.0, 36.0}, ready && Model.image_adjustments[i + 3] < 200) { Model.ImageChange(cast(s32)i + 3, 10) }
    }
    Label(session, 280, "Save a separate PNG copy; your original stays intact.", .{x, y + body.height - 94.0, width, 24.0}, 14)
    if Action(session, 281, "Reset", .{x, y + body.height - 56.0, unit, 38.0}, ready) { Model.ImageReset() }
    if Action(session, 282, "Save copy", .{x + unit + 12.0, y + body.height - 56.0, unit, 38.0}, ready && Model.ImageChanged()) { Model.ImageRequest("image_save") }
    if Action(session, 283, "Cancel", .{x + 2.0 * (unit + 12.0), y + body.height - 56.0, unit, 38.0}, ready) { Model.Apply("image_close") }
}

VideoEditor :: (session: Session, body: Rectangle) {
    x := body.x; y := body.y; width := body.width; unit := (width - 24.0) / 3.0
    ready := !Model.loading && Model.video_duration > 0 && Model.video_job[0] == 0
    Label(session, 331, "Edit video", .{x, y, width, 32.0}, 24)
    if Action(session, 332, "Trim", .{x, y + 42.0, unit, 36.0}, ready) { Model.VideoTrim() }
    if Action(session, 333, "Rotate right", .{x + unit + 12.0, y + 42.0, unit, 36.0}, ready) { Model.VideoChange(2) }
    if Action(session, 365, "Custom crop", .{x + width - 150.0, y, 150.0, 36.0}, ready) { Model.BeginCrop(true) }
    crops: [7]string = .{"Crop: original", "Crop: square", "Crop: 4:3", "Crop: 16:9", "Crop: 9:16", "Crop: 3:4", "Crop: custom"}
    if Action(session, 334, crops[Model.video_adjustments[3]], .{x + 2.0 * (unit + 12.0), y + 42.0, unit, 36.0}, ready) { Model.VideoChange(3) }
    ImageAt(session, 5100000, TextUntilNul(Model.edit_preview[:]), "Edited video frame at trim start", .{x, y + 90.0, width, body.height - 254.0})
    text: Vec(u8); BuilderPrint(*text, "% to % seconds · % seconds · rotation % degrees", cast(float64)Model.video_adjustments[0]/1000.0, cast(float64)Model.video_adjustments[1]/1000.0, cast(float64)(Model.video_adjustments[1]-Model.video_adjustments[0])/1000.0, Model.video_adjustments[2])
    value := BuilderFinish(text); Label(session, 335, value, .{x, y + body.height - 152.0, width, 26.0}, 14); Model.Release(value)
    Label(session, 336, "Frame preview at trim start; use Custom crop to choose an area.", .{x, y + body.height - 118.0, width, 26.0}, 14)
    Label(session, 337, "Save a separate MP4 copy with audio; your original stays intact.", .{x, y + body.height - 86.0, width, 26.0}, 14)
    if Action(session, 338, "Reset", .{x, y + body.height - 48.0, unit, 38.0}, ready) { Model.video_adjustments = .{0, Model.video_duration, 0, 0}; Model.video_crop = .{0, 0, 10000, 10000}; Model.VideoRequest() }
    if Action(session, 339, "Save copy", .{x + unit + 12.0, y + body.height - 48.0, unit, 38.0}, ready && Model.VideoChanged()) { Model.VideoRequest("video_save") }
    if Action(session, 340, "Cancel", .{x + 2.0 * (unit + 12.0), y + body.height - 48.0, unit, 38.0}, !Model.loading) {
        if Model.video_job[0] != 0 { Model.Apply("video_cancel") } else { Model.Apply("image_close") }
    }
}

CropShade :: (session: Session, key: u64, bounds: Rectangle) {
    if bounds.width <= 0.0 || bounds.height <= 0.0 { return }
    box: BoxProps; box.key = key; box.bounds = bounds; box.fill = Color.{0, 0, 0, 150}; Box(session, box)
}
CropEditor :: (session: Session, body: Rectangle) {
    x := body.x; y := body.y; width := body.width
    Label(session, 366, "Custom crop", .{x, y, width, 34.0}, 24)
    Label(session, 367, "Drag across the preview to choose the area to keep.", .{x, y + 44.0, width, 30.0}, 15)
    canvas := Rectangle.{x, y + 90.0, width, body.height - 164.0}
    if Model.edit_width > 0 && Model.edit_height > 0 && canvas.height > 0.0 {
        scale := canvas.width / cast(float32)Model.edit_width
        if canvas.height / cast(float32)Model.edit_height < scale { scale = canvas.height / cast(float32)Model.edit_height }
        shown := Rectangle.{canvas.x + (canvas.width - cast(float32)Model.edit_width * scale) / 2.0,
            canvas.y + (canvas.height - cast(float32)Model.edit_height * scale) / 2.0,
            cast(float32)Model.edit_width * scale, cast(float32)Model.edit_height * scale}
        ImageAt(session, 5200000, TextUntilNul(Model.edit_preview[:]), "Choose a custom crop", shown)
        pointer := Input.PointerSample(session)
        if !Model.loading {
            px := Crop.CropCoordinate(pointer.x, shown.x, shown.width); py := Crop.CropCoordinate(pointer.y, shown.y, shown.height)
            if pointer.pressed && Input.PointInBounds(pointer.x, pointer.y, shown) {
                Model.crop_dragging = true; Model.crop_anchor_x = px; Model.crop_anchor_y = py
            }
            if Model.crop_dragging && (pointer.down || pointer.released) {
                left := ifx px < Model.crop_anchor_x then px else Model.crop_anchor_x
                top := ifx py < Model.crop_anchor_y then py else Model.crop_anchor_y
                cw := px - Model.crop_anchor_x; ch := py - Model.crop_anchor_y
                if cw < 0 { cw = -cw }; if ch < 0 { ch = -ch }
                if cw > 0 && ch > 0 { Model.crop_candidate = .{left, top, cw, ch} }
            }
            if pointer.released || !pointer.down { Model.crop_dragging = false }
        }
        left := shown.x + shown.width * cast(float32)Model.crop_candidate[0] / 10000.0
        top := shown.y + shown.height * cast(float32)Model.crop_candidate[1] / 10000.0
        cw := shown.width * cast(float32)Model.crop_candidate[2] / 10000.0
        ch := shown.height * cast(float32)Model.crop_candidate[3] / 10000.0
        CropShade(session, 368, .{shown.x, shown.y, shown.width, top - shown.y})
        CropShade(session, 369, .{shown.x, top + ch, shown.width, shown.y + shown.height - top - ch})
        CropShade(session, 370, .{shown.x, top, left - shown.x, ch})
        CropShade(session, 371, .{left + cw, top, shown.x + shown.width - left - cw, ch})
        border: BoxProps; border.key = 372; border.bounds = .{left, top, cw, ch}; border.border = Color.{255, 255, 255, 255}; Box(session, border)
        Record(373, "Crop area", shown, !Model.loading)
    }
    step := (width - 24.0) / 3.0; by := y + body.height - 56.0
    if Action(session, 374, "Use crop", .{x, by, step, 38.0}, !Model.loading && Crop.CropValid(Model.crop_candidate[:])) { Model.FinishCrop(true) }
    if Action(session, 375, "Full image", .{x + step + 12.0, by, step, 38.0}, !Model.loading) { Model.crop_candidate = .{0, 0, 10000, 10000} }
    if Action(session, 376, "Cancel", .{x + 2.0 * (step + 12.0), by, step, 38.0}, !Model.loading) { Model.FinishCrop(false) }
}

PlaybackTime :: (value: s64) -> string {
    seconds := value / 1000; out: Vec(u8); BuilderPrint(*out, "%:", seconds / 60)
    if seconds % 60 < 10 { BuilderPrint(*out, "0") }; BuilderPrint(*out, "%", seconds % 60); return BuilderFinish(out)
}
ViewerControls :: (session: Session, image: string, bounds: Rectangle, canvas: Rectangle, ready: bool) {
    step := (bounds.width - 32.0) / 5.0
    if Action(session, 380, "Zoom +", .{bounds.x, bounds.y, step, 36.0}, ready) { Viewer.ChangeZoom(1.5) }
    if Action(session, 381, "Zoom -", .{bounds.x + step + 8.0, bounds.y, step, 36.0}, ready) { Viewer.ChangeZoom(1.0 / 1.5) }
    if Action(session, 382, "Fit", .{bounds.x + 2.0 * (step + 8.0), bounds.y, step, 36.0}, ready) { Viewer.Fit() }
    photo := *Model.photos[Model.selected]
    pixel_label := ifx Viewer.OriginalResolution(image, photo.width, photo.height) then "1:1" else "Preview 1:1"
    if Action(session, 383, pixel_label, .{bounds.x + 3.0 * (step + 8.0), bounds.y, step, 36.0}, ready) { Viewer.PixelSize(image, canvas) }
    if Action(session, 384, ifx Viewer.expanded then "Return" else "Expand", .{bounds.x + 4.0 * (step + 8.0), bounds.y, step, 36.0}, ready) { Viewer.expanded = !Viewer.expanded; Viewer.dragging = false }
}
OfflineMap :: (session: Session, body: Rectangle) {
    ready := !Model.loading
    if Action(session, 410, "Zoom +", .{body.x, body.y, 96.0, 36.0}, ready && Map.level < 18) { Map.Zoom(true); Model.RefreshMap() }
    if Action(session, 411, "Zoom -", .{body.x + 106.0, body.y, 96.0, 36.0}, ready && Map.level > 0) { Map.Zoom(false); Model.RefreshMap() }
    if Action(session, 412, "World", .{body.x + 212.0, body.y, 82.0, 36.0}, ready) { Map.Reset(); Model.RefreshMap() }
    if Action(session, 413, "View photos", .{body.x + 304.0, body.y, 132.0, 36.0}, ready && Model.matches > 0) { Model.MapGallery() }
    text: Vec(u8); BuilderPrint(*text, "% located photos · %", Model.matches, ifx Model.album[0] == 0 then "Library" else TextUntilNul(Model.album[:]))
    value := BuilderFinish(text); Label(session, 414, value, .{body.x, body.y + 44.0, body.width, 26.0}, 14); Model.Release(value)
    body.y += 78.0; body.height -= 108.0
    picture := Map.Picture(body)
    changed := Map.Draw(session, picture, ready)
    if changed { Model.RefreshMap() }
    for i: 0..Map.count - 1 {
        point := Map.MarkerPoint(i, picture)
        if point.x < picture.x || point.x > picture.x + picture.width || point.y < picture.y || point.y > picture.y + picture.height { continue }
        bx := point.x - 22.0; by := point.y - 16.0
        if bx < picture.x { bx = picture.x }; if bx > picture.x + picture.width - 44.0 { bx = picture.x + picture.width - 44.0 }
        if by < picture.y { by = picture.y }; if by > picture.y + picture.height - 32.0 { by = picture.y + picture.height - 32.0 }
        text: Vec(u8); BuilderPrint(*text, "%", Map.MarkerCount(i)); label := BuilderFinish(text)
        clicked := Action(session, 6300000 + i, label, .{bx, by, 44.0, 32.0}, !Model.loading && !changed && !Map.dragged)
        Model.Release(label)
        if clicked { Model.MapGallery(i); break }
    }
    Label(session, 415, "Offline map · wheel to zoom, drag to pan, choose a marker to browse", .{body.x, body.y + body.height + 8.0, body.width, 26.0}, 13)
}
ExpandedPhoto :: (session: Session, bounds: Rectangle) {
    photo := *Model.photos[Model.selected]
    image := ifx photo.display[0] != 0 then TextUntilNul(photo.display[:]) else TextUntilNul(photo.thumbnail[:])
    x := bounds.x; y := bounds.y; width := bounds.width
    if Action(session, 385, "Back", .{x, y, 82.0, 36.0}) { Viewer.expanded = false }
    if Action(session, 386, "Previous", .{x + 92.0, y, 96.0, 36.0}, Model.selected > 0) { Model.Choose(Model.selected - 1) }
    if Action(session, 387, "Next", .{x + 198.0, y, 82.0, 36.0}, Model.selected + 1 < Model.count) { Model.Choose(Model.selected + 1) }
    Label(session, 388, TextUntilNul(photo.name[:]), .{x + 294.0, y + 2.0, width - 294.0, 32.0}, 17)
    picture := Rectangle.{x, y + 48.0, width, bounds.height - 102.0}
    Viewer.Draw(session, 5300000, image, TextUntilNul(photo.name[:]), picture)
    ViewerControls(session, image, .{x, y + bounds.height - 42.0, width, 36.0}, picture, !Model.loading)
}
Slideshow :: (session: Session, bounds: Rectangle) {
    black: BoxProps; black.key = 490; black.bounds = bounds; black.fill = .{0,0,0,255}; Box(session,black)
    if Model.slide_blur { ImageAt(session,491,TextUntilNul(Model.slide_background[:]),"Blurred photo background",bounds,true) }
    picture := bounds
    if Model.slide_controls { picture.y += 56.0; picture.height -= 166.0 }
    ImageAt(session,492,TextUntilNul(Model.slide_path[:]),TextUntilNul(Model.slide_name[:]),picture)
    pointer := Input.PointerSample(session)
    if pointer.released && Input.PointInBounds(pointer.x,pointer.y,picture) {
        fraction := (pointer.x-picture.x)/picture.width
        if fraction < 0.25 { Model.MoveSlide(-1) }
        else if fraction > 0.75 { Model.MoveSlide(1) }
        else { Model.slide_controls = !Model.slide_controls }
    }
    if !Model.slide_controls { return }
    panel: BoxProps; panel.key = 493; panel.fill = BackgroundColor(); panel.bounds = .{bounds.x,bounds.y,bounds.width,52.0}; Box(session,panel)
    text: Vec(u8); BuilderPrint(*text,"% · % / %",ifx Model.slide_path[0] == 0 then "Opening photo…" else TextUntilNul(Model.slide_caption[:]),Model.slide_offset+1,Model.slide_count)
    label := BuilderFinish(text); Label(session,494,label,.{bounds.x+12.0,bounds.y+10.0,bounds.width-24.0,30.0},18); Model.Release(label)
    panel.key = 495; panel.bounds = .{bounds.x,bounds.y+bounds.height-106.0,bounds.width,106.0}; Box(session,panel)
    step := (bounds.width-48.0)/4.0; x := bounds.x+12.0; y := panel.bounds.y+10.0
    ready := Model.SlideReady() && Model.slide_id[0] != 0
    if Action(session,496,"Stop slideshow",.{x,y,step,36.0}) { Model.StopSlides(); return }
    if Action(session,497,"Previous photo",.{x+step+8.0,y,step,36.0},ready) { Model.MoveSlide(-1) }
    if Action(session,498,ifx Model.slide_paused then "Resume slideshow" else "Pause slideshow",.{x+2.0*(step+8.0),y,step,36.0}) { Model.PauseSlides() }
    if Action(session,499,"Next photo",.{x+3.0*(step+8.0),y,step,36.0},ready) { Model.MoveSlide(1) }
    timing: [7]string = .{"5 seconds","10 seconds","15 seconds","30 seconds","1 minute","5 minutes","10 minutes"}
    y += 48.0
    if Action(session,500,timing[Model.slide_interval],.{x,y,step,36.0}) { Model.SlideInterval() }
    if Action(session,501,ifx Model.slide_shuffle then "Shuffle" else "In order",.{x+step+8.0,y,step,36.0},Model.SlideReady()) { Model.SlideOrder() }
    if Action(session,502,ifx Model.slide_blur then "Blurred background" else "Black background",.{x+2.0*(step+8.0),y,step,36.0},Model.SlideReady()) { Model.SlideBackground() }
    if Action(session,503,"Hide controls",.{x+3.0*(step+8.0),y,step,36.0}) { Model.slide_controls = false }
}
PlaybackViewer :: (session: Session, body: Rectangle) {
    x := body.x; y := body.y; width := body.width
    state := Playback.State(); ready := Model.playback_started && state >= 2
    if Action(session, 351, "Back", .{x, y, 86.0, 36.0}) { Model.StopPlayback(); return }
    if Action(session, 352, ifx Model.playback_expanded then "Fit in Photos" else "Expand", .{x + width - 150.0, y, 150.0, 36.0}) { Model.playback_expanded = !Model.playback_expanded }
    image := Playback.Frame()
    if image != "" { ImageAt(session, 3500, image, "Playing video", .{x, y + 48.0, width, body.height - 238.0}) }
    else { Label(session, 353, ifx Model.playback_started then "Opening video…" else "Checking video access…", .{x + 12.0, y + 64.0, width - 24.0, 36.0}, 18) }
    position := Playback.Position(); duration := Playback.Duration()
    value := PlaybackTime(position); total_time := PlaybackTime(duration)
    text: Vec(u8); BuilderPrint(*text, "% / %", value, total_time)
    time_text := BuilderFinish(text)
    slider: SliderProps; slider.key = 354; slider.id = 354; slider.semantic_label = "Position"
    slider.bounds = .{x, y + body.height - 180.0, width, 48.0}; slider.value = cast(float32)position / 1000.0; slider.min = 0.0; slider.max = cast(float32)duration / 1000.0; slider.disabled = !ready || duration <= 0
    result := Slider(session, slider); if result.changed { Model.PlaybackSeek(cast(s64)(result.value * 1000.0)) }
    Label(session, 361, "Position", .{x + 4.0, slider.bounds.y, width - 180.0, 24.0}, 14)
    Label(session, 362, time_text, .{x + width - 174.0, slider.bounds.y, 174.0, 24.0}, 14)
    Record(354, "Position", slider.bounds, !slider.disabled)
    Model.Release(value); Model.Release(total_time); Model.Release(time_text)
    step := (width - 24.0) / 4.0; by := y + body.height - 120.0
    if Action(session, 355, ifx state == 3 then "Resume" else (ifx state == 4 then "Replay" else "Pause"), .{x, by, step, 36.0}, ready) { Playback.Pause() }
    if Action(session, 356, "Back 5s", .{x + step + 8.0, by, step, 36.0}, ready) { Model.PlaybackSeek(position - 5000) }
    if Action(session, 357, "Forward 5s", .{x + 2.0 * (step + 8.0), by, step, 36.0}, ready) { Model.PlaybackSeek(position + 5000) }
    speed_label := ifx Model.playback_speed == 25 then "Speed 0.25x" else (ifx Model.playback_speed == 50 then "Speed 0.5x" else (ifx Model.playback_speed == 100 then "Speed 1x" else (ifx Model.playback_speed == 150 then "Speed 1.5x" else "Speed 2x")))
    if Action(session, 358, speed_label, .{x + 3.0 * (step + 8.0), by, step, 36.0}, ready) { Model.PlaybackSpeed() }
    if Action(session, 359, ifx Model.playback_volume == 0 then "Unmute" else "Mute", .{x, by + 48.0, step, 36.0}, ready) { Model.playback_volume = ifx Model.playback_volume == 0 then 100 else 0; Playback.Volume(Model.playback_volume) }
    volume: SliderProps; volume.key = 360; volume.id = 360; volume.semantic_label = "Volume"; volume.bounds = .{x + step + 8.0, by + 44.0, width - step - 8.0, 48.0}; volume.value = cast(float32)Model.playback_volume; volume.max = 100.0; volume.disabled = !ready
    changed := Slider(session, volume); if changed.changed { Model.playback_volume = cast(s32)changed.value / 10 * 10; Playback.Volume(Model.playback_volume) }
    Label(session, 363, "Volume", .{volume.bounds.x + 4.0, volume.bounds.y, volume.bounds.width - 8.0, 24.0}, 14)
    Record(360, "Volume", volume.bounds, ready)
}

GuestView :: (session: Session, viewport: Rectangle, key: s32, modifiers: s32, typed: string) {
    x := viewport.x+16.0; y := viewport.y+12.0; width := viewport.width-32.0
    Label(session,600,"Guest view",.{x,y,width-160.0,36.0},26)
    if Action(session,601,"Leave Guest view",.{x+width-156.0,y,156.0,36.0}) {
        Model.BeginGuestExit()
    }
    body := Rectangle.{x,y+52.0,width,viewport.height-112.0}
    if Model.editor == "guest_exit" {
        if key == Input.KeyEscape { Model.CancelGuestExit(); return }
        Label(session,602,"Authenticate to return to your library",.{body.x,body.y,body.width,36.0},22)
        committed := Field(session,.{body.x,body.y+54.0,body.width,44.0},false,key,modifiers,typed)
        Label(session,603,"The rest of your photos stays locked until you authenticate.",.{body.x,body.y+114.0,body.width,28.0},14)
        if Action(session,604,"Authenticate",.{body.x,body.y+160.0,148.0,38.0},!Model.loading) || (committed && !Model.loading) { Model.SaveEditor() }
        if Action(session,605,"Cancel",.{body.x+160.0,body.y+160.0,104.0,38.0},!Model.loading) { Model.CancelGuestExit() }
    } else if Model.editor == "playback" {
        if key == Input.KeyEscape { Model.StopPlayback(); return }
        if key == 32 && Model.playback_started { Playback.Pause() }
        if key == Input.KeyLeft { Model.PlaybackSeek(Playback.Position()-5000) }
        if key == Input.KeyRight { Model.PlaybackSeek(Playback.Position()+5000) }
        PlaybackViewer(session,body)
    } else if Model.selected >= 0 && Model.selected < Model.count {
        if key == Input.KeyEscape { Model.selected = -1; Viewer.Reset(); return }
        if key == Input.KeyLeft { Model.Choose(Model.selected-1) }
        if key == Input.KeyRight { Model.Choose(Model.selected+1) }
        if Action(session,50,"Back",.{x,body.y,86.0,36.0}) { Model.selected = -1; Viewer.Reset(); return }
        if Action(session,51,"Previous",.{x+96.0,body.y,100.0,36.0},!Model.loading && Model.selected>0) { Model.Choose(Model.selected-1) }
        if Action(session,52,"Next",.{x+206.0,body.y,86.0,36.0},!Model.loading && Model.selected+1<Model.count) { Model.Choose(Model.selected+1) }
        photo := *Model.photos[Model.selected]
        ready := !Model.loading && TextUntilNul(Model.detail_id[:]) == TextUntilNul(photo.id[:])
        image := ifx photo.display[0] != 0 && TextUntilNul(photo.kind[:]) == "photo" then TextUntilNul(photo.display[:]) else TextUntilNul(photo.thumbnail[:])
        picture := Rectangle.{x,body.y+48.0,width,body.height-104.0}
        if TextUntilNul(photo.kind[:]) == "photo" {
            Viewer.Draw(session,3000,image,TextUntilNul(photo.name[:]),picture)
            ViewerControls(session,image,.{x,body.y+body.height-44.0,width,36.0},picture,ready)
        } else { ImageAt(session,3000,image,TextUntilNul(photo.name[:]),picture) }
        if TextUntilNul(photo.kind[:]) == "video" || photo.live {
            if Action(session,350,ifx photo.live then "Play Live Photo" else "Play video",.{x+width-156.0,body.y,156.0,36.0},ready) { Model.BeginPlayback() }
        }
        Label(session,606,TextUntilNul(photo.name[:]),.{x,body.y+body.height-76.0,width,24.0},15)
    } else {
        if Action(session,607,"Previous page",.{x,body.y,140.0,36.0},!Model.loading && Model.offset>0) { Model.GuestPage(-1) }
        if Action(session,608,"Next page",.{x+150.0,body.y,140.0,36.0},!Model.loading && Model.offset+60<Model.matches) { Model.GuestPage(1) }
        info: Vec(u8); BuilderPrint(*info,"% photos & videos in this view",Model.matches)
        text := BuilderFinish(info); Label(session,609,text,.{x+306.0,body.y+6.0,width-306.0,28.0},14); Model.Release(text)
        body.y += 48.0; body.height -= 48.0
        cols := cast(s32)(width/210.0); if cols<1 { cols=1 }; if cols>6 { cols=6 }
        cell := (width-cast(float32)(cols-1)*12.0)/cast(float32)cols
        rows := (Model.count+cols-1)/cols
        props: ScrollProps; props.key = 610; props.bounds = body; props.content_height = cast(s32)(cast(float32)rows*(cell+44.0)); props.scroll_offset = Model.scroll
        scrolling := Scroll(session,props); Model.scroll = scrolling.scroll_offset
        for i: 0..Model.count-1 {
            bx := x+cast(float32)(i%cols)*(cell+12.0); by := body.y+cast(float32)(i/cols)*(cell+44.0)-cast(float32)Model.scroll
            if by+cell+32.0<body.y || by>body.y+body.height { continue }
            photo := *Model.photos[i]
            if Action(session,100+i,"Open photo",.{bx,by,cell,cell},!Model.loading) { Model.Choose(i) }
            ImageAt(session,cast(u64)(3000+i),TextUntilNul(photo.thumbnail[:]),TextUntilNul(photo.name[:]),.{bx+3.0,by+3.0,cell-6.0,cell-6.0},true)
            Label(session,cast(u64)(4000+i),TextUntilNul(photo.date[:]),.{bx,by+cell+4.0,cell,24.0},13)
        }
        if scrolling.opened { unused End(session) }
    }
    Label(session,611,TextUntilNul(Model.message[:]),.{x,viewport.y+viewport.height-38.0,width,28.0},13)
}

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    Prepare(); defer { Publish() }
    Model.Tick(HostWindow.WindowFocused())
    if (swipe.pending || swipe.active) && (!Model.swipe_selection_enabled || !Model.selecting || Model.busy || Model.guest_active ||
        Model.app_locked || Model.editor != "" || Model.selected >= 0 || Model.CatalogView() ||
        Model.gallery_epoch != swipe_epoch || !HostWindow.WindowFocused() ||
        (Model.view == "hidden" && !Model.vault_unlocked)) {
        Input.TreePointerCancel(session); CancelSwipe()
    }
    background: BoxProps; background.key = 1; background.bounds = viewport; background.fill = BackgroundColor(); Box(session, background)
    key := KeyboardTake(session); modifiers := KeyboardModifiers(session); typed_bytes: [256]u8; typed := TypedTextTake(session, typed_bytes[:])
    if Model.guest_active { GuestView(session,viewport,key,modifiers,typed); return 0 }
    if Model.RecoveryResetEditor() {
        x := viewport.x+24.0; y := viewport.y+32.0; width := viewport.width-48.0
        Label(session,655,Model.editor_title,.{x,y,width,40.0},28)
        Label(session,656,Model.editor_hint,.{x,y+54.0,width,52.0},16)
        committed := Field(session,.{x,y+114.0,width,44.0},false,key,modifiers,typed)
        if Action(session,657,ifx Model.editor == "recovery_reset_confirm" then "Recover password" else "Continue",.{x,y+182.0,180.0,40.0},Model.AppLockReady()) || (committed && Model.AppLockReady()) { Model.SaveEditor() }
        if Action(session,658,"Cancel",.{x+196.0,y+182.0,140.0,40.0},Model.AppLockReady()) || key == Input.KeyEscape { Model.CancelRecoveryReset() }
        Label(session,659,TextUntilNul(Model.message[:]),.{x,y+238.0,width,80.0},15)
        return 0
    }
    if Model.app_locked {
        x := viewport.x+24.0; y := viewport.y+32.0; width := viewport.width-48.0
        Label(session,620,"Photos is locked",.{x,y,width,40.0},28)
        Label(session,621,Model.AppLockHint(),.{x,y+54.0,width,28.0},16)
        committed := Field(session,.{x,y+104.0,width,44.0},false,key,modifiers,typed)
        if Action(session,622,"Unlock Photos",.{x,y+174.0,168.0,40.0},!Model.loading) || (committed && !Model.loading) { Model.SaveEditor() }
        Label(session,623,TextUntilNul(Model.message[:]),.{x,y+234.0,width,56.0},15)
        if Action(session,660,"Recover app password",.{x,y+308.0,216.0,40.0},!Model.loading) { Model.BeginRecoveryReset(1) }
        if Action(session,661,"Recover Hidden password",.{x+232.0,y+308.0,236.0,40.0},!Model.loading) { Model.BeginRecoveryReset(2) }
        return 0
    }
    if StartsWithFoldASCII(Model.editor,"app_lock_") {
        x := viewport.x+24.0; y := viewport.y+24.0; width := viewport.width-48.0
        Label(session,624,"App lock",.{x,y,width-120.0,40.0},28)
        if Action(session,625,"Back",.{x+width-110.0,y,110.0,36.0}) || key == Input.KeyEscape { Model.CancelEditor(); return 0 }
        Label(session,626,"Protect opening Photos with an app PIN, app password or your Hidden password. Hidden stays separately locked.",.{x,y+58.0,width,52.0},16)
        if Model.editor != "app_lock_settings" {
            committed := Field(session,.{x,y+126.0,width,44.0},false,key,modifiers,typed)
            if Action(session,627,Model.AppLockSubmit(),.{x,y+192.0,180.0,40.0},Model.AppLockReady()) || (committed && Model.AppLockReady()) { Model.SaveEditor() }
        } else if !Model.app_lock_enabled && !Model.vault_configured {
            Label(session,628,"Create your local password in Hidden first.",.{x,y+126.0,width,32.0},18)
            if Action(session,629,"Open Hidden",.{x,y+178.0,168.0,40.0}) { Model.CancelEditor(); Model.Navigate("hidden") }
        } else if Model.app_lock_enabled {
            Label(session,628,ifx Model.app_lock_method == 1 then "App lock uses your app PIN" else (ifx Model.app_lock_method == 2 then "App lock uses your app password" else "App lock uses your Hidden password"),.{x,y+126.0,width,32.0},18)
            if Action(session,630,"Lock now",.{x,y+178.0,148.0,40.0},Model.AppLockReady()) { Model.LockApp() }
            if Action(session,631,"Turn off app lock",.{x+164.0,y+178.0,180.0,40.0},Model.AppLockReady()) { Model.BeginEdit("app_lock_disable","Disable app lock","",Model.AppLockHint()) }
        } else {
            Label(session,628,"App lock is disabled",.{x,y+126.0,width,32.0},18)
            if Action(session,632,"Turn on app lock",.{x,y+178.0,180.0,40.0},!Model.loading) { Model.BeginEdit("app_lock_enable","Enable app lock","","Your local Hidden password") }
        }
        if Model.editor == "app_lock_settings" {
            if Action(session,635,ifx Model.app_lock_enabled then "Change app PIN" else "Set app PIN",.{x,y+234.0,168.0,40.0},Model.AppLockReady()) { Model.BeginEdit("app_lock_pin","Set app PIN","","4 through 12 digits; separate from Hidden") }
            if Action(session,636,ifx Model.app_lock_enabled then "Change app password" else "Set app password",.{x+184.0,y+234.0,204.0,40.0},Model.AppLockReady()) { Model.BeginEdit("app_lock_password","Set app password","","At least 8 characters; separate from Hidden") }
            if Model.app_lock_enabled {
                Label(session,637,"Lock after leaving Photos",.{x,y+290.0,width,28.0},18)
                Label(session,638,Model.AppLockDelayLabel(),.{x,y+318.0,width,24.0},15)
                choices: [6]string = .{"Immediately","5 seconds","15 seconds","1 minute","5 minutes","30 minutes"}
                seconds: [6]s32 = .{0,5,15,60,300,1800}
                step := (width-16.0)/3.0
                for i: 0..5 {
                    bounds: Rectangle = .{x+cast(float32)(i%3)*(step+8.0),y+354.0+cast(float32)(i/3)*48.0,step,40.0}
                    if Action(session,639+cast(s32)i,choices[i],bounds,Model.AppLockReady()) { Model.AppLockDelay(seconds[i]) }
                }
            }
        }
        Label(session,633,TextUntilNul(Model.message[:]),.{x,y+(ifx Model.editor == "app_lock_settings" && Model.app_lock_enabled then 458.0 else 300.0),width,56.0},15)
        return 0
    }
    if Model.slide_active {
        if key == Input.KeyEscape { Model.StopSlides(); return 0 }
        if key == 32 { Model.PauseSlides() }
        if key == Input.KeyLeft { Model.MoveSlide(-1) }
        if key == Input.KeyRight { Model.MoveSlide(1) }
        Slideshow(session,viewport); return 0
    }
    if Model.editor == "playback" {
        if key == Input.KeyEscape { if Model.playback_expanded { Model.playback_expanded = false } else { Model.StopPlayback() }; key = 0 }
        if key == 32 && Model.playback_started { Playback.Pause() }
        if key == Input.KeyLeft { Model.PlaybackSeek(Playback.Position() - 5000) }
        if key == Input.KeyRight { Model.PlaybackSeek(Playback.Position() + 5000) }
        if Model.playback_expanded { PlaybackViewer(session, .{viewport.x + 12.0, viewport.y + 12.0, viewport.width - 24.0, viewport.height - 24.0}); return 0 }
    }
    if (Model.editor == "text" || Model.editor == "qr") && key == Input.KeyEscape { Model.CancelEditor(); key = 0 }
    if Model.editor == "collage" && key == Input.KeyEscape { Model.CancelEditor(); key = 0 }
    if (Model.editor == "image_crop" || Model.editor == "video_crop") && key == Input.KeyEscape { Model.FinishCrop(false) }
    if !Model.focused && !Model.search_focused && Model.editor == "" {
        if key == Input.KeyEscape { if Viewer.expanded { Viewer.expanded = false } else if Model.selected >= 0 { Model.selected = -1; Viewer.Reset() } else { Model.ClearSelection() } }
        if Model.selected >= 0 && !Model.loading {
            if key == Input.KeyLeft { Model.Choose(Model.selected - 1) }
            if key == Input.KeyRight { Model.Choose(Model.selected + 1) }
        }
    }
    if Model.editor == "" && Viewer.expanded && Model.selected >= 0 && Model.selected < Model.count {
        ExpandedPhoto(session, .{viewport.x + 12.0, viewport.y + 12.0, viewport.width - 24.0, viewport.height - 24.0}); return 0
    }
    left := viewport.x + 12.0; top := viewport.y + 12.0
    sidebar: float32 = ifx viewport.width < 800.0 then 126.0 else 166.0
    x := left + sidebar + 14.0; width := viewport.width - sidebar - 38.0
    Label(session, 2, "Photos", .{left, top + 2.0, sidebar, 36.0}, 28)
    labels: [14]string = .{"Photos", "Albums", "Favorites", "Videos", "Hidden", "Trash", "Local sync", "Archive", "Uncategorized", "Memories", "Map", "Places", "Semantic search", "People"}
    views: [14]string = .{"photos", "albums", "favorites", "videos", "hidden", "trash", "sync", "archive", "uncategorized", "memories", "map", "places", "semantic", "people"}
    sidebar_step := (viewport.height - 210.0) / 14.0; if sidebar_step > 47.0 { sidebar_step = 47.0 }
    for i: 0..13 {
        if Action(session, cast(s32)(10 + i), labels[i], .{left, top + 58.0 + cast(float32)i * sidebar_step, sidebar, sidebar_step - 8.0}) { Model.Navigate(views[i]) }
    }
    if Action(session,634,"App lock",.{left,viewport.y+viewport.height-116.0,sidebar,34.0}) { Model.BeginEdit("app_lock_settings","App lock","","") }
    Label(session, 3, "ThinkPad only", .{left, viewport.y + viewport.height - 76.0, sidebar, 22.0}, 13)
    Label(session, 4, "Private local library", .{left, viewport.y + viewport.height - 50.0, sidebar, 22.0}, 12)
    search_committed := Field(session, .{x, top, width - 78.0, 40.0}, true, key, modifiers, typed)
    if Action(session, 42, "Find", .{x + width - 70.0, top, 70.0, 40.0}) || search_committed { Model.Find() }
    Label(session, 5, TextUntilNul(Model.summary[:]), .{x, top + 49.0, width, 24.0}, 14)
    y := top + 84.0
    if Model.editor == "" {
        unused Field(session, .{x, y, width - 176.0, 39.0}, false, key, modifiers, typed)
        if Action(session, 43, "Import", .{x + width - 164.0, y, 78.0, 39.0}) { Model.Request("import", "", TextUntilNul(Model.input[:])) }
        if Action(session, 44, "Sync", .{x + width - 78.0, y, 78.0, 39.0}) { Model.Request("sync") }
    }
    body := Rectangle.{x, y + 52.0, width, viewport.height - 216.0}
    if Model.editor == "collage" {
        CollageEditor(session,body)
    } else if Model.editor == "qr" {
        if Model.selected < 0 || Model.selected >= Model.count { Model.CancelEditor(); return 0 }
        photo := *Model.photos[Model.selected]
        Label(session,510,"QR codes",.{x,body.y,width,32.0},24)
        ready := QRDetection.active && (!Model.loading || Model.qr_check_pending)
        step := (width-24.0)/3.0
        if Action(session,511,"Previous code",.{x,body.y+42.0,step,36.0},ready && QRDetection.count>1) { QRDetection.Move(-1) }
        if Action(session,512,"Copy contents",.{x+step+12.0,body.y+42.0,step,36.0},ready && QRDetection.count>0) {
            Model.Set(Model.message[:],ifx QRDetection.Copy() then "QR contents copied" else "Clipboard unavailable; try again")
        }
        if Action(session,513,"Next code",.{x+2.0*(step+12.0),body.y+42.0,step,36.0},ready && QRDetection.count>1) { QRDetection.Move(1) }
        if Action(session,514,"Back",.{x,body.y+86.0,100.0,36.0}) { Model.CancelEditor(); return 0 }
        caption: Vec(u8); BuilderPrint(*caption,"Code % of % · select a box · scanning stays on this device",QRDetection.chosen+1,QRDetection.count)
        value := BuilderFinish(caption); Label(session,515,value,.{x+112.0,body.y+86.0,width-112.0,36.0},14); Model.Release(value)
        image := ifx photo.display[0] != 0 then TextUntilNul(photo.display[:]) else TextUntilNul(photo.thumbnail[:])
        canvas := Rectangle.{x,body.y+136.0,width,body.height-316.0}
        QRDetection.Draw(session,image,canvas,ready); Record(516,"Detected QR area",canvas,ready)
        preview: TextProps; preview.key = 517; preview.bounds = .{x,body.y+body.height-168.0,width,140.0}; preview.font = 15
        preview.text = QRDetection.Selected(); preview.wrap = TextWrap.TextWrapAuto; Text(session,preview)
    } else if Model.editor == "text" {
        if Model.selected < 0 || Model.selected >= Model.count { Model.CancelEditor(); return 0 }
        photo := *Model.photos[Model.selected]
        Label(session, 435, "Detect text", .{x, body.y, width, 32.0}, 24)
        available := !Model.loading || Model.text_check_pending
        ready := available && TextDetection.active
        step := (width - 24.0) / 3.0
        if Action(session, 437, "Select all", .{x, body.y + 42.0, step, 36.0}, ready && TextDetection.count > 0) { TextDetection.All() }
        if Action(session, 438, "Copy selection", .{x + step + 12.0, body.y + 42.0, step, 36.0}, ready && TextDetection.selected[0] != 0) {
            Model.Set(Model.message[:], ifx TextDetection.Copy() then "Selected text copied" else "Clipboard unavailable; try again")
        }
        if Action(session, 439, "Back", .{x + 2.0 * (step + 12.0), body.y + 42.0, step, 36.0}, available) { Model.CancelEditor() }
        language_caption: Vec(u8); BuilderPrint(*language_caption, "Language: %", TextDetection.LanguageName())
        value := BuilderFinish(language_caption)
        if Action(session, 440, value, .{x, body.y + 86.0, 190.0, 36.0}, available && TextDetection.language_count > 1) {
            TextDetection.language_index = (TextDetection.language_index + 1) % TextDetection.language_count
            TextDetection.Set(TextDetection.language[:], TextUntilNul(TextDetection.languages[TextDetection.language_index][:])); Model.BeginText()
        }; Model.Release(value)
        Label(session, 441, "Drag across words to select · recognition stays on this device", .{x, body.y + 130.0, width, 26.0}, 14)
        image := ifx photo.display[0] != 0 then TextUntilNul(photo.display[:]) else TextUntilNul(photo.thumbnail[:])
        canvas := Rectangle.{x, body.y + 166.0, width, body.height - 284.0}
        TextDetection.Draw(session, image, canvas, ready)
        Record(442, "Detected text area", canvas, ready)
        preview: TextProps; preview.key = 443; preview.bounds = .{x, body.y + body.height - 110.0, width, 90.0}; preview.font = 15
        preview.text = TextUntilNul(TextDetection.selected[:]); preview.wrap = TextWrap.TextWrapAuto; Text(session, preview)
    } else if Model.editor == "image_crop" || Model.editor == "video_crop" {
        CropEditor(session, body)
    } else if Model.editor == "playback" {
        PlaybackViewer(session, body)
    } else if Model.editor == "video" {
        VideoEditor(session, body)
    } else if Model.editor == "image" {
        ImageEditor(session, body)
    } else if Model.editor == "search_help" {
        Label(session, 310, "Find photos with filters", .{x + 12.0, body.y + 12.0, width - 24.0, 34.0}, 22)
        tips: [9]string = .{"Combine filters to narrow your results. Dates use capture time in UTC.",
            "type:photo, type:video or type:live   ·   is:favorite or is:archived",
            "album:\"Summer trip\"   ·   tag:family   ·   name:IMG",
            "caption:\"birthday cake\"   ·   has:location   ·   has:tags",
            "year:2024   ·   on:2024-06-15",
            "from:2024-06-01 to:2024-06-30 includes both days.",
            "-tag:work excludes a match. Quotes keep a phrase together.",
            "Save search creates a smart album that updates as your photos change.",
            "place:\"Home\"   ·   near:-25.3,-57.6,2 (radius in km)"}
        for i: 0..8 { Label(session, cast(u64)(711 + i), tips[i], .{x + 12.0, body.y + 68.0 + cast(float32)i * 34.0, width - 24.0, 30.0}, 14) }
        if Action(session, 319, "Back", .{x + 12.0, body.y + 390.0, 94.0, 38.0}) { Model.CancelEditor() }
    } else if Model.editor != "" {
        Label(session, 91, Model.editor_title, .{x + 12.0, body.y + 12.0, width - 24.0, 34.0}, 22)
        committed := Field(session, .{x + 12.0, body.y + 64.0, width - 24.0, 44.0}, false, key, modifiers, typed)
        Label(session, 92, Model.editor_hint, .{x + 12.0, body.y + 124.0, width - 24.0, 26.0}, 13)
        if Action(session, 93, "Save", .{x + 12.0, body.y + 172.0, 94.0, 38.0}, Model.AppLockReady()) || (committed && Model.AppLockReady()) {
            Model.SaveEditor()
        }
        if Action(session, 94, "Cancel", .{x + 118.0, body.y + 172.0, 94.0, 38.0}, !Model.loading) { if Model.editor == "video_trim" { Model.editor = "video"; Model.focused = false } else { Model.CancelEditor() } }
    } else if Model.view == "hidden" && !Model.vault_unlocked {
        Label(session, 290, "Hidden is locked", .{x + 18.0, body.y + 24.0, width - 36.0, 40.0}, 26)
        Label(session, 291, "Authenticate to view, export or change hidden photos.", .{x + 18.0, body.y + 88.0, width - 36.0, 30.0}, 15)
        if Model.vault_configured {
            if Action(session, 292, "Unlock Hidden", .{x + 18.0, body.y + 144.0, 180.0, 40.0}, !Model.loading) { Model.BeginEdit("vault_unlock", "Unlock Hidden", "", "Your local Hidden password") }
        } else {
            Label(session, 293, "Create a password for Hidden on this desktop.", .{x + 18.0, body.y + 128.0, width - 36.0, 30.0}, 15)
            if Action(session, 294, "Create password", .{x + 18.0, body.y + 184.0, 180.0, 40.0}, !Model.loading) { Model.BeginEdit("vault_setup", "Create Hidden password", "", "Choose at least 8 characters and a password you can remember") }
        }
    } else if Model.view == "sync" {
        Label(session, 70, "Local by design", .{x + 18.0, body.y + 24.0, width - 36.0, 36.0}, 26)
        Label(session, 71, "Your originals and albums stay on your desktop and ThinkPad.", .{x + 18.0, body.y + 80.0, width - 36.0, 30.0})
        Label(session, 72, "Encrypted sync uses your ThinkPad's Daochi node only.", .{x + 18.0, body.y + 122.0, width - 36.0, 30.0})
        Label(session, 73, "Folder imports keep the source files untouched and merge duplicates.", .{x + 18.0, body.y + 164.0, width - 36.0, 30.0})
        Label(session, 74, "Offline changes are saved here and sync resumes automatically.", .{x + 18.0, body.y + 206.0, width - 36.0, 30.0})
        Label(session, 209, "Folder backup", .{x + 18.0, body.y + 254.0, width - 36.0, 30.0}, 22)
        Label(session, 210, TextUntilNul(Model.export_status[:]), .{x + 18.0, body.y + 294.0, width - 36.0, 30.0}, 14)
        if Action(session, 211, "Export library", .{x + 18.0, body.y + 336.0, 148.0, 38.0}, !Model.loading) { Model.BeginEdit("export_start", "Export library", "", "Separate folder; exports albums and metadata, excluding Hidden and Trash") }
        if Action(session, 212, "Continuous export", .{x + 178.0, body.y + 336.0, 174.0, 38.0}, !Model.loading) { Model.BeginEdit("export_continuous", "Enable continuous export", "", "Separate folder; album changes are mirrored in the background") }
        if Model.export_continuous {
            if Action(session, 213, "Stop export", .{x + 366.0, body.y + 336.0, 126.0, 38.0}, !Model.loading) { Model.Apply("export_stop") }
        }
        Label(session,652,"Backup key recovery",.{x+18.0,body.y+388.0,width-36.0,30.0},22)
        if Action(session,653,"Save recovery file",.{x+18.0,body.y+430.0,172.0,38.0},!Model.loading) { Model.BeginEdit("recovery_save_path","Save recovery file","","Full path to a new file outside the library; unlock Hidden first if configured") }
        if Action(session,654,"Restore backup keys",.{x+206.0,body.y+430.0,182.0,38.0},!Model.loading) { Model.BeginEdit("recovery_restore_path","Restore backup keys","","Full path to your recovery file; restore into a new empty library with backup stopped") }
        if Action(session,662,"Recover app password",.{x+404.0,body.y+430.0,192.0,38.0},!Model.loading) { Model.BeginRecoveryReset(1) }
        if Action(session,663,"Recover Hidden password",.{x+612.0,body.y+430.0,222.0,38.0},!Model.loading) { Model.BeginRecoveryReset(2) }
        Label(session,650,"Gallery and storage",.{x+18.0,body.y+482.0,width-36.0,30.0},22)
        if Action(session,651,ifx Model.swipe_selection_enabled then "Swipe to select: on" else "Swipe to select: off",.{x+18.0,body.y+520.0,210.0,38.0},!Model.loading) {
            Model.Apply("swipe_selection",ifx Model.swipe_selection_enabled then "off" else "on")
        }
        if Action(session,664,"Large files",.{x+244.0,body.y+520.0,148.0,38.0},!Model.loading) { Model.LargeFiles() }
    } else if Model.selected >= 0 && Model.selected < Model.count {
        photo: *Photo = *Model.photos[Model.selected]
        if Action(session, 50, "Back", .{x, body.y, 68.0, 36.0}) { Model.selected = -1; Viewer.Reset(); return 0 }
        if Action(session, 51, "Previous", .{x + 78.0, body.y, 92.0, 36.0}, Model.selected > 0) { Model.Choose(Model.selected - 1) }
        if Action(session, 52, "Next", .{x + 180.0, body.y, 68.0, 36.0}, Model.selected + 1 < Model.count) { Model.Choose(Model.selected + 1) }
        if Action(session, 53, ifx photo.favorite then "Unfavorite" else "Favorite", .{x + 258.0, body.y, 106.0, 36.0}, !Model.loading) { SelectedAction("favorite") }
        if Action(session, 54, ifx photo.trashed then "Restore" else "Trash", .{x + 374.0, body.y, 76.0, 36.0}, !Model.loading) { SelectedAction(ifx photo.trashed then "restore" else "trash") }
        image := ifx photo.display[0] != 0 && TextUntilNul(photo.kind[:]) == "photo" then TextUntilNul(photo.display[:]) else TextUntilNul(photo.thumbnail[:])
        ready := !Model.loading && TextUntilNul(Model.detail_id[:]) == TextUntilNul(photo.id[:])
        if photo.live {
            if Action(session, 370, "Play Live Photo", .{x + 460.0, body.y, 144.0, 36.0}, ready && !photo.trashed) { Model.BeginPlayback() }
            if Action(session, 371, "Separate files", .{x + 614.0, body.y, 138.0, 36.0}, ready) { Model.Apply("live_separate") }
        }
        if Action(session,669,ifx Model.semantic_enabled then "Find similar" else "Enable ML search",.{x+width-138.0,body.y,138.0,36.0},ready && TextUntilNul(photo.kind[:]) == "photo" && !photo.hidden && !photo.trashed) {
            if Model.semantic_enabled { Model.SimilarPhotos() } else { Model.Navigate("semantic") }; return 0
        }
        if Action(session, 215, "Edit image", .{x, body.y + 44.0, 126.0, 36.0}, ready && TextUntilNul(photo.kind[:]) == "photo" && !photo.trashed) { Model.BeginImageEdit() }
        if TextUntilNul(photo.kind[:]) == "video" {
            if Action(session, 330, "Edit video", .{x, body.y + 44.0, 126.0, 36.0}, ready && !photo.trashed) { Model.BeginVideoEdit() }
            if Action(session, 350, "Play video", .{x + 288.0, body.y + 44.0, 126.0, 36.0}, ready && !photo.trashed) { Model.BeginPlayback() }
        }
        else { ViewerControls(session, image, .{x + 288.0, body.y + 44.0, width - 288.0, 36.0}, .{x, body.y + 92.0, width, body.height - 364.0}, ready) }
        if Action(session, 216, "Edit location", .{x + 138.0, body.y + 44.0, 138.0, 36.0}, ready) { Model.BeginEdit("location", "Edit photo location", TextUntilNul(Model.detail_location[:]), "Latitude, longitude; leave empty to remove location") }
        if TextUntilNul(photo.kind[:]) == "photo" { Viewer.Draw(session, 3000, image, TextUntilNul(photo.name[:]), .{x, body.y + 92.0, width, body.height - 364.0}) }
        else { ImageAt(session, 3000, image, TextUntilNul(photo.name[:]), .{x, body.y + 92.0, width, body.height - 364.0}) }
        name_width := width - (ifx TextUntilNul(photo.kind[:]) == "photo" then 270.0 else 138.0)
        Label(session, 75, TextUntilNul(photo.name[:]), .{x, body.y + body.height - 262.0, name_width, 24.0}, 17)
        if TextUntilNul(photo.kind[:]) == "photo" {
            if Action(session,518,"Detect QR",.{x+width-258.0,body.y+body.height-270.0,122.0,32.0},ready && !photo.trashed) { Model.BeginQR() }
            if Action(session, 436, "Detect text", .{x + width - 126.0, body.y + body.height - 270.0, 126.0, 32.0}, ready && !photo.trashed) { Model.BeginText() }
        }
        details: Vec(u8); BuilderPrint(*details, "% · % x % · % bytes", TextUntilNul(Model.detail_taken[:]), photo.width, photo.height, Model.detail_size)
        text := BuilderFinish(details); Label(session, 76, text, .{x, body.y + body.height - 232.0, width, 22.0}, 13); Model.Release(text)
        Label(session, 77, TextUntilNul(Model.detail_caption[:]), .{x, body.y + body.height - 202.0, width-148.0, 22.0}, 14)
        if Action(session,519,"Tag person",.{x+width-138.0,body.y+body.height-210.0,138.0,30.0},ready && Model.people_enabled && !photo.hidden && !photo.trashed) { Model.BeginEdit("person_tag","Tag person in this item","","One person's name; no detected face is required") }
        Label(session, 78, TextUntilNul(Model.detail_albums[:]), .{x, body.y + body.height - 172.0, width-148.0, 22.0}, 13)
        if Action(session,520,"Remove person tag",.{x+width-138.0,body.y+body.height-180.0,138.0,30.0},ready && Model.people_enabled && !photo.hidden && !photo.trashed) { Model.BeginEdit("person_untag","Remove manual person tag","","One person's name; detected faces stay assigned") }
        tags: Vec(u8); BuilderPrint(*tags,"%",TextUntilNul(Model.detail_tags[:]))
        if Model.detail_people[0] != 0 { if Model.detail_tags[0] != 0 { BuilderPrint(*tags," · ") }; BuilderPrint(*tags,"%",TextUntilNul(Model.detail_people[:])) }
        tag_text := BuilderFinish(tags); Label(session,79,tag_text,.{x,body.y+body.height-142.0,width,22.0},13); Model.Release(tag_text)
        Label(session, 96, TextUntilNul(Model.detail_location[:]), .{x, body.y + body.height - 114.0, width - 148.0, 22.0}, 13)
        if Action(session, 420, "Name place", .{x + width - 138.0, body.y + body.height - 122.0, 138.0, 30.0}, ready && !photo.hidden && !photo.trashed && Model.detail_location[0] != 0) { Model.BeginPlace(true) }
        step := (width - 32.0) / 5.0
        bottom := body.y + body.height - 82.0
        if Action(session, 55, "Add to album", .{x, bottom, step, 36.0}, ready) { Model.BeginEdit("album_add", "Add photo to album", "", "Enter an album name") }
        if Action(session, 56, "Caption", .{x + step + 8.0, bottom, step, 36.0}, ready && Model.detail_caption_editable) { Model.BeginEdit("caption", "Edit caption", TextUntilNul(Model.detail_caption[:]), "Describe this photo") }
        if Action(session, 57, "Tags", .{x + 2.0 * (step + 8.0), bottom, step, 36.0}, ready && Model.detail_tags_editable) { Model.BeginEdit("tags", "Edit tags", TextUntilNul(Model.detail_tags[:]), "Searchable keywords") }
        if Action(session, 58, ifx photo.hidden then "Unhide" else "Hide", .{x + 3.0 * (step + 8.0), bottom, step, 36.0}, ready) { SelectedAction("hidden") }
        if Action(session, 59, "Export", .{x + 4.0 * (step + 8.0), bottom, step, 36.0}, ready) { Model.BeginEdit("export", "Export original and metadata", "", "Destination folder; empty uses Pictures/Photos Export") }
        bottom += 44.0
        if Action(session, 97, "Edit date", .{x, bottom, step, 36.0}, ready) { Model.BeginEdit("taken", "Edit photo date", TextUntilNul(Model.detail_taken[:]), "Date and time; include an offset, or use UTC") }
        if Action(session, 98, "Rename", .{x + step + 8.0, bottom, step, 36.0}, ready) { Model.BeginEdit("rename", "Rename photo", TextUntilNul(photo.name[:]), "File name; the original bytes stay intact") }
        if Action(session, 99, "Remove from album", .{x + 2.0 * (step + 8.0), bottom, step * 2.0 + 8.0, 36.0}, ready) { Model.BeginEdit("album_remove", "Remove photo from album", TextUntilNul(Model.album[:]), "Album name; removing membership keeps the photo") }
        if Action(session, 95, ifx photo.archived then "Unarchive" else "Archive", .{x + 4.0 * (step + 8.0), bottom, step, 36.0}, ready) { SelectedAction("archived") }
        if Model.album[0] != 0 && Model.album_filter[0] == 0 && ready && !photo.hidden && !photo.trashed {
            if Action(session, 205, "Use as album cover", .{x + width - 186.0, body.y + 44.0, 186.0, 36.0}) { Model.Apply("album_cover", TextUntilNul(photo.id[:])) }
        }
        if Model.album[0] == 0 && !photo.hidden && !photo.trashed {
            if Action(session,464,"Jump to this day",.{x+width-170.0,body.y+44.0,170.0,36.0},ready) { Model.JumpPhoto() }
        }
    } else if Model.view == "map" && !Map.gallery {
        OfflineMap(session, body)
    } else {
        if Model.CatalogView() {
            if Model.view == "auto_people" {
                Label(session,473,"Auto-add people",.{x,body.y,width,26.0},22)
                Label(session,474,"Choose named people; new indexed matches join this album",.{x,body.y+30.0,width,26.0},14)
                step := (width-24.0)/3.0
                if Action(session,475,"Save people",.{x,body.y+64.0,step,36.0},!Model.loading) { Model.Request(ifx Model.auto_remove then "album_auto_people_remove" else "album_auto_people") }
                if Action(session,476,"Cancel",.{x+step+12.0,body.y+64.0,step,36.0},!Model.loading) { Model.AutoBack() }
                if Action(session,477,"Deselect all",.{x+2.0*(step+12.0),body.y+64.0,step,36.0},!Model.loading) { Model.ClearSelection() }
                body.y += 108.0; body.height -= 108.0
                if Action(session,478,ifx Model.auto_remove then "Remove previously auto-added photos" else "Keep previously auto-added photos",.{x,body.y,width,36.0},!Model.loading) { Model.auto_remove = !Model.auto_remove }
                body.y += 44.0; body.height -= 44.0
