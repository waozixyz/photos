// Read bounded XMP and MP4 ranges without changing the combined original.
// XML namespaces, not arbitrary prefixes, determine the metadata's meaning.
#import "std/byte_text_linux"
#import "std/c_string"
c :: #system_library "c";
xml :: #system_library "xml2";
heif :: #system_library "heif";
Error :: struct { code: s32; subcode: s32; message: *u8 }
Context :: () -> *void #foreign heif "heif_context_alloc";
FreeContext :: (context: *void) #foreign heif "heif_context_free";
ReadHEIF :: (context: *void, path: *u8, options: *void) -> Error #foreign heif "heif_context_read_from_file";
Primary :: (context: *void, handle: **void) -> Error #foreign heif "heif_context_get_primary_image_handle";
ReleaseHandle :: (handle: *void) #foreign heif "heif_image_handle_release";
MetadataCount :: (handle: *void, filter: *u8) -> s32 #foreign heif "heif_image_handle_get_number_of_metadata_blocks";
MetadataIDs :: (handle: *void, filter: *u8, ids: *u32, count: s32) -> s32 #foreign heif "heif_image_handle_get_list_of_metadata_block_IDs";
MetadataType :: (handle: *void, id: u32) -> *u8 #foreign heif "heif_image_handle_get_metadata_content_type";
MetadataSize :: (handle: *void, id: u32) -> usize #foreign heif "heif_image_handle_get_metadata_size";
Metadata :: (handle: *void, id: u32, data: *u8) -> Error #foreign heif "heif_image_handle_get_metadata";
Open :: (path: *u8, mode: *u8) -> *void #foreign c "fopen";
Close :: (file: *void) -> s32 #foreign c "fclose";
Read :: (data: *u8, size: usize, count: usize, file: *void) -> usize #foreign c "fread";
Write :: (data: *u8, size: usize, count: usize, file: *void) -> usize #foreign c "fwrite";
Seek :: (file: *void, offset: s64, whence: s32) -> s32 #foreign c "fseeko";
Tell :: (file: *void) -> s64 #foreign c "ftello";
Reader :: (data: *u8, size: s32, url: *u8, encoding: *u8, options: s32) -> *void #foreign xml "xmlReaderForMemory";
FreeReader :: (reader: *void) #foreign xml "xmlFreeTextReader";
Next :: (reader: *void) -> s32 #foreign xml "xmlTextReaderRead";
Type :: (reader: *void) -> s32 #foreign xml "xmlTextReaderNodeType";
Depth :: (reader: *void) -> s32 #foreign xml "xmlTextReaderDepth";
Local :: (reader: *void) -> *u8 #foreign xml "xmlTextReaderConstLocalName";
Namespace :: (reader: *void) -> *u8 #foreign xml "xmlTextReaderConstNamespaceUri";
Value :: (reader: *void) -> *u8 #foreign xml "xmlTextReaderConstValue";
FirstAttribute :: (reader: *void) -> s32 #foreign xml "xmlTextReaderMoveToFirstAttribute";
NextAttribute :: (reader: *void) -> s32 #foreign xml "xmlTextReaderMoveToNextAttribute";
ToElement :: (reader: *void) -> s32 #foreign xml "xmlTextReaderMoveToElement";
Empty :: (reader: *void) -> s32 #foreign xml "xmlTextReaderIsEmptyElement";
Camera :: "http://ns.google.com/photos/1.0/camera/";
Container :: "http://ns.google.com/photos/1.0/container/";
Item :: "http://ns.google.com/photos/1.0/container/item/";
Number :: (value: string) -> s64 {
    if value.count == 0 || value.count > 10 { return -1 }
    result: s64
    for byte: value { if byte < 48 || byte > 57 { return -1 }; result = result*10+cast(s64)byte-48 }
    return result
}
CameraField :: (name: string) -> s32 {
    if name == "MotionPhoto" { return 1 }; if name == "MicroVideo" { return 2 }; if name == "MicroVideoOffset" { return 3 }; return 0
}
Flags :: struct { modern: s64; legacy: s64; offset: s64; seenModern: bool; seenLegacy: bool; seenOffset: bool }
Assign :: (flags: *Flags, field: s32, text: string) -> bool {
    begin: s32; end := cast(s32)text.count
    while begin < end && (text[begin] == 32 || text[begin] == 9 || text[begin] == 10 || text[begin] == 13) { begin += 1 }
    while end > begin && (text[end-1] == 32 || text[end-1] == 9 || text[end-1] == 10 || text[end-1] == 13) { end -= 1 }
    number := Number(text[begin:end])
    if field == 1 { if flags.seenModern { return false }; flags.seenModern = true; flags.modern = number }
    if field == 2 { if flags.seenLegacy { return false }; flags.seenLegacy = true; flags.legacy = number }
    if field == 3 { if flags.seenOffset { return false }; flags.seenOffset = true; flags.offset = number }
    return true
}
Match :: (data: []u8, value: string) -> bool {
    if data.count != value.count { return false }
    for i: 0..value.count-1 { if data[i] != value[i] { return false } }; return true
}
Description :: struct { length: s64; padding: s64; secondary: s64; modern: bool; disabled: bool; valid: bool }
Parse :: (data: []u8) -> Description {
    result: Description
    // No DTDs, entity expansion, external documents, recovery or huge-tree mode.
    reader := Reader(*data[0],cast(s32)data.count,null,null,2144)
    if reader == null { return result }; defer { FreeReader(reader) }
    flags: Flags; flags.modern = -1; flags.legacy = -1; flags.offset = -1
    scalar: s32; scalarDepth: s32
    directories: s32; directoryDepth: s32 = -1; items: s32; ended: bool
    steps: s32; status := Next(reader)
    while status == 1 {
        steps += 1; if steps > 8192 || Depth(reader) > 32 { return result }
        kind := Type(reader); name := TextFromCString(Local(reader)); ns := TextFromCString(Namespace(reader))
        if kind == 5 || kind == 6 || kind == 10 { return result }
        if scalar != 0 && (kind == 3 || kind == 4) {
            if !Assign(*flags,scalar,TextFromCString(Value(reader))) { return result }; scalar = 0
        }
        if scalar != 0 && (kind == 15 && Depth(reader) == scalarDepth || kind == 1 && Depth(reader) > scalarDepth) { return result }
        if kind == 15 && ns == Container && name == "Directory" { directoryDepth = -1; ended = true }
        if kind == 1 {
            if ns == Camera && CameraField(name) != 0 {
                scalar = CameraField(name); scalarDepth = Depth(reader); if Empty(reader) == 1 { return result }
            }
            if ns == Container && name == "Directory" {
                directories += 1; if directories > 1 { return result }; directoryDepth = Depth(reader)
            }
            isItem := ns == Container && name == "Item" && directoryDepth >= 0 && Depth(reader) > directoryDepth
            primary: bool; motion: bool; mime: bool; hasLength: bool
            length: s64; padding: s64
            attribute := FirstAttribute(reader)
            while attribute == 1 {
                key := TextFromCString(Local(reader)); namespace := TextFromCString(Namespace(reader)); value := TextFromCString(Value(reader))
                if namespace == Camera {
                    if !Assign(*flags,CameraField(key),value) { return result }
                }
                if isItem && namespace == Item {
                    if key == "Semantic" { primary = value == "Primary"; motion = value == "MotionPhoto" }
                    if key == "Mime" { mime = (items == 0 && (value == "image/jpeg" || value == "image/heic" || value == "image/avif")) || (items > 0 && (value == "video/mp4" || value == "video/quicktime")) }
                    if key == "Length" { length = Number(value); hasLength = true }
                    if key == "Padding" { padding = Number(value) }
                }
                attribute = NextAttribute(reader)
            }
            unused ToElement(reader)
            if isItem {
                if items >= 32 || padding < 0 || length < 0 || result.length > 0 { return result }
                if items == 0 {
                    if !primary || !mime || length != 0 { return result }; result.padding = padding
                } else {
                    if primary || !hasLength || padding != 0 { return result }
                    result.secondary += length
                    if motion { if !mime || length < 16 { return result }; result.length = length }
                }
                items += 1
            }
        }
        status = Next(reader)
    }
    if status != 0 || scalar != 0 { return result }
    if flags.seenModern {
        result.modern = true
        result.disabled = flags.modern != 1
        result.valid = flags.modern == 1 && directories == 1 && ended && items >= 2 && result.length >= 16
    } else if flags.seenLegacy && flags.legacy == 1 && directories == 0 && flags.offset >= 16 {
        result.length = flags.offset; result.secondary = flags.offset; result.valid = true
    }
    if result.length > 134217728 || result.secondary > 1073741824 || result.padding > 1048576 { result.valid = false }
    return result
}
Big :: (bytes: []u8) -> s64 { value: s64; for byte: bytes { value = value*256+cast(s64)byte }; return value }
At :: (file: *void, at: s64, bytes: []u8) -> bool {
    return Seek(file,at,0) == 0 && Read(*bytes[0],1,cast(usize)bytes.count,file) == cast(usize)bytes.count
}
Little :: (bytes: []u8) -> s64 { value: s64; factor: s64 = 1; for byte: bytes { value += cast(s64)byte*factor; factor *= 256 }; return value }
Range :: struct { start: s64; end: s64; valid: bool }
Samsung :: (file: *void, size: s64, imageStart: s64) -> Range {
    result: Range; head: [24]u8
    if !At(file,size-8,head[:8]) || !Match(head[4:8],"SEFT") { return result }
    length := Little(head[:4]); directory := size-8-length
    if length < 24 || length > 65535 || directory <= imageStart { return result }
    if !At(file,directory,head[:12]) || !Match(head[:4],"SEFH") || Little(head[4:8]) != 101 { return result }
    count := Little(head[8:12]); if count < 1 || count > 32 || length != 12+12*count { return result }
    first := directory
    starts: [32]s64; ends: [32]s64
    for i: 0..cast(s32)count-1 {
        if !At(file,directory+12+12*cast(s64)i,head[:12]) { return result }
        kind := Little(head[2:4]); back := Little(head[4:8]); block := Little(head[8:12]); start := directory-back
        if head[0] != 0 || head[1] != 0 || back > directory || block < 8 || block > back || start <= imageStart { return result }
        for j: 0..i-1 { if start < ends[j] && start+block > starts[j] { return result } }
        starts[i] = start; ends[i] = start+block
        if start < first { first = start }
        if kind == 2608 { // Samsung MotionPhoto_Data, tag 0x0a30.
            if result.valid || block < 40 || block > 134217752 || !At(file,start,head[:24]) { return result }
            if Little(head[:4]) != 170917888 || Little(head[4:8]) != 16 || !Match(head[8:24],"MotionPhoto_Data") { return result }
            result.start = start+24; result.end = start+block; result.valid = true
        }
    }
    if !result.valid || !At(file,first-2,head[:2]) || head[0] != 255 || head[1] != 217 { result.valid = false }
    return result
}
HEIFDescription :: (path: *u8) -> Description {
    result: Description
    context := Context(); if context == null { return result }; defer { FreeContext(context) }
    error := ReadHEIF(context,path,null); if error.code != 0 { return result }
    handle: *void; error = Primary(context,*handle)
    if error.code != 0 || handle == null { return result }; defer { ReleaseHandle(handle) }
    count := MetadataCount(handle,null); if count < 1 || count > 32 { return result }
    ids: [32]u32; if MetadataIDs(handle,null,*ids[0],count) != count { return result }
    found: s32
    for i: 0..count-1 {
        if TextFromCString(MetadataType(handle,ids[i])) == "application/rdf+xml" {
            found += 1; if found > 1 { result.valid = false; return result }
            length := MetadataSize(handle,ids[i]); if length < 1 || length > 65536 { return result }
            bytes: [65536]u8; error = Metadata(handle,ids[i],*bytes[0]); if error.code != 0 { return result }
            result = Parse(bytes[:cast(s32)length])
        }
    }
    return result
}
main :: (argc: s32, argv: **u8) -> s32 {
    if argc != 2 && argc != 3 { return 2 }
    mode: [4]u8 = .{114,98,0,0}
    file := Open(argv[1],*mode[0]); if file == null { return 3 }; defer { unused Close(file) }
    if Seek(file,0,2) != 0 { return 3 }; size := Tell(file)
    if size < 32 || size > 8589934592 { return 4 }
    head: [16]u8; if !At(file,0,head[:8]) { return 4 }
    jpeg := head[0] == 255 && head[1] == 216
    if !jpeg && !Match(head[4:8],"ftyp") { return 4 }
    position: s64 = 2; segments: s32; xmp: s32; description: Description; imageStart: s64
    while jpeg && position < size && position < 4194304 && segments < 1024 {
        if !At(file,position,head[:2]) || head[0] != 255 { return 4 }
        while head[1] == 255 { position += 1; if !At(file,position,head[:2]) { return 4 } }
        marker := head[1]; position += 2
        if marker == 218 { imageStart = position; break }
        if marker == 217 || marker == 0 || marker == 216 { return 4 }
        if marker == 1 || (marker >= 208 && marker <= 215) { continue }
        if !At(file,position,head[:2]) { return 4 }; length := Big(head[:2])
        if length < 2 || length > size-position { return 4 }
        if marker == 225 && length > 31 {
            bytes: [65536]u8
            if !At(file,position+2,bytes[:cast(s32)length-2]) { return 4 }
            if Match(bytes[:28],"http://ns.adobe.com/xap/1.0/") && bytes[28] == 0 {
                xmp += 1; if xmp > 1 { return 4 }
                description = Parse(bytes[29:cast(s32)length-2])
            }
        }
        position += length; segments += 1
    }
    if !jpeg {
        description = HEIFDescription(argv[1])
        if !description.valid || !description.modern || description.secondary != description.length { return 4 }
        position = 0
        while position < size && segments < 4096 {
            if !At(file,position,head[:8]) { return 4 }; length := Big(head[:4]); header: s64 = 8
            if length == 1 { if !At(file,position+8,head[8:16]) { return 4 }; length = Big(head[8:16]); header = 16 }
            if length < header || length > size-position { return 4 }
            if Match(head[4:8],"mpvd") {
                if position+length != size || length-header != description.length || description.padding != header { return 4 }
                imageStart = position+header; break
            }
            position += length; segments += 1
        }
    }
    if imageStart == 0 { return 4 }
    start := size-description.length; end := size
    if jpeg && !description.valid && !description.disabled {
        range := Samsung(file,size,imageStart); if !range.valid { return 4 }
        start = range.start; end = range.end; description.length = end-start
    } else if !description.valid { return 4 }
    else if jpeg {
        imageEnd := size-description.secondary-description.padding
        if imageEnd < imageStart+2 || start < imageEnd || !At(file,imageEnd-2,head[:2]) || head[0] != 255 || head[1] != 217 { return 4 }
    } else if start != imageStart { return 4 }
    // Verify complete top-level MP4 boxes. No arbitrary 'ftyp' byte search.
    if !At(file,start,head[:8]) || !Match(head[4:8],"ftyp") { return 4 }
    at := start; boxes: s32; movie: bool; media: bool
    while at < end && boxes < 4096 {
        if !At(file,at,head[:8]) { return 4 }; length := Big(head[:4]); header: s64 = 8
        if length == 1 { if !At(file,at+8,head[8:16]) { return 4 }; length = Big(head[8:16]); header = 16 }
        if length == 0 { length = end-at }
        if length < header || length > end-at { return 4 }
        if Match(head[4:8],"moov") { movie = true }; if Match(head[4:8],"mdat") { media = true }
        at += length; boxes += 1
    }
    if at != end || !movie || !media { return 4 }
    if argc == 3 {
        // Exclusive creation: callers provide a private, previously absent path.
        writeMode: [4]u8 = .{119,98,120,0}
        output := Open(argv[2],*writeMode[0]); if output == null { return 3 }; defer { unused Close(output) }
        buffer: [65536]u8; remaining := description.length
        if Seek(file,start,0) != 0 { return 3 }
        while remaining > 0 {
            count := cast(usize)(ifx remaining > 65536 then 65536 else remaining)
            if Read(*buffer[0],1,count,file) != count || Write(*buffer[0],1,count,output) != count { return 3 }
            remaining -= cast(s64)count
        }
    }
    print("{\"version\":1,\"offset\":%,\"length\":%}\n",start,description.length); return 0
}
