// Read-only gallery and search engine. This helper creates no keys, files,
// windows or network connections; SQLite supplies one consistent WAL snapshot.
using SQLite :: #import "sqlite/SQLite";
Search :: #import "search";
Locations :: #import "locations";
Geo :: #import "geo";
Semantic :: #import "semantic";
Presentation :: #import "presentation";
Guest :: #import "guest_scope";
Clock :: #import "std/date_time_linux";
#import "std/date_parse"
#import "std/byte_text_linux"
#import "std/json_scan"
#import "std/text_buffer"
libc :: #system_library "libc";
Read :: (fd: s32, output: *u8, count: usize) -> s64 #foreign libc "read";

Decode :: (json: string, key: string, bytes: []u8) -> bool {
    at := FieldAt(json, 0, key)
    if at < 0 { return true }
    length := ReadStringText(json, at, bytes)
    if length < 0 || length >= cast(s32)bytes.count { return false }
    bytes[length] = 0; return true
}
Number :: (json: string, key: string, default_value: s32) -> s32 {
    value := ReadNumber(json, FieldAt(json, 0, key))
    if !value.valid || value.value < 0.0 || value.value > 2147483647.0 { return default_value }
    return cast(s32)value.value
}
Failure :: (message: string) -> s32 { print("{\"error\":\"%\"}\n", message); return 1 }
Prepare :: (database: *void, sql: string, query: *Search.Predicate, statement: **void) -> bool {
    if SqlitePrepareText(database, sql, -1, statement, null) != SQLITE_OK { return false }
    for i: 0..query.count - 1 {
        if SqliteBindTextString(statement.*, cast(s32)i + 1, TextUntilNul(query.parameters[i].bytes[:]), -1) != SQLITE_OK { return false }
    }
    return true
}
main :: (argc: s32, argv: **u8) -> s32 {
    if argc != 2 { return Failure("Supply the private library database") }
    input: [131073]u8; length: s32
    while length < 131072 {
        amount := Read(0, *input[length], cast(usize)(131072 - length))
        if amount < 0 { return Failure("Cannot read gallery request") }; if amount == 0 { break }; length += cast(s32)amount
    }
    if length == 0 || length >= 131072 { return Failure("Gallery request exceeds its limit") }
    json := TextFromBytes(input[:length])
    if Space(json, ValueEnd(json, 0, 0)) != length || json[0] != 123 { return Failure("Choose a valid gallery request") }
    guest: Guest.Scope; Guest.ReadScope(json,*guest)
    if guest.error != "" { return Failure(guest.error) }
    view: [32]u8; search: [513]u8; album: [513]u8; sort: [16]u8; memory: [11]u8; filter: [513]u8; person: [65]u8; birth: [11]u8; jump: [11]u8
    if !Decode(json,"view",view[:]) || !Decode(json,"search",search[:]) || !Decode(json,"album",album[:]) ||
        !Decode(json,"sort",sort[:]) || !Decode(json,"memory_date",memory[:]) || !Decode(json,"filter",filter[:]) || !Decode(json,"person",person[:]) || !Decode(json,"birth",birth[:]) || !Decode(json,"jump_day",jump[:]) { return Failure("Gallery value exceeds its limit") }
    order := ifx guest.active then "newest" else TextUntilNul(sort[:]); page := Number(json, "offset", 0); limit := Number(json, "limit", 60)
    if order != "newest" && order != "oldest" { return Failure("Choose newest first or oldest first") }
    if limit < 1 { limit = 1 }; if limit > 100 { limit = 100 }
    query: Search.Predicate
    slideshow := !guest.active && Number(json,"slideshow",0) == 1
    name := ifx guest.active then "photos" else TextUntilNul(view[:]); hidden := !guest.active && Number(json,"hidden_access",0) == 1
    if name == "trash" { Search.AddSQL(*query, "trashed>0"); if !hidden { Search.AddSQL(*query, " AND hidden=0") } }
    else if name == "hidden" { Search.AddSQL(*query, ifx hidden then "trashed=0 AND hidden=1" else "0") }
    else {
        Search.AddSQL(*query, "trashed=0 AND hidden=0")
        if name == "favorites" { Search.AddSQL(*query," AND favorite=1") }
        else if name == "videos" { Search.AddSQL(*query," AND kind='video'") }
        else if name == "archive" { Search.AddSQL(*query," AND (archived=1 OR EXISTS(SELECT 1 FROM json_each(photos.albums) j JOIN albums a ON a.name=j.value WHERE a.archived=1 AND a.deleted=0))") }
        else if name == "uncategorized" { Search.AddSQL(*query," AND json_array_length(albums)=0") }
        else if !guest.active && name == "photos" && album[0] == 0 && search[0] == 0 && filter[0] == 0 || name == "memories" || name == "lane" {
            Search.AddSQL(*query," AND archived=0 AND NOT EXISTS(SELECT 1 FROM json_each(photos.albums) j JOIN albums a ON a.name=j.value WHERE a.archived=1 AND a.deleted=0)")
        }
    }
    // A saved search never turns into a Hidden or Trash album, even when
    // callers combine it with another gallery view or an unlocked vault.
    if filter[0] != 0 { Search.AddSQL(*query," AND trashed=0 AND hidden=0") }
    if FieldAt(json,0,"photo_id") >= 0 {
        identity: [65]u8
        if ReadStringText(json,FieldAt(json,0,"photo_id"),identity[:]) != 64 { return Failure("Choose a valid gallery photo") }
        for i: 0..63 {
            byte := identity[i]
            if !((byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102)) { return Failure("Choose a valid gallery photo") }
        }
        Search.AddSQL(*query," AND id=?"); Search.Bind(*query,TextUntilNul(identity[:]))
    }
    // Motion originals remain separate encrypted records, but only their still
    // is a gallery item. Incomplete or mismatched privacy updates fail closed.
    Search.AddSQL(*query, " AND coalesce(json_extract(metadata,'$.photosLive.photo'),'')='' AND (json_extract(metadata,'$.photosLive.video') IS NULL OR EXISTS(SELECT 1 FROM photos motion WHERE motion.id=json_extract(photos.metadata,'$.photosLive.video') AND motion.kind='video' AND json_extract(motion.metadata,'$.photosLive.photo')=photos.id AND motion.hidden=photos.hidden AND (motion.trashed>0)=(photos.trashed>0)))")
    Guest.Predicate(*guest,*query)
    if !guest.active && album[0] != 0 && filter[0] == 0 { Search.AddSQL(*query," AND EXISTS(SELECT 1 FROM json_each(photos.albums) WHERE value=?)"); Search.Bind(*query,TextUntilNul(album[:])) }
    if name == "people" || name == "lane" {
        Search.AddSQL(*query," AND hidden=0 AND trashed=0 AND EXISTS(SELECT 1 FROM person_photos WHERE person_photos.photo_id=photos.id AND person_photos.person_id=?)")
        Search.Bind(*query,TextUntilNul(person[:]))
    }
    if name == "lane" {
        Search.AddSQL(*query," AND kind='photo'")
        Search.AddSQL(*query," AND (SELECT ignored FROM people WHERE id=?)=0"); Search.Bind(*query,TextUntilNul(person[:]))
        if birth[0] != 0 {
            value := TextUntilNul(birth[:]); year := DateNumber(value,0,4); month := DateNumber(value,5,2); day := DateNumber(value,8,2)
            // Birth dates can predate the Unix epoch. Compare calendar dates
            // without the standard feed parser's 1970 lower bound.
            cutoff: Vec(u8); BuilderPrint(*cutoff,"%-%-",year+3,value[5:7])
            BuilderPrint(*cutoff,"%",ifx month == 2 && day == 29 then "28" else value[8:10])
            Search.AddSQL(*query," AND strftime('%Y-%m-%d',taken,'unixepoch')>=?"); Search.Bind(*query,BuilderFinish(cutoff))
        }
    }
    if name == "memories" {
        if memory[0] == 0 { unused WriteIsoDay(Clock.UnixNow(),memory[:]) }
        day := Search.Date(TextUntilNul(memory[:]))
        if day < 0 { return Failure("Choose a valid memories day in YYYY-MM-DD format") }
        Search.AddSQL(*query," AND strftime('%m-%d',taken,'unixepoch')=? AND taken<?")
        Search.Bind(*query,TextUntilNul(memory[5:11])); Search.BindNumber(*query,UtcSeconds(DateNumber(TextUntilNul(memory[:]),0,4),1,1,0,0,0))
    }
    if !guest.active { Search.Parse(*query,TextUntilNul(filter[:])); Search.Parse(*query,TextUntilNul(search[:])) }
    if slideshow {
        Search.AddSQL(*query," AND kind='photo' AND hidden=0 AND trashed=0")
        Presentation.Albums(*query,json)
    }
    map_bounds: Locations.Bounds = .{-180000000, -90000000, 180000000, 90000000}
    if name == "map" {
        if !Locations.ReadBounds(json, *map_bounds) { return Failure("Choose valid map bounds in microdegrees") }
        Locations.Filter(*query, map_bounds)
    }
    if query.error != "" { return Failure(query.error) }
    if name == "validate" { print("{\"valid\":1}\n"); return 0 }
    database: *void
    if SqliteOpenText(TextFromCString(argv[1]),*database,1) != SQLITE_OK { if database != null { unused SqliteClose(database) }; return Failure("Cannot open the private gallery database") }
    defer { unused SqliteClose(database) }
    if !Geo.Register(database) { return Failure("Cannot initialize local radius search") }
    if slideshow && !Presentation.Register(database) { return Failure("Cannot initialize slideshow ordering") }
    if name == "semantic" {
        tensor: [4097]u8
        if !Decode(json,"semantic_tensor",tensor[:]) || tensor[0] == 0 || !Semantic.Register(database,TextUntilNul(tensor[:])) { return Failure("Cannot read the local semantic search query") }
        Search.AddSQL(*query," AND kind='photo' AND hidden=0 AND trashed=0 AND ")
        Search.AddSQL(*query,Semantic.RankSQL); Search.AddSQL(*query," >= 0.20")
    }
    unused SqliteBusyTimeout(database,10000)
    if !Guest.Populate(*guest,database) { return Failure("Cannot read Guest view selection") }
    if SqliteExecText(database,"BEGIN") != SQLITE_OK { return Failure("Cannot open a gallery snapshot") }
    defer { unused SqliteExecText(database,"ROLLBACK") }
    lane_years: [256]s32; lane_count: s32; lane_year := Number(json,"lane_year",0)
    if name == "lane" {
        copy: Vec(u8); for i: 0..query.sql.count-1 { unused VecPush(copy,query.sql[i]) }
        initial := BuilderFinish(copy); years: Vec(u8)
        BuilderPrint(*years,"SELECT cast(strftime('%',taken,'unixepoch') AS INTEGER) y FROM photos WHERE % GROUP BY y HAVING count(*)>=4 ORDER BY y","%Y",initial)
        statement: *void
        if !Prepare(database,BuilderFinish(years),*query,*statement) { return Failure("Cannot prepare Memory Lane") }
        while true {
            result := SqliteStep(statement)
            if result == SQLITE_DONE { break }
            if result != SQLITE_ROW || lane_count >= 256 { unused SqliteFinalize(statement); return Failure("Cannot read Memory Lane years") }
            lane_years[lane_count] = cast(s32)SqliteColumnInt64(statement,0); lane_count += 1
        }
        unused SqliteFinalize(statement)
        if lane_count < 2 { lane_count = 0; lane_year = 0; Search.AddSQL(*query," AND 0") }
        else {
            if lane_year == 0 { lane_year = lane_years[0] }
            valid: bool; for i: 0..lane_count-1 { if lane_years[i] == lane_year { valid = true } }
            if !valid { lane_year = lane_years[0] }
            if slideshow {
                Search.AddSQL(*query," AND cast(strftime('%Y',taken,'unixepoch') AS INTEGER) IN (")
                for i: 0..lane_count-1 { BuilderPrint(*query.sql,"% %",ifx i == 0 then "" else ",",lane_years[i]) }
                Search.AddSQL(*query,")")
            } else { Search.AddSQL(*query," AND cast(strftime('%Y',taken,'unixepoch') AS INTEGER)=?"); Search.BindNumber(*query,cast(s64)lane_year) }
        }
    }
    where := BuilderFinish(query.sql)
    sql: Vec(u8); BuilderPrint(*sql,"SELECT COUNT(*) FROM photos WHERE %",where); count_sql := BuilderFinish(sql)
    statement: *void
    if !Prepare(database,count_sql,*query,*statement) { return Failure("Cannot prepare the gallery query") }
    if SqliteStep(statement) != SQLITE_ROW { unused SqliteFinalize(statement); return Failure("Cannot count gallery matches") }
    matches := SqliteColumnInt64(statement,0); unused SqliteFinalize(statement); statement = null
    if slideshow { page = ifx matches > 0 then cast(s32)(cast(s64)page % matches) else 0; limit = 1 }
    if !guest.active && jump[0] != 0 {
        day := Search.Date(TextUntilNul(jump[:]))
        if day < 0 || name == "semantic" || name == "map" || name == "lane" { return Failure("Choose a gallery date in YYYY-MM-DD format") }
        jump_sql: Vec(u8); BuilderPrint(*jump_sql,"SELECT count(*) FROM photos WHERE % AND taken%?",where,ifx order == "newest" then ">=" else "<")
        Search.BindNumber(*query,day + (ifx order == "newest" then 86400 else 0))
        if !Prepare(database,BuilderFinish(jump_sql),*query,*statement) { return Failure("Cannot jump to the gallery date") }
        if SqliteStep(statement) != SQLITE_ROW { unused SqliteFinalize(statement); return Failure("Cannot locate the gallery date") }
        target := SqliteColumnInt64(statement,0); unused SqliteFinalize(statement); statement = null; query.count -= 1
        if matches == 0 { page = 0 } else { page = cast(s32)(ifx target >= matches then matches-1 else target) }
    }
    rows: Vec(u8); BuilderPrint(*rows,"SELECT id FROM photos WHERE %",where)
    check: [65]u8
    if slideshow && !Decode(json,"slide_id",check[:]) { return Failure("Choose a valid slideshow photo") }
    if check[0] != 0 { BuilderPrint(*rows," AND id=?"); Search.Bind(*query,TextUntilNul(check[:])); page = 0 }
    BuilderPrint(*rows," ORDER BY ")
    if guest.active && guest.selection { BuilderPrint(*rows,"(SELECT ordinal FROM guest_selection g WHERE g.id=photos.id) ASC,") }
    if slideshow && Number(json,"slide_shuffle",0) == 1 { BuilderPrint(*rows,"photos_order(id,%) ASC,",Number(json,"slide_seed",1)) }
    if name == "semantic" { BuilderPrint(*rows,"% DESC,",Semantic.RankSQL) }
    BuilderPrint(*rows,"taken %,id LIMIT % OFFSET %",ifx order == "newest" then "DESC" else "ASC",limit,page)
    rows_sql := BuilderFinish(rows)
    if !Prepare(database,rows_sql,*query,*statement) { return Failure("Cannot prepare the gallery page") }
    defer { unused SqliteFinalize(statement) }
    output: Vec(u8); BuilderPrint(*output,"{\"count\":%,\"memory_date\":\"%\",\"ids\":[",matches,TextUntilNul(memory[:]))
    count: s32
    while true {
        result := SqliteStep(statement)
        if result == SQLITE_DONE { break }
        if result != SQLITE_ROW { return Failure("Cannot read the gallery page") }
        id := TextFromCString(SqliteColumnText(statement,0))
        if id.count != 64 { return Failure("Gallery contains an invalid photo identity") }
        for byte: id { if !(byte >= 48 && byte <= 57 || byte >= 97 && byte <= 102) { return Failure("Gallery contains an invalid photo identity") } }
        BuilderPrint(*output,"%\"%\"",ifx count == 0 then "" else ",",id); count += 1
    }
    BuilderPrint(*output,"]")
    if slideshow { BuilderPrint(*output,",\"slide_offset\":%",page) }
    if !guest.active && jump[0] != 0 { BuilderPrint(*output,",\"jump_offset\":%",page) }
    if name == "lane" {
        current: [11]u8; unused WriteIsoDay(Clock.UnixNow(),current[:])
        BuilderPrint(*output,",\"lane_year\":%,\"current_year\":%,\"lane_years\":[",lane_year,DateNumber(TextUntilNul(current[:]),0,4))
        for i: 0..lane_count-1 { BuilderPrint(*output,"% %",ifx i == 0 then "" else ",",lane_years[i]) }; BuilderPrint(*output,"]")
    }
    if name == "map" && Number(json, "map_gallery", 0) == 0 {
        unused SqliteFinalize(statement); statement = null
        cluster_sql := Locations.ClusterSQL(where, map_bounds)
        if !Prepare(database, cluster_sql, *query, *statement) { return Failure("Cannot prepare map locations") }
        BuilderPrint(*output,",\"markers\":["); marker_count: s32
        while true {
            result := SqliteStep(statement)
            if result == SQLITE_DONE { break }
            if result != SQLITE_ROW || marker_count >= 96 { return Failure("Cannot read map locations") }
            BuilderPrint(*output,"%{\"count\":%,\"longitude\":%,\"latitude\":%,\"bounds\":[%,%,%,%]}",ifx marker_count == 0 then "" else ",",SqliteColumnInt64(statement,0),SqliteColumnInt64(statement,1),SqliteColumnInt64(statement,2),SqliteColumnInt64(statement,3),SqliteColumnInt64(statement,4),SqliteColumnInt64(statement,5),SqliteColumnInt64(statement,6))
            marker_count += 1
        }
        BuilderPrint(*output,"]")
    }
    BuilderPrint(*output,"}"); response := BuilderFinish(output); print("%\n",response); return 0
}
