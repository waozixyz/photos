// Private pipe adapter for Daochi's canonical v6 transaction builder/signers.
// Existing account and device keys are supplied, never generated or stored.
Wire :: #import "sync_crypto";
Sign :: #import "sync_sign";
Native :: #import "daochi_client/crypto_native";
AccountRequest :: #import "sync_account";
#import "std/byte_text_linux"
#import "std/text_buffer"
c :: #system_library "c";
Read :: (fd: s32, bytes: *u8, count: usize) -> s64 #foreign c "read";
main :: () -> s32 {
    // version, method (GET/POST/PUT/HEAD/DELETE), path length and Unix expiration.
    frame: [12]u8
    if !Wire.ReadAll(*frame[0],12) { return 2 }
    if frame[0] == 2 {
        account_frame: [16]u8
        for index: 0..11 { account_frame[index] = frame[index] }
        if !Wire.ReadAll(*account_frame[12], 4) { return 2 }
        return AccountRequest.Prepare(account_frame[:])
    }
    if frame[0]!=1 || frame[1]<1 || frame[1]>5 { return 2 }
    count:=cast(s64)Wire.Number(frame[2:4])
    expires: u64
    for byte: frame[4:] { expires=(expires<<8)|cast(u64)byte }
    if count<1 || count>1024 || expires<1 || expires>cast(u64)9223372036854775807 { return 2 }
    public_key: [1312]u8; private_key: [2560]u8; seed: [32]u8; digest: [32]u8; path: [1024]u8
    defer { Native.Clear(private_key[:]); Native.Clear(seed[:]) }
    if !Wire.ReadAll(*public_key[0],1312) || !Wire.ReadAll(*private_key[0],2560) ||
        !Wire.ReadAll(*seed[0],32) || !Wire.ReadAll(*digest[0],32) || !Wire.ReadAll(*path[0],count) { return 2 }
    extra: u8
    if Read(0,*extra,1)!=0 { return 2 }
    header: [8192]u8
    if !Sign.Header(public_key[:],private_key[:],seed[:],frame[1],TextFromBytes(path[:count]),digest[:],cast(s64)expires,header[:]) { return 2 }
    text:=TextUntilNul(header[:]); descriptor:=cast(*TextDescriptor)*text
    return ifx Wire.SendAll(descriptor.data,text.count) then 0 else 2
}
