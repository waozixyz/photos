// Private pipe adapter for Daochi's canonical v6 transaction builder/signers.
// Existing account and device keys are supplied, never generated or stored.
Wire :: #import "sync_crypto";
Protocol :: #import "daochi_client/transaction";
Keys :: #import "daochi_client/keys";
Crypto :: #import "daochi_client/crypto";
Native :: #import "daochi_client/crypto_native";
#import "std/byte_text_linux"
#import "std/text_buffer"
c :: #system_library "c";
Read :: (fd: s32, bytes: *u8, count: usize) -> s64 #foreign c "read";
Hex :: (input: []u8, output: []u8) -> bool {
    return output.count > 0 && Crypto.BytesToHex(*input[0],input.count,*output[0],output.count)!=0
}
main :: () -> s32 {
    // version, method (GET/POST/PUT/HEAD), path length and Unix expiration.
    frame: [12]u8
    if !Wire.ReadAll(*frame[0],12) || frame[0]!=1 || frame[1]<1 || frame[1]>4 { return 2 }
    count:=cast(s64)Wire.Number(frame[2:4])
    expires: u64
    for byte: frame[4:] { expires=(expires<<8)|cast(u64)byte }
    if count<1 || count>1024 || expires<1 || expires>cast(u64)9223372036854775807 { return 2 }
    public_key: [1312]u8; private_key: [2560]u8; seed: [32]u8; digest: [32]u8; path: [1024]u8
    account: Keys.AccountKeys
    defer { Native.Clear(private_key[:]); Native.Clear(seed[:]); Native.Clear(BytesFromPointer(cast(*u8)*account,size_of(Keys.AccountKeys))) }
    if !Wire.ReadAll(*public_key[0],1312) || !Wire.ReadAll(*private_key[0],2560) ||
        !Wire.ReadAll(*seed[0],32) || !Wire.ReadAll(*digest[0],32) || !Wire.ReadAll(*path[0],count) { return 2 }
    extra: u8
    if Read(0,*extra,1)!=0 { return 2 }
    Crypto.Sha256Hex(*public_key[0],1312,*account.public_id[0])
    if !Hex(public_key[:],account.public_key_hex[:]) || !Hex(private_key[:],account.private_key_hex[:]) { return 2 }
    device_public: [32]u8; device_id: [65]u8; hash: [65]u8; nonce: [32]u8; tx_id: [32]u8
    nonce_text: [65]u8; tx_text: [65]u8
    if !Native.DevicePublic(seed[:],device_public[:]) || !Native.RandomBytes(nonce[:]) || !Native.RandomBytes(tx_id[:]) ||
        !Hex(digest[:],hash[:]) || !Hex(nonce[:],nonce_text[:]) || !Hex(tx_id[:],tx_text[:]) { return 2 }
    Crypto.Sha256Hex(*device_public[0],32,*device_id[0])
    transaction: Protocol.SyncTransaction
    transaction.account_id=TextUntilNul(account.public_id[:]); transaction.app_id="photos"
    transaction.device_key_id=TextUntilNul(device_id[:]); transaction.tx_id=TextUntilNul(tx_text[:])
    transaction.nonce=TextUntilNul(nonce_text[:]); transaction.body_sha256_hex=TextUntilNul(hash[:]); transaction.expires_at=cast(s64)expires
    methods: [4]string=.{"GET","POST","PUT","HEAD"}
    method:=methods[frame[1]-1]; target:=TextFromBytes(path[:count])
    message: [2048]u8; header: [8192]u8; signature: [4841]u8; device_signature: [64]u8; device_text: [129]u8
    if !Protocol.BuildTransactionMessage(transaction,method,target,message[:]) { return 2 }
    text:=TextUntilNul(message[:]); descriptor:=cast(*TextDescriptor)*text
    if !Keys.SignAccountMessage(cast(*void)*account,text,signature[:]) ||
        !Native.SignDevice(seed[:],BytesFromPointer(descriptor.data,cast(u64)text.count),device_signature[:]) ||
        !Hex(device_signature[:],device_text[:]) ||
        !Protocol.BuildTransactionHeader(transaction,method,target,TextUntilNul(signature[:]),TextUntilNul(device_text[:]),header[:]) { return 2 }
    text=TextUntilNul(header[:]); descriptor=cast(*TextDescriptor)*text
    return ifx Wire.SendAll(descriptor.data,text.count) then 0 else 2
}
