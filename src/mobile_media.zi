// Android provides only the MediaStore rows currently granted to this app.
// UTF-8 metadata crosses JNI as bytes, never modified-UTF-8 or image bodies.
using JNI :: #import "kryon/AndroidJni";
Clock :: #import "kryon/ClockLinux";
#import "std/byte_text_linux"
#import "std/json_scan"
#import "std/text_buffer"
#if #defined(PHOTOS_VERIFY) {
    BackupVerify :: #import "backup_crypto_test";
    crypto_checked: bool;
}
Photo :: struct { id: [32]u8; name: [1025]u8; date: [32]u8; folder: [1025]u8; image: [4097]u8; video: bool; size: s64; width: s32; height: s32 }
Album :: struct { id: [32]u8; name: [1025]u8; count: s32 }
photos: [30]Photo; albums: [30]Album;
count: s32; album_count: s32; permission_bits: s32; page: s32; total: s32; more: bool; loading: bool;
selected: s64 = -1; generation: s64; revision: s64; view: [16]u8; album: [32]u8; status: [257]u8;
lock_enabled: bool; locked: bool; hide_content: bool; auth_pending: bool; device_secure: bool;
security_status: [257]u8;
backup_configured: bool; backup_ready: bool; backup_pending: bool; recovery_selected: bool;
backup_status: [257]u8;
backup_queue_status: [257]u8; backup_folder_selected: bool; backup_scanning: bool;
backup_folder_count: s32; backup_queued: s32; backup_paused: s32;
backup_prepared: s32; backup_preparing: bool; backup_uploading: bool; backup_confirmed: s32;
typeface: [4097]u8;
last_poll: float64 = -1.0;
Number :: (json: string, at: s32, name: string) -> s64 {
    parsed:=ReadNumber(json,FieldAt(json,at,name)); return ifx parsed.valid then cast(s64)parsed.value else 0
}
Read :: (json: string, at: s32, name: string, out: []u8) { unused ReadStringText(json,FieldAt(json,at,name),out) }
Clear :: () {
    count=0; album_count=0; selected=-1; total=0; more=false; loading=false; permission_bits=0
    for i: 0..29 { photos[i]=Photo.{}; albums[i]=Album.{} }
}
Poll :: () {
    now:=cast(float64)Clock.Milliseconds(); if last_poll>=0.0 && now-last_poll<150.0 { return }; last_poll=now
    session: AndroidJniSession
    if AndroidJniAttachCurrent(*session)==0 { Clear(); return }; defer { AndroidJniDetachCurrent(*session) }
    method:=AndroidJniMethod(*session,"galleryState","()[B"); if method==null { Clear(); return }
    response:=session.env.functions.CallObjectMethodA(session.env,session.activity,method,null)
    if response==null || session.env.functions.ExceptionCheck(session.env)!=0 { Clear(); return }
    length:=session.env.functions.GetArrayLength(session.env,response)
    if length<2 || length>262144 { Clear(); return }
    bytes: [262145]u8; session.env.functions.GetByteArrayRegion(session.env,response,0,length,*bytes[0])
    if session.env.functions.ExceptionCheck(session.env)!=0 { Clear(); return }
    json:=TextFromBytes(bytes[:length]); if ValueEnd(json,0,0)!=length { Clear(); return }
    Read(json,0,"typeface",typeface[:])
    nextGeneration:=Number(json,0,"generation"); nextCount:=cast(s32)Number(json,0,"total")
    wasLoading:=loading
    Clear(); generation=nextGeneration; total=nextCount
    permission_bits=cast(s32)Number(json,0,"access"); page=cast(s32)Number(json,0,"page"); loading=Number(json,0,"loading")!=0; more=Number(json,0,"more")!=0
    selected=Number(json,0,"selected"); Read(json,0,"view",view[:]); Read(json,0,"album",album[:]); Read(json,0,"status",status[:])
    lock_enabled=Number(json,0,"lock_enabled")!=0; locked=Number(json,0,"locked")!=0; hide_content=Number(json,0,"hide_content")!=0
    auth_pending=Number(json,0,"auth_pending")!=0; device_secure=Number(json,0,"device_secure")!=0
    Read(json,0,"security_status",security_status[:])
    backup_configured=Number(json,0,"backup_configured")!=0; backup_ready=Number(json,0,"backup_ready")!=0
    backup_pending=Number(json,0,"backup_pending")!=0; recovery_selected=Number(json,0,"recovery_selected")!=0
    Read(json,0,"backup_status",backup_status[:])
    Read(json,0,"backup_queue_status",backup_queue_status[:])
    backup_folder_selected=Number(json,0,"backup_folder_selected")!=0; backup_scanning=Number(json,0,"backup_scanning")!=0
    backup_folder_count=cast(s32)Number(json,0,"backup_folder_count"); backup_queued=cast(s32)Number(json,0,"backup_queued"); backup_paused=cast(s32)Number(json,0,"backup_paused")
    backup_prepared=cast(s32)Number(json,0,"backup_prepared"); backup_preparing=Number(json,0,"backup_preparing")!=0
    backup_uploading=Number(json,0,"backup_uploading")!=0; backup_confirmed=cast(s32)Number(json,0,"backup_confirmed")
    items:=FieldAt(json,0,"photos"); groups:=FieldAt(json,0,"albums")
    for i: 0..29 {
        at:=ElementAt(json,items,cast(s32)i); if at<0 { break }
        Read(json,at,"id",photos[i].id[:]); Read(json,at,"name",photos[i].name[:]); Read(json,at,"date",photos[i].date[:]); Read(json,at,"folder",photos[i].folder[:]); Read(json,at,"image",photos[i].image[:])
        photos[i].video=Number(json,at,"video")!=0; photos[i].size=Number(json,at,"size"); photos[i].width=cast(s32)Number(json,at,"width"); photos[i].height=cast(s32)Number(json,at,"height")
        count+=1
    }
    for i: 0..29 {
        at:=ElementAt(json,groups,cast(s32)i); if at<0 { break }
        Read(json,at,"id",albums[i].id[:]); Read(json,at,"name",albums[i].name[:]); albums[i].count=cast(s32)Number(json,at,"count"); album_count+=1
    }
    if wasLoading!=loading { revision+=1 }
    if count==0 { selected=-1 }
    #if #defined(PHOTOS_VERIFY) {
        if !crypto_checked {
            crypto_checked=true
            check:=AndroidJniMethod(*session,"onBackupCryptoChecked","(I)V")
            if check!=null {
                arguments: [1]JniValue; arguments[0].integer=BackupVerify.Answer()
                session.env.functions.CallVoidMethodA(session.env,session.activity,check,*arguments[0])
            }
        }
        // Instrumentation compares the native parser's bytes with MediaStore;
        // release clients do not include this probe or print photo metadata.
        probe:=AndroidJniMethod(*session,"onGalleryRenderedName","([B)V")
        if probe!=null {
            native_name:=ifx selected>=0 && count>0 then TextFromCString(*photos[0].name[0]) else ""
            array:=session.env.functions.NewByteArray(session.env,cast(s32)native_name.count)
            if array!=null {
                if native_name.count>0 { session.env.functions.SetByteArrayRegion(session.env,array,0,cast(s32)native_name.count,*photos[0].name[0]) }
                arguments: [1]JniValue; arguments[0].reference=array
                session.env.functions.CallVoidMethodA(session.env,session.activity,probe,*arguments[0])
            }
        }
    }
}
Request :: (action: string, value: string = "", number: s32 = 0) {
    session: AndroidJniSession; if AndroidJniAttachCurrent(*session)==0 { return }; defer { AndroidJniDetachCurrent(*session) }
    out: Vec(u8); BuilderPrint(*out,"{\"action\":\"%\",\"view\":\"%\",\"id\":\"%\",\"page\":%}",action,value,value,number)
    text:=BuilderFinish(out); bytes: [513]u8; if text.count>=512 { return }
    for i: 0..text.count-1 { bytes[i]=text[i] }; bytes[text.count]=0
    unused AndroidJniCallVoid(*session,"galleryAction",*bytes[0]); last_poll=-1.0; Poll()
}
Restore :: (password: string) {
    if password.count<12 || password.count>1024 || backup_pending || backup_configured || !recovery_selected || locked { return }
    session: AndroidJniSession; if AndroidJniAttachCurrent(*session)==0 { return }; defer { AndroidJniDetachCurrent(*session) }
    method:=AndroidJniMethod(*session,"restoreBackup","([B)V"); if method==null { return }
    array:=session.env.functions.NewByteArray(session.env,cast(s32)password.count)
    if array==null { return }
    bytes: [1024]u8; for i: 0..password.count-1 { bytes[i]=password[i] }
    session.env.functions.SetByteArrayRegion(session.env,array,0,cast(s32)password.count,*bytes[0])
    for i: 0..1023 { bytes[i]=0 }
    if session.env.functions.ExceptionCheck(session.env)!=0 { return }
    args: [1]JniValue; args[0].reference=array
    session.env.functions.CallVoidMethodA(session.env,session.activity,method,*args[0]); last_poll=-1.0
}
