// Portable gallery gesture policy. Selection identities stay with Photos;
// this module owns activation, cancellation and bounded edge scrolling.
State :: struct {
    pending: bool; active: bool; anchor: s32; remove: bool;
    x: float32; y: float32; last_time: s64; remainder: float32
}
Decision :: struct { began: bool; claimed: bool; finished: bool; canceled: bool; scroll: s32 }
Reset :: (state: *State) { state.* = .{} }
Absolute :: (value: float32) -> float32 { return ifx value < 0.0 then -value else value }
Update :: (state: *State, eligible: bool, hit: s32, selected: bool,
    x: float32, y: float32, pressed: bool, down: bool, released: bool,
    now: s64, top: float32, height: float32, inside_x: bool) -> Decision {
    result: Decision
    if !eligible || now < 0 || (state.pending && now < state.last_time) {
        result.canceled = state.pending; result.claimed = state.active; Reset(state); return result
    }
    if pressed {
        Reset(state)
        if hit < 0 || !down { return result }
        state.pending = true; state.anchor = hit; state.remove = selected
        state.x = x; state.y = y; state.last_time = now; result.began = true
    }
    if !state.pending { return result }
    if !down && !released {
        result.canceled = true; result.claimed = state.active; Reset(state); return result
    }
    dx := Absolute(x-state.x); dy := Absolute(y-state.y)
    if !state.active {
        // A click keeps its ordinary action. Dragging a thumbnail selects in
        // any direction, including the very first selection in the gallery.
        if dx >= 12.0 || dy >= 12.0 { state.active = true }
    }
    result.claimed = state.active
    elapsed := now-state.last_time; state.last_time = now
    if elapsed > 50 { elapsed = 50 }
    if state.active && down && inside_x && height > 0.0 {
        edge: float32 = 48.0; if edge > height/3.0 { edge = height/3.0 }
        speed: float32
        if y < top+edge { speed = -(top+edge-y)/edge }
        else if y > top+height-edge { speed = (y-top-height+edge)/edge }
        if speed < -1.0 { speed = -1.0 }; if speed > 1.0 { speed = 1.0 }
        state.remainder += speed*700.0*cast(float32)elapsed/1000.0
        result.scroll = cast(s32)state.remainder; state.remainder -= cast(float32)result.scroll
    }
    if released { result.finished = true; state.pending = false; state.active = false }
    return result
}
