// Recovery-file encryption through private pipes. Passwords and account keys
// never enter arguments, diagnostics or temporary files.
Wire :: #import "sync_crypto";
UTF8 :: #import "std/utf8";
#import "std/byte_text_linux"
c :: #system_library "c";
Native :: #import "daochi_client/crypto_native";
Allocate :: (size: usize) -> *void #foreign c "malloc";
Read :: (fd: s32, bytes: *u8, count: usize) -> s64 #foreign c "read";
main :: () -> s32 {
    // version, mode, password bytes, payload bytes, salt, nonce (network order).
    header: [48]u8; password: [1024]u8; key: [32]u8
    defer { Native.Clear(header[:]); Native.Clear(password[:]); Native.Clear(key[:]) }
    if !Native.Initialize() || !Wire.ReadAll(*header[0],48) || header[0] != 1 || (header[1] != 1 && header[1] != 2) { return 2 }
    size := cast(s64)Wire.Number(header[4:8]); passwordSize := cast(s64)Wire.Number(header[2:4])
    if size < 1 || size > 65552 || passwordSize < 12 || passwordSize > 1024 || (header[1] == 2 && size < 17) || (header[1] == 1 && size > 65536) { return 2 }
    if header[1] == 1 { for i: 8..47 { if header[i] != 0 { return 2 } } }
    if !Wire.ReadAll(*password[0],passwordSize) || !UTF8.Valid(TextFromBytes(password[:passwordSize])) { return 2 }
    characters: s64
    for i: 0..passwordSize-1 { if password[i] == 0 { return 2 }; if (password[i] & 192) != 128 { characters += 1 } }
    if characters < 12 { return 2 }
    input := cast(*u8)Allocate(cast(usize)size); output := cast(*u8)Allocate(cast(usize)(size+16))
    defer { Wire.Free(input,size); Wire.Free(output,size+16) }
    extra: u8
    if input == null || output == null || !Wire.ReadAll(input,size) || Read(0,*extra,1) != 0 { return 2 }
    if header[1] == 1 { if !Native.RandomBytes(header[8:24]) || !Native.RandomBytes(header[24:]) { return 2 } }
    // Argon2id v1.3: fixed format parameters, 3 passes and 64 MiB. The reader
    // never accepts KDF work factors from an untrusted recovery file.
    if !Native.DerivePassword(password[:passwordSize],header[8:24],key[:],3,67108864) { return 2 }
    aad: [18]u8 = .{112,104,111,116,111,115,45,114,101,99,111,118,101,114,121,45,118,49}
    bytes:=BytesFromPointer(input,cast(u64)size); result:=BytesFromPointer(output,cast(u64)(size+16))
    if header[1] == 2 {
        count:=Native.Open(bytes,aad[:],key[:],header[24:],result)
        if count < 0 { return 1 }
        if count != size-16 { return 2 }
        return ifx Wire.SendAll(output,count) then 0 else 2
    }
    count:=Native.Seal(bytes,aad[:],key[:],header[24:],result)
    if count != size+16 { return 2 }
    return ifx Wire.SendAll(*header[8],40) && Wire.SendAll(output,count) then 0 else 2
}
