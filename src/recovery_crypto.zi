// Recovery-file encryption through private pipes. Passwords and account keys
// never enter arguments, diagnostics or temporary files.
Wire :: #import "sync_crypto";
UTF8 :: #import "std/utf8";
#import "std/byte_text_linux"
c :: #system_library "c";
sodium :: #system_library "sodium";
Allocate :: (size: usize) -> *void #foreign c "malloc";
Read :: (fd: s32, bytes: *u8, count: usize) -> s64 #foreign c "read";
Init :: () -> s32 #foreign sodium "sodium_init";
Random :: (bytes: *void, count: usize) #foreign sodium "randombytes_buf";
Wipe :: (bytes: *void, count: usize) #foreign sodium "sodium_memzero";
Derive :: (output: *u8, count: u64, password: *u8, passwordCount: u64, salt: *u8,
    operations: u64, memory: usize, algorithm: s32) -> s32 #foreign sodium "crypto_pwhash";
Encrypt :: (output: *u8, count: *u64, input: *u8, size: u64, aad: *u8, aadSize: u64,
    secret: *u8, nonce: *u8, key: *u8) -> s32 #foreign sodium "crypto_aead_xchacha20poly1305_ietf_encrypt";
Decrypt :: (output: *u8, count: *u64, secret: *u8, input: *u8, size: u64, aad: *u8,
    aadSize: u64, nonce: *u8, key: *u8) -> s32 #foreign sodium "crypto_aead_xchacha20poly1305_ietf_decrypt";
main :: () -> s32 {
    // version, mode, password bytes, payload bytes, salt, nonce (network order).
    header: [48]u8; password: [1024]u8; key: [32]u8
    defer { Wipe(cast(*void)*header[0],48); Wipe(cast(*void)*password[0],1024); Wipe(cast(*void)*key[0],32) }
    if Init() < 0 || !Wire.ReadAll(*header[0],48) || header[0] != 1 || (header[1] != 1 && header[1] != 2) { return 2 }
    size := cast(s64)Wire.Number(header[4:8]); passwordSize := cast(s64)Wire.Number(header[2:4])
    if size < 1 || size > 65552 || passwordSize < 12 || passwordSize > 1024 || (header[1] == 2 && size < 17) || (header[1] == 1 && size > 65536) { return 2 }
    if header[1] == 1 { for i: 8..47 { if header[i] != 0 { return 2 } } }
    if !Wire.ReadAll(*password[0],passwordSize) || !UTF8.Valid(TextFromBytes(password[:passwordSize])) { return 2 }
    characters: s64
    for i: 0..passwordSize-1 { if password[i] == 0 { return 2 }; if (password[i] & 192) != 128 { characters += 1 } }
    if characters < 12 { return 2 }
    input := cast(*u8)Allocate(cast(usize)size); output := cast(*u8)Allocate(cast(usize)(size+16))
    defer { Wire.Free(input,size); Wire.Free(output,size+16) }
    extra: u8
    if input == null || output == null || !Wire.ReadAll(input,size) || Read(0,*extra,1) != 0 { return 2 }
    if header[1] == 1 { Random(cast(*void)*header[8],16); Random(cast(*void)*header[24],24) }
    // Argon2id v1.3: fixed format parameters, 3 passes and 64 MiB. The reader
    // never accepts KDF work factors from an untrusted recovery file.
    if Derive(*key[0],32,*password[0],cast(u64)passwordSize,*header[8],3,67108864,2) != 0 { return 2 }
    aad: [18]u8 = .{112,104,111,116,111,115,45,114,101,99,111,118,101,114,121,45,118,49}
    count: u64
    if header[1] == 2 {
        if Decrypt(output,*count,null,input,cast(u64)size,*aad[0],18,*header[24],*key[0]) != 0 { return 1 }
        if count != cast(u64)(size-16) { return 2 }
        return ifx Wire.SendAll(output,cast(s64)count) then 0 else 2
    }
    if Encrypt(output,*count,input,cast(u64)size,*aad[0],18,null,*header[24],*key[0]) != 0 || count != cast(u64)(size+16) { return 2 }
    return ifx Wire.SendAll(*header[8],40) && Wire.SendAll(output,cast(s64)count) then 0 else 2
}
