// Private pipe adaptation of canonical Mesh account request preparation.
// Account/device keys and their persistent storage remain with the caller.
#scope_module
Wire :: #import "sync_crypto";
Sign :: #import "sync_sign";
Native :: #import "mesh_client/crypto_native";
#import "std/byte_text_linux"
#import "std/text_buffer"
using Vectors :: #import "std/vec";
c :: #system_library "c";
Read :: (fd: s32, bytes: *u8, count: usize) -> s64 #foreign c "read";

Send :: (body: string, signature: string) -> bool {
    counts: [8]u8
    for index: 0..3 {
        shift := cast(u32)((3 - index) * 8)
        counts[index] = cast(u8)(cast(u32)body.count >> shift)
        counts[index + 4] = cast(u8)(cast(u32)signature.count >> shift)
    }
    body_pointer := cast(*TextDescriptor)*body
    signature_pointer := cast(*TextDescriptor)*signature
    return Wire.SendAll(*counts[0], 8) && Wire.SendAll(body_pointer.data, body.count) &&
        Wire.SendAll(signature_pointer.data, signature.count)
}

#scope_export
// Caller-owned outputs must be distinct and must not alias any input storage.
// Failure wipes both outputs, including retained vector capacity.
LoginRequest :: (public: []u8, private: []u8, client: string, challenge: string,
    body: *Vec(u8), signature: *Vec(u8)) -> bool {
    Wire.ClearOutput(body); Wire.ClearOutput(signature)
    if body==null || signature==null || body==signature { return false }
    json: [6144]u8; proof: [4841]u8
    defer { Native.Clear(json[:]); Native.Clear(proof[:]) }
    if !Sign.Login(public,private,client,challenge,json[:],proof[:]) { return false }
    text:=TextUntilNul(json[:]); signed:=TextUntilNul(proof[:])
    if !Wire.PrepareOutput(body,text.count) || !Wire.PrepareOutput(signature,signed.count) {
        Wire.ClearOutput(body); Wire.ClearOutput(signature); return false
    }
    b:=Wire.OutputBytes(body); s:=Wire.OutputBytes(signature)
    for i: 0..text.count-1 { b[i]=text[i] }; for i: 0..signed.count-1 { s[i]=signed[i] }
    return true
}

// The output must not alias input storage; keys remain with the caller.
RegistrationRequest :: (public: []u8, private: []u8, seed: []u8, client: string,
    now: s64, body: *Vec(u8)) -> bool {
    Wire.ClearOutput(body)
    json: [6144]u8; defer { Native.Clear(json[:]) }
    if !Sign.Registration(public,private,seed,client,now,json[:]) { return false }
    text:=TextUntilNul(json[:]); if !Wire.PrepareOutput(body,text.count) { return false }
    result:=Wire.OutputBytes(body); for i: 0..text.count-1 { result[i]=text[i] }; return true
}

Prepare :: (frame: []u8) -> s32 {
    if frame.count != 16 || frame[0] != 2 || (frame[1] != 1 && frame[1] != 2) { return 2 }
    client_count := cast(s64)Wire.Number(frame[2:4])
    challenge_count := cast(s64)Wire.Number(frame[4:8])
    now: u64
    for byte: frame[8:] { now = (now << 8) | cast(u64)byte }
    if client_count < 1 || client_count > 128 || challenge_count > 4096 ||
        (frame[1] == 1 && (challenge_count < 1 || now != 0)) ||
        (frame[1] == 2 && (challenge_count != 0 || now < 1 || now > 9007199254740691)) { return 2 }
    public_key: [1312]u8
    private_key: [2560]u8
    seed: [32]u8
    client_id: [128]u8
    challenge: [4096]u8
    defer {
        Native.Clear(private_key[:])
        Native.Clear(seed[:])
    }
    if !Wire.ReadAll(*public_key[0], 1312) || !Wire.ReadAll(*private_key[0], 2560) ||
        !Wire.ReadAll(*seed[0], 32) || !Wire.ReadAll(*client_id[0], client_count) ||
        !Wire.ReadAll(*challenge[0], challenge_count) { return 2 }
    extra: u8
    if Read(0, *extra, 1) != 0 { return 2 }
    body: Vec(u8); signature: Vec(u8)
    defer { Wire.ClearOutput(*body); Wire.ClearOutput(*signature) }
    client := TextFromBytes(client_id[:client_count])
    prepared: bool
    if frame[1] == 1 {
        prepared = LoginRequest(public_key[:], private_key[:], client, TextFromBytes(challenge[:challenge_count]), *body, *signature)
    } else {
        prepared = RegistrationRequest(public_key[:], private_key[:], seed[:], client, cast(s64)now, *body)
    }
    if !prepared { return 2 }
    return ifx Send(TextFromBytes(VecSlice(body,0,body.count)), TextFromBytes(VecSlice(signature,0,signature.count))) then 0 else 2
}
