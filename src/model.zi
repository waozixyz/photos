Transport :: #import "transport";
Playback :: #import "playback";
Crop :: #import "crop";
Viewer :: #import "viewer";
Map :: #import "map";
playback_id: [65]u8;
playback_path: [4097]u8;
playback_started: bool;
playback_request: bool;
playback_poll: s64;
playback_speed: s32 = 100;
playback_volume: s32 = 100;
playback_expanded: bool;
#import "std/json_scan"
#import "std/text"
#import "std/text_buffer"
#import "std/option"
#import "std/byte_text_linux"
#if #defined(POSIX_THREADS) {
libc :: #system_library "libc";
Free :: (memory: *void) #foreign libc "free";
Release :: (value: string) { descriptor := cast(*TextDescriptor)(*value); Free(cast(*void)descriptor.data) }
} else {
Release :: (value: string) {}
}

Photo :: struct {
    id: [65]u8
    name: [513]u8
    thumbnail: [4097]u8
    display: [4097]u8
    date: [32]u8
    kind: [16]u8
    favorite: bool
    hidden: bool
    trashed: bool
    archived: bool
    live: bool
    width: s32
    height: s32
}
Selection :: struct { id: [65]u8 }
Album :: struct { name: [513]u8; thumbnail: [4097]u8; count: s32; pinned: bool; archived: bool; smart: bool; place: bool }
place_name: [513]u8;
place_area: [257]u8;
picked: Vec(Selection);
picked_count: s32;
selecting: bool;
last_pick: s32 = -1;
editor: string;
editor_title: string;
editor_hint: string;
image_adjustments: [7]s32 = .{0, 0, 0, 100, 100, 100, 0};
video_adjustments: [4]s32;
video_duration: s32;
video_job: [33]u8;
video_poll: s64;
edit_preview: [4097]u8;
edit_session: [33]u8;
edit_width: s32;
edit_height: s32;
image_crop: [4]s32 = .{0, 0, 10000, 10000};
video_crop: [4]s32 = .{0, 0, 10000, 10000};
crop_candidate: [4]s32 = .{0, 0, 10000, 10000};
crop_previous: s32;
crop_dragging: bool;
crop_anchor_x: s32;
crop_anchor_y: s32;
memory_date: [11]u8;
vault_token: [65]u8;
vault_first: [1025]u8;
vault_configured: bool;
vault_unlocked: bool;
edit_value: [8193]u8;
detail_id: [65]u8;
detail_caption: [8193]u8;
detail_tags: [8193]u8;
detail_albums: [4097]u8;
detail_taken: [65]u8;
detail_location: [257]u8;
detail_size: s64;
detail_caption_editable: bool;
detail_tags_editable: bool;
mutation: bool;
photos: Vec(Photo);
count: s32;
total: s32;
matches: s32;
pending: s32;
catalog: Vec(Album);
album_count: s32;
album_mode: string = "active";
album_sort: string = "name";
album_description: [8193]u8;
album_filter: [513]u8;
album_pinned: bool;
album_archived: bool;
album_place: bool;
export_status: [1025]u8;
export_continuous: bool;
view: string = "photos";
sort: string = "newest";
album: [513]u8;
search: [513]u8;
input: [4097]u8;
message: [1025]u8;
summary: [257]u8;
selected: s32 = -1;
scroll: s32;
offset: s32;
feed_base: s32;
revision: s64;
loading: bool;
busy: bool;
appending: bool;
more_due: s64;
queued_view: s32 = -1;
queued_request: bool;
queued_action: [32]u8;
queued_id: [65]u8;
queued_value: [8193]u8;
initialized: bool;
next_refresh: s64;
ticks: s64;
cursor: s32;
anchor: s32;
focused: bool;
search_cursor: s32;
search_anchor: s32;
search_focused: bool;

Set :: (out: []u8, value: string) {
    n := cast(s32)value.count
    if n >= cast(s32)out.count { n = cast(s32)out.count - 1 }
    for i: 0..n - 1 { out[i] = value[i] }
    out[n] = 0
}
Quoted :: (out: *Vec(u8), value: string) {
    BuilderPrint(out, "\"")
    for i: 0..cast(s32)value.count - 1 {
        byte := value[i]
        if byte == 34 { BuilderPrint(out, "\\\"") }
        else if byte == 92 { BuilderPrint(out, "\\\\") }
        else if byte == 10 { BuilderPrint(out, "\\n") }
        else if byte < 32 {
            hex := "0123456789abcdef"; high := cast(s32)byte / 16; low := cast(s32)byte % 16
            BuilderPrint(out, "\\u00"); BuilderPrint(out, "%", hex[high:high + 1]); BuilderPrint(out, "%", hex[low:low + 1])
        }
        else if byte >= 32 { BuilderPrint(out, "%", value[i:i + 1]) }
    }
    BuilderPrint(out, "\"")
}
Property :: (out: *Vec(u8), key: string, value: string) { BuilderPrint(out, ",\"%\":", key); Quoted(out, value) }
Request :: (action: string = "query", id: string = "", value: string = "") {
    if loading { Set(queued_action[:], action); Set(queued_id[:], id); Set(queued_value[:], value); queued_request = true; return }
    SendRequest(action, id, value)
}
SendRequest :: (action: string, id: string, value: string) {
    playback_request = action == "playback_check"
    if action != "query" { offset = ifx selected >= 0 then (selected + feed_base) / 60 * 60 else feed_base; appending = false }
    out: Vec(u8)
    BuilderPrint(*out, "{\"gallery_format\":2,\"action\":"); Quoted(*out, action)
    Property(*out, "view", view); Property(*out, "search", TextUntilNul(search[:]))
    Property(*out, "album", TextUntilNul(album[:])); Property(*out, "id", id); Property(*out, "value", value)
    Property(*out, "sort", sort)
    Property(*out, "album_mode", album_mode); Property(*out, "album_sort", album_sort)
    Property(*out, "memory_date", TextUntilNul(memory_date[:]))
    Property(*out, "edit_session", TextUntilNul(edit_session[:]))
    Property(*out, "vault_token", TextUntilNul(vault_token[:]))
    Property(*out, "video_job", TextUntilNul(video_job[:]))
    if view == "map" {
        region := ifx Map.gallery then Map.gallery_bounds else Map.bounds
        BuilderPrint(*out, ",\"map_bounds\":[%,%,%,%],\"map_gallery\":%", region[0], region[1], region[2], region[3], ifx Map.gallery then 1 else 0)
    }
    mutation = action != "query" && action != "open" && action != "sync" && action != "import" && action != "image_preview" && action != "video_preview" && action != "video_begin" && action != "video_save" && action != "video_status" && action != "video_cancel" && action != "playback_check"
    if mutation && picked_count > 0 && (action == "album_add" || action == "album_remove" || !StartsWithFoldASCII(action, "album_")) {
        BuilderPrint(*out, ",\"ids\":[")
        for i: 0..picked_count - 1 { if i > 0 { BuilderPrint(*out, ",") }; Quoted(*out, TextUntilNul(picked[i].id[:])) }
        BuilderPrint(*out, "]")
    }
    BuilderPrint(*out, ",\"offset\":%}", offset)
    request := BuilderFinish(out)
    loading = Transport.Start(request)
    Release(request)
    if !loading { Set(message[:], Transport.error); if appending { more_due = ticks + 300; appending = false } }
    busy = loading && action != "query" && action != "playback_check"; next_refresh = ticks + 300
}
Decode :: (json: string, at: s32, key: string, out: []u8) {
    size := ReadStringText(json, FieldAt(json, at, key), out)
    if size < 0 || size >= cast(s32)out.count { out[0] = 0 }
    else { out[size] = 0 }
}
Number :: (json: string, at: s32, key: string) -> s32 {
    value := ReadNumber(json, FieldAt(json, at, key))
    return ifx value.valid then cast(s32)value.value else 0
}
PhotoString :: (json: string, at: s32, out: []u8) { if ReadStringText(json, at, out) < 0 { out[0] = 0 } }
ReadPhoto :: (json: string, start: s32, photo: *Photo) -> s32 {
    // Each gallery field is scanned once. Repeated object lookups multiplied
    // path parsing by every field and exhausted the portable frame budget.
    at := Space(json, start)
    if at < 0 || at >= cast(s32)json.count || json[at] != 123 { return -1 }
    at = Space(json, at + 1); fields: s32
    while at >= 0 && at < cast(s32)json.count && json[at] != 125 && fields < 20 {
        key := ReadString(json, at); if !key.valid { return -1 }
        name := json[key.start:key.end]; at = Space(json, key.after)
        if at < 0 || at >= cast(s32)json.count || json[at] != 58 { return -1 }; at = Space(json, at + 1)
        if name == "id" { PhotoString(json, at, photo.id[:]) }
        else if name == "name" { PhotoString(json, at, photo.name[:]) }
        else if name == "thumbnail" { PhotoString(json, at, photo.thumbnail[:]) }
        else if name == "display" { PhotoString(json, at, photo.display[:]) }
        else if name == "original" && photo.display[0] == 0 { PhotoString(json, at, photo.display[:]) }
        else if name == "date" { PhotoString(json, at, photo.date[:]) }
        else if name == "kind" { PhotoString(json, at, photo.kind[:]); photo.live = TextUntilNul(photo.kind[:]) == "live"; if photo.live { Set(photo.kind[:], "photo") } }
        else {
            value := ReadNumber(json, at); number := ifx value.valid then cast(s32)value.value else 0
            if name == "favorite" { photo.favorite = number > 0 }
            else if name == "hidden" { photo.hidden = number > 0 }
            else if name == "trashed" { photo.trashed = number > 0 }
            else if name == "archived" { photo.archived = number > 0 }
            else if name == "width" { photo.width = number }
            else if name == "height" { photo.height = number }
        }
        at = Space(json, ValueEnd(json, at, 0)); fields += 1
        if at >= 0 && at < cast(s32)json.count && json[at] == 44 { at = Space(json, at + 1) }
    }
    return ifx at >= 0 && at < cast(s32)json.count && json[at] == 125 then at + 1 else -1
}
Tick :: () {
    ticks += 1;
    if playback_id[0] != 0 {
        valid := editor == "playback" && selected >= 0 && selected < count
        if valid { valid = TextUntilNul(photos[selected].id[:]) == TextUntilNul(playback_id[:]) && !photos[selected].trashed && (!photos[selected].hidden || vault_unlocked) }
        if !valid { StopPlayback() }
        else if playback_started {
            state := Playback.State()
            if state <= 0 { error := Playback.Message(); Set(message[:], error); StopPlayback() }
        }
    }
    if !initialized { initialized = true; Request() }
    if Transport.Poll() {
        loading = false; busy = false
        if Transport.error != "" { Set(message[:], Transport.error); if playback_id[0] != 0 { StopPlayback() }; if appending { more_due = ticks + 300; appending = false }; return }
        json := Transport.Value()
        if FieldAt(json, 0, "vault_configured") >= 0 { vault_configured = Number(json, 0, "vault_configured") > 0; vault_unlocked = Number(json, 0, "vault_unlocked") > 0 }
        if FieldAt(json, 0, "vault_token") >= 0 { Decode(json, 0, "vault_token", vault_token[:]) }
        if view == "hidden" && !vault_unlocked {
            StopPlayback(); selected = -1; VecClear(photos); count = 0; ClearSelection(); appending = false; Wipe(edit_preview[:])
            if !Secret() { CancelEditor() }
        }
        if playback_request {
            playback_request = false
            Decode(json, 0, "error", message[:])
            fresh_id: [65]u8; path: [4097]u8
            Decode(json, 0, "playback_id", fresh_id[:]); Decode(json, 0, "playback_path", path[:])
            if editor != "playback" || playback_id[0] == 0 { return }
            if message[0] != 0 || TextUntilNul(fresh_id[:]) != TextUntilNul(playback_id[:]) || path[0] == 0 || (playback_started && TextUntilNul(path[:]) != TextUntilNul(playback_path[:])) {
                StopPlayback(); if message[0] == 0 { Set(message[:], "Video access ended") }; return
            }
            if !playback_started {
                if !Playback.Open(TextUntilNul(path[:])) { Set(message[:], Playback.Message()); StopPlayback(); return }
                playback_started = true; Set(playback_path[:], TextUntilNul(path[:])); playback_speed = 100; playback_volume = 100
            }
            Playback.Lease(2500); playback_poll = ticks + 30
            return
        }
        if FieldAt(json, 0, "video_job") >= 0 { Decode(json, 0, "video_job", video_job[:]); video_poll = ticks + 30 }
        if FieldAt(json, 0, "saved_copy") >= 0 {
            saved: [65]u8; Decode(json, 0, "saved_copy", saved[:])
            if saved[0] != 0 && (editor == "video" || editor == "video_trim") { editor = ""; edit_preview[0] = 0; edit_session[0] = 0 }
        }
        Decode(json, 0, "error", message[:]); if message[0] != 0 { if appending { more_due = ticks + 300; appending = false }; return }
        if view == "map" { Map.Load(json) }
        total = Number(json, 0, "total"); matches = Number(json, 0, "count"); pending = Number(json, 0, "pending")
        Decode(json, 0, "status", message[:])
        if FieldAt(json, 0, "edit_preview") >= 0 {
            Decode(json, 0, "edit_preview", edit_preview[:]); Decode(json, 0, "edit_session", edit_session[:])
            edit_width = Number(json, 0, "edit_width"); edit_height = Number(json, 0, "edit_height")
        }
        if FieldAt(json, 0, "video_duration") >= 0 {
            video_duration = Number(json, 0, "video_duration")
            if video_adjustments[1] == 0 { video_adjustments[1] = video_duration }
        }
        if FieldAt(json, 0, "memory_date") >= 0 { Decode(json, 0, "memory_date", memory_date[:]) }
        Decode(json, 0, "export_status", export_status[:]); export_continuous = Number(json, 0, "export_continuous") > 0
        if mutation { ClearSelection(); editor = "" }
        if Number(json, 0, "place_open") > 0 { selected = -1; detail_id[0] = 0 }
        if FieldAt(json, 0, "album") >= 0 { Decode(json, 0, "album", album[:]); offset = 0; scroll = 0 }
        if FieldAt(json, 0, "search") >= 0 { Decode(json, 0, "search", search[:]); search_cursor = 0; search_anchor = 0 }
        if FieldAt(json, 0, "view") >= 0 {
            fresh_view: [32]u8; Decode(json, 0, "view", fresh_view[:])
            for i: 0..cast(s32)11 { if View(i) == TextUntilNul(fresh_view[:]) { view = View(i) } }
        }
        album_detail := FieldAt(json, 0, "album_detail")
        album_description[0] = 0; album_filter[0] = 0; album_pinned = false; album_archived = false; album_place = false
        if album_detail >= 0 {
            Decode(json, album_detail, "description", album_description[:])
            Decode(json, album_detail, "filter", album_filter[:])
            album_pinned = Number(json, album_detail, "pinned") > 0
            album_archived = Number(json, album_detail, "archived") > 0
            album_place = Number(json, album_detail, "place") > 0
        }
        detail := FieldAt(json, 0, "detail")
        if detail >= 0 {
            Decode(json, detail, "id", detail_id[:]); Decode(json, detail, "caption", detail_caption[:])
            Decode(json, detail, "tags", detail_tags[:]); Decode(json, detail, "albums", detail_albums[:])
            Decode(json, detail, "taken", detail_taken[:]); Decode(json, detail, "location", detail_location[:])
            size := ReadNumber(json, FieldAt(json, detail, "size")); detail_size = ifx size.valid then cast(s64)size.value else 0
            detail_caption_editable = Number(json, detail, "caption_editable") > 0
            detail_tags_editable = Number(json, detail, "tags_editable") > 0
        }
        previous: [65]u8
        if selected >= 0 && selected < count { Set(previous[:], TextUntilNul(photos[selected].id[:])) }
        if !appending { selected = -1; last_pick = -1; VecClear(photos); count = 0; feed_base = offset }; revision += 1
        array := FieldAt(json, 0, "photos"); at := Space(json, array + 1); page_count: s32
        while at >= 0 && at < cast(s32)json.count && json[at] != 93 && page_count < 60 {
            empty: Photo; if !VecPush(photos, empty) { Set(message[:], "Unable to load more photos"); break }
            photo := *photos[count]
            at = ReadPhoto(json, at, photo)
            if at < 0 { unused VecPop(photos); Set(message[:], "Cannot read the gallery page"); break }
            if TextUntilNul(photo.id[:]) == TextUntilNul(previous[:]) && previous[0] != 0 { selected = count }
            count += 1; page_count += 1; at = Space(json, at); if at >= 0 && at < cast(s32)json.count && json[at] == 44 { at = Space(json, at + 1) }
        }
        appending = false
        array = FieldAt(json, 0, "albums"); at = Space(json, array + 1); album_count = 0; VecClear(catalog)
        while at >= 0 && at < cast(s32)json.count && json[at] != 93 {
            empty: Album; if !VecPush(catalog, empty) { break }; item := *catalog[album_count]
            Decode(json, at, "name", item.name[:]); Decode(json, at, "thumbnail", item.thumbnail[:]); item.count = Number(json, at, "count")
            item.pinned = Number(json, at, "pinned") > 0; item.archived = Number(json, at, "archived") > 0
            item.smart = Number(json, at, "smart") > 0
            item.place = Number(json, at, "place") > 0
            album_count += 1; at = Space(json, ValueEnd(json, at, 0)); if at >= 0 && at < cast(s32)json.count && json[at] == 44 { at = Space(json, at + 1) }
        }
        text: Vec(u8); BuilderPrint(*text, "% photos & videos · % albums · % queued", total, album_count, pending)
        value := BuilderFinish(text); Set(summary[:], value); Release(value)
    }
    if !loading && queued_view >= 0 { target := queued_view; queued_view = -1; Navigate(View(target)); return }
    if !loading && queued_request {
        queued_request = false; SendRequest(TextUntilNul(queued_action[:]), TextUntilNul(queued_id[:]), TextUntilNul(queued_value[:])); return
    }
    if !loading && playback_id[0] != 0 && ticks >= playback_poll { playback_poll = ticks + 30; Request("playback_check", TextUntilNul(playback_id[:])); return }
    if !loading && video_job[0] != 0 && ticks >= video_poll { video_poll = ticks + 60; Request("video_status"); return }
    if !loading && ticks > next_refresh && ((scroll == 0 && selected < 0) || (view == "hidden" && vault_unlocked)) { if selected < 0 { offset = 0 }; Request() }
}
Navigate :: (target: string) {
    Viewer.Reset()
    StopPlayback()
    queued_request = false
    if loading { for i: 0..cast(s32)11 { if View(i) == target { queued_view = i } }; return }
    if view == "hidden" && target != "hidden" && vault_token[0] != 0 {
        for i: 0..cast(s32)11 { if View(i) == target { queued_view = i } }
        vault_unlocked = false; selected = -1; ClearSelection(); editor = ""; Wipe(edit_value[:]); Wipe(vault_first[:]); Wipe(edit_preview[:])
        Request("vault_lock"); Wipe(vault_token[:]); return
    }
    Wipe(vault_first[:]); if Secret() { Wipe(edit_value[:]) }
    if target == "map" { Map.Reset() }
    ClearSelection(); editor = ""; view = target; appending = false; feed_base = 0; album[0] = 0; selected = -1; offset = 0; scroll = 0; Request()
}
Choose :: (index: s32) {
    if busy || index < 0 || index >= count { return }
    StopPlayback()
    was_expanded := Viewer.expanded
    Viewer.Reset(); Viewer.expanded = was_expanded && TextUntilNul(photos[index].kind[:]) == "photo"
    selected = index
    detail_id[0] = 0
    detail_caption[0] = 0; detail_tags[0] = 0; detail_albums[0] = 0; detail_taken[0] = 0; detail_location[0] = 0; detail_size = 0
    Request("open", TextUntilNul(photos[index].id[:]))
}
ClearSelection :: () { VecClear(picked); picked_count = 0; last_pick = -1; selecting = false }
StopPlayback :: () {
    if playback_started { Playback.Stop() }
    playback_started = false; Wipe(playback_id[:]); Wipe(playback_path[:]); playback_expanded = false
    if editor == "playback" { editor = "" }
}
BeginPlayback :: () {
    if loading || selected < 0 || selected >= count { return }
    photo := *photos[selected]
    if (TextUntilNul(photo.kind[:]) != "video" && !photo.live) || photo.trashed || TextUntilNul(detail_id[:]) != TextUntilNul(photo.id[:]) { return }
    StopPlayback(); Set(playback_id[:], TextUntilNul(photo.id[:]))
    editor = "playback"; focused = false; search_focused = false
    Request("playback_check", TextUntilNul(playback_id[:]))
}
PlaybackSeek :: (position: s64) {
    duration := Playback.Duration()
    if duration <= 0 { return }
    if position < 0 { position = 0 }; if position >= duration { position = duration - 1 }
    unused Playback.Seek(position)
}
PlaybackSpeed :: () {
    target: s32 = ifx playback_speed == 25 then 50 else (ifx playback_speed == 50 then 100 else (ifx playback_speed == 100 then 150 else (ifx playback_speed == 150 then 200 else 25)))
    if Playback.Speed(target) { playback_speed = target }
}
IsPicked :: (id: string) -> bool {
    for i: 0..picked_count - 1 { if TextUntilNul(picked[i].id[:]) == id { return true } }; return false
}
Pick :: (index: s32, range: bool = false) {
    if index < 0 || index >= count || busy { return }
    selecting = true
    first := ifx range && last_pick >= 0 then last_pick else index
    end := index
    if first > end { swap := first; first = end; end = swap }
    for at: first..end {
        id := TextUntilNul(photos[at].id[:]); found: s32 = -1
        for i: 0..picked_count - 1 { if TextUntilNul(picked[i].id[:]) == id { found = i; break } }
        if found >= 0 && !range {
            for i: found..picked_count - 2 { picked[i] = picked[i + 1] }
            picked_count -= 1; unused VecPop(picked)
        } else if found < 0 && picked_count < 1000 {
            item: Selection; Set(item.id[:], id); if VecPush(picked, item) { picked_count += 1 }
        }
    }
    last_pick = index
}
SelectLoaded :: () {
    for i: 0..count - 1 { if picked_count >= 1000 { break }; if !IsPicked(TextUntilNul(photos[i].id[:])) { Pick(i, true) } }
}
BeginEdit :: (action: string, title: string, value: string, hint: string) {
    StopPlayback()
    editor = action; editor_title = title; editor_hint = hint; Set(edit_value[:], value)
    cursor = cast(s32)value.count; anchor = cursor; focused = false; search_focused = false
}
Apply :: (action: string, value: string = "") {
    if loading { return }
    id := ifx selected >= 0 && selected < count then TextUntilNul(photos[selected].id[:]) else ""
    Request(action, id, value)
}
SaveEditor :: () {
    if loading { return }
    if editor == "place_name" {
        if edit_value[0] == 0 || TextUntilNul(edit_value[:]).count > 512 { Set(message[:], "Choose a place name of at most 512 bytes"); return }
        Set(place_name[:], TextUntilNul(edit_value[:]))
        BeginEdit("place_create", "Choose the place area", TextUntilNul(place_area[:]), "Latitude, longitude, radius in kilometres (0.001 to 20040)"); return
    }
    if editor == "place_create" {
        out: Vec(u8); BuilderPrint(*out, "["); Quoted(*out, TextUntilNul(place_name[:]))
        BuilderPrint(*out, ","); Quoted(*out, TextUntilNul(edit_value[:])); BuilderPrint(*out, "]")
        value := BuilderFinish(out); Apply("place_create", value); Release(value); return
    }
    if editor == "video_trim" {
        text := TextUntilNul(edit_value[:]); comma: s32 = -1
        for i: 0..cast(s32)text.count - 1 { if text[i] == 44 { if comma >= 0 { Set(message[:], "Use start, end in seconds"); return }; comma = i } }
        if comma < 0 { Set(message[:], "Use start, end in seconds"); return }
        start := VideoMilliseconds(text[:comma]); end := VideoMilliseconds(text[comma+1:])
        if start < 0 || end - start < 1000 || end > video_duration { Set(message[:], "Choose at least one second within the video"); return }
        video_adjustments[0] = start; video_adjustments[1] = end; editor = "video"; focused = false; VideoRequest(); return
    }
    if editor == "vault_setup" || editor == "vault_change" {
        chars: s32; i: s32
        while i < 1024 && edit_value[i] != 0 { if (edit_value[i] & 192) != 128 { chars += 1 }; i += 1 }
        if chars < 8 { Set(message[:], "Use at least 8 characters for your Hidden password"); return }
        for index: 0..1024 { vault_first[index] = edit_value[index] }
        changing := editor == "vault_change"
        Wipe(edit_value[:]); BeginEdit(ifx changing then "vault_change_confirm" else "vault_confirm", "Confirm Hidden password", "", "Type the same password again"); return
    }
    if editor == "vault_confirm" || editor == "vault_change_confirm" || editor == "vault_unlock" {
        if editor != "vault_unlock" && TextUntilNul(edit_value[:]) != TextUntilNul(vault_first[:]) { Set(message[:], "Passwords do not match"); return }
        Request(ifx editor == "vault_confirm" then "vault_setup" else (ifx editor == "vault_change_confirm" then "vault_change" else "vault_unlock"), "", TextUntilNul(edit_value[:]))
        Wipe(vault_first[:]); Wipe(edit_value[:]); cursor = 0; anchor = 0; return
    }
    Apply(editor, TextUntilNul(edit_value[:]))
}
Wipe :: (bytes: []u8) { for i: 0..cast(s32)bytes.count - 1 { bytes[i] = 0 } }
PlaybackState :: () -> s32 { return Playback.State() }
PlaybackPosition :: () -> s64 { return Playback.Position() }
PlaybackDuration :: () -> s64 { return Playback.Duration() }
Secret :: () -> bool { return StartsWithFoldASCII(editor, "vault_") }
CancelEditor :: () { editor = ""; focused = false; Wipe(edit_value[:]); Wipe(vault_first[:]) }
ImageValue :: () -> string {
    out: Vec(u8); BuilderPrint(*out, "[")
    for i: 0..6 { if i > 0 { BuilderPrint(*out, ",") }; BuilderPrint(*out, "%", image_adjustments[i]) }
    if image_adjustments[6] == 4 { for i: 0..3 { BuilderPrint(*out, ",%", image_crop[i]) } }
    BuilderPrint(*out, "]"); return BuilderFinish(out)
}
ImageRequest :: (action: string = "image_preview") {
    if loading { return }
    value := ImageValue(); Apply(action, value); Release(value)
}
BeginImageEdit :: () {
    if loading || selected < 0 || selected >= count { return }
    editor = "image"; focused = false; search_focused = false; edit_preview[0] = 0; edit_session[0] = 0
    image_adjustments = .{0, 0, 0, 100, 100, 100, 0}; image_crop = .{0, 0, 10000, 10000}; ImageRequest()
}
ImageChange :: (index: s32, delta: s32) {
    if loading { return }
    if image_adjustments[6] == 4 {
        if index == 0 { image_crop = Crop.CropRotate(image_crop) }
        if index == 1 { image_crop[0] = 10000 - image_crop[0] - image_crop[2] }
        if index == 2 { image_crop[1] = 10000 - image_crop[1] - image_crop[3] }
    }
    if index == 0 {
        turn: s32 = ifx image_adjustments[1] != image_adjustments[2] then 270 else 90
        image_adjustments[index] = (image_adjustments[index] + turn) % 360
    }
    else if index == 1 || index == 2 { image_adjustments[index] = 1 - image_adjustments[index] }
    else if index == 6 { image_adjustments[index] = ifx image_adjustments[index] == 4 then 0 else (image_adjustments[index] + 1) % 4 }
    else { image_adjustments[index] += delta; if image_adjustments[index] < 0 { image_adjustments[index] = 0 }; if image_adjustments[index] > 200 { image_adjustments[index] = 200 } }
    ImageRequest()
}
ImageReset :: () { if loading { return }; image_adjustments = .{0, 0, 0, 100, 100, 100, 0}; image_crop = .{0, 0, 10000, 10000}; ImageRequest() }
ImageChanged :: () -> bool { return image_adjustments[0] != 0 || image_adjustments[1] != 0 || image_adjustments[2] != 0 || image_adjustments[3] != 100 || image_adjustments[4] != 100 || image_adjustments[5] != 100 || image_adjustments[6] != 0 }
VideoMilliseconds :: (text: string) -> s32 {
    whole: s64; fraction: s32; digits: s32; decimal: bool; started: bool; ended: bool; seen: bool
    for byte: text {
        if byte == 32 { if started { ended = true }; continue }
        if ended { return -1 }; started = true
        if byte == 46 { if decimal { return -1 }; decimal = true; continue }
        if byte < 48 || byte > 57 { return -1 }; seen = true
        if !decimal { whole = whole * 10 + cast(s64)byte - 48; if whole > 604800 { return -1 } }
        else { if digits >= 3 { return -1 }; fraction = fraction * 10 + cast(s32)byte - 48; digits += 1 }
    }
    if !seen { return -1 }; while digits < 3 { fraction *= 10; digits += 1 }
    result := whole * 1000 + fraction; return ifx result <= 604800000 then cast(s32)result else -1
}
VideoValue :: () -> string {
    out: Vec(u8); BuilderPrint(*out, "[%,%,%,%", video_adjustments[0], video_adjustments[1], video_adjustments[2], video_adjustments[3])
    if video_adjustments[3] == 6 { for i: 0..3 { BuilderPrint(*out, ",%", video_crop[i]) } }
    BuilderPrint(*out, "]"); return BuilderFinish(out)
}
VideoRequest :: (action: string = "video_preview") {
    if loading { return }; value := VideoValue(); Apply(action, value); Release(value)
}
BeginVideoEdit :: () {
    if loading || video_job[0] != 0 || selected < 0 || selected >= count { return }
    editor = "video"; focused = false; search_focused = false; edit_preview[0] = 0; edit_session[0] = 0
    video_duration = 0; video_adjustments = .{0,0,0,0}; video_crop = .{0, 0, 10000, 10000}; Apply("video_begin")
}
VideoChange :: (index: s32) {
    if loading { return }
    if index == 2 {
        if video_adjustments[3] == 6 { video_crop = Crop.CropRotate(video_crop) }
        video_adjustments[2] = (video_adjustments[2] + 90) % 360
    }
    if index == 3 { video_adjustments[3] = ifx video_adjustments[3] == 6 then 0 else (video_adjustments[3] + 1) % 6 }
    VideoRequest()
}
VideoTrim :: () {
    out: Vec(u8)
    for i: 0..1 {
        if i > 0 { BuilderPrint(*out, ", ") }
        remainder := video_adjustments[i] % 1000
        BuilderPrint(*out, "%.", video_adjustments[i] / 1000)
        if remainder < 100 { BuilderPrint(*out, "0") }; if remainder < 10 { BuilderPrint(*out, "0") }
        BuilderPrint(*out, "%", remainder)
    }
    value := BuilderFinish(out); BeginEdit("video_trim", "Trim video", value, "Start, end in seconds (up to three decimals); minimum length is one second"); Release(value)
}
VideoChanged :: () -> bool { return video_adjustments[0] != 0 || video_adjustments[1] != video_duration || video_adjustments[2] != 0 || video_adjustments[3] != 0 }
BeginCrop :: (video: bool) {
    if loading { return }
    crop_dragging = false; focused = false; search_focused = false
    if video {
        crop_previous = video_adjustments[3]; crop_candidate = video_crop; video_adjustments[3] = 0
        editor = "video_crop"; VideoRequest()
    } else {
        crop_previous = image_adjustments[6]; crop_candidate = image_crop; image_adjustments[6] = 0
        editor = "image_crop"; ImageRequest()
    }
}
FinishCrop :: (apply: bool) {
    if loading || (apply && !Crop.CropValid(crop_candidate[:])) { return }
    crop_dragging = false
    if editor == "video_crop" {
        video_adjustments[3] = ifx apply then 6 else crop_previous
        if apply { video_crop = crop_candidate }; editor = "video"; VideoRequest()
    } else {
        image_adjustments[6] = ifx apply then 4 else crop_previous
        if apply { image_crop = crop_candidate }; editor = "image"; ImageRequest()
    }
}
Find :: () { ClearSelection(); CancelEditor(); offset = 0; scroll = 0; selected = -1; Request() }
ToggleSort :: () { if loading { return }; sort = ifx sort == "newest" then "oldest" else "newest"; Find() }
AlbumFilter :: () { album_mode = ifx album_mode == "active" then "archived" else (ifx album_mode == "archived" then "empty" else "active"); Find() }
AlbumSort :: () { album_sort = ifx album_sort == "name" then "newest" else (ifx album_sort == "newest" then "oldest" else "name"); Find() }
Edit :: (out: []u8, start: s32, end: s32, replacement: string) {
    copied: [8193]u8; Set(copied[:], replacement)
    length := cast(s32)TextUntilNul(out).count; inserted := cast(s32)replacement.count
    if start < 0 || end < start || end > length || length - (end - start) + inserted >= cast(s32)out.count { return }
    shift := inserted - (end - start)
    if shift > 0 { i := length; while i >= end { out[i + shift] = out[i]; i -= 1 } }
    else { for i: end..length { out[i + shift] = out[i] } }
    for i: 0..inserted - 1 { out[start + i] = copied[i] }
}

// Append another page near the end of the date feed without changing its scroll.
More :: () {
    if loading || ticks < more_due || count + feed_base >= matches || CatalogView() || view == "sync" { return }
    offset = count + feed_base; appending = true; Request()
}

RefreshMap :: () { if loading { return }; ClearSelection(); selected = -1; offset = 0; scroll = 0; Request() }
OpenMap :: () { if loading { return }; CancelEditor(); Map.Reset(); view = "map"; RefreshMap() }
MapGallery :: (index: s32 = -1) {
    if loading { return }
    Map.OpenGallery(index); RefreshMap()
}
MapBack :: () { if loading { return }; Map.gallery = false; Map.dragged = false; RefreshMap() }
CatalogView :: () -> bool { return view == "albums" || view == "places" }
AlbumPlace :: () -> bool { return album_place }
BeginPlace :: (from_photo: bool = false) {
    place_name[0] = 0
    if from_photo { out: Vec(u8); BuilderPrint(*out, "%, 1", TextUntilNul(detail_location[:])); value := BuilderFinish(out); Set(place_area[:], value); Release(value) }
    else { Set(place_area[:], "0, 0, 1") }
    BeginEdit("place_name", "Name this place", "", "A name such as Home; photos in its radius match automatically")
}
View :: (index: s32) -> string { names: [12]string = .{"photos", "albums", "favorites", "videos", "hidden", "trash", "sync", "archive", "uncategorized", "memories", "map", "places"}; return names[index] }
